-- // DIGIT KEY MAP // --

local NUMBER_KEY_TO_ENUM = {
    [1] = Enum.KeyCode.One,
    [2] = Enum.KeyCode.Two,
    [3] = Enum.KeyCode.Three,
    [4] = Enum.KeyCode.Four,
}

local function ResolveKeyCode(key)
    if key == nil then return nil end
    if type(key) == "number" then
        local mapped = NUMBER_KEY_TO_ENUM[key]
        if mapped then return mapped end
        return nil
    end
    return key
end

-- // TIMER POOL (Lua 5.1) // --

local Timers = {}
local TimerId = 0
local TimerGeneration = 0

local function Schedule(delayTime, callback)
    TimerId = TimerId + 1
    local id = TimerId
    Timers[id] = {
        triggerTime = time() + delayTime,
        callback = callback,
        active = true,
        gen = TimerGeneration,
    }
    return id
end

local function CancelAllTimers()
    TimerGeneration = TimerGeneration + 1
    for id, timer in pairs(Timers) do
        timer.active = false
    end
    Timers = {}
end

