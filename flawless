local function ExecuteBlockBreak(target)
    if time() - State.BreakerCooldown < SETTINGS.BreakerAttemptCD then
        return false
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return false
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = target and target:FindFirstChild("HumanoidRootPart")

    if not myRoot or not tRoot then
        return false
    end

    local ok, actionId = BeginAction(
        "BlockBreak",
        0.72,
        ActionPriority.BLOCK_BREAK,
        true
    )

    if not ok then
        return false
    end

    State.BreakerCooldown = time()
    Log("Block break attempt")

    local side = (math.random() > 0.5) and 1 or -1

    local offset = tRoot.CFrame.RightVector * (side * (10 + math.random() * 3))
        - tRoot.CFrame.LookVector * (5 + math.random() * 2)

    local dashTargetPos = tRoot.Position + offset

    myRoot.CFrame = CFrame.lookAt(myRoot.Position, dashTargetPos)

    local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q

    if time() - State.LastDash > SETTINGS.DashCD then
        PressKey(dashKey, 0.05)
        State.LastDash = time()
    end

    Schedule(0.18 + math.random() * 0.04, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "BlockBreak" then
            return
        end

        if not IsAlive(myChar) or not IsAlive(target) then
            EndAction("BlockBreak")
            return
        end

        local rootNow = myChar:FindFirstChild("HumanoidRootPart")
        local targetRootNow = target:FindFirstChild("HumanoidRootPart")

        if not rootNow or not targetRootNow then
            EndAction("BlockBreak")
            return
        end

        if (rootNow.Position - targetRootNow.Position).Magnitude > 20 then
            EndAction("BlockBreak")
            return
        end

        AimAt(targetRootNow.Position)

        local key = GetReadySkill(true)

        if key then
            PressKey(key, 0.1)
            RegisterSkill(key)
        else
            ClickM1()

            Schedule(0.12, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "BlockBreak" then
                    if IsAlive(myChar) then
                        ClickM1()
                    end
                end
            end)
        end

        Schedule(0.32, function()
            if ActiveAction.Id == actionId and ActiveAction.Name == "BlockBreak" then
                EndAction("BlockBreak")
            end
        end)
    end)

    return true
end

-- // FLANK FOLLOW-UP // --
local function ExecuteFlankSkill(target)
    local preferBreaker = EnemyCache.blocking and math.random() < 0.65

    local key = GetReadySkill(preferBreaker)
    if not key then
        key = GetReadySkill(false)
    end

    if not key then
        return ExecuteCancelCombo(target)
    end

    local ok, actionId = BeginAction(
        "FlankSkill",
        0.32,
        ActionPriority.OFFENSE,
        false
    )

    if not ok then
        return false
    end

    PressKey(key, 0.08)
    RegisterSkill(key)

    Schedule(0.3, function()
        if ActiveAction.Id == actionId and ActiveAction.Name == "FlankSkill" then
            EndAction("FlankSkill")
        end
    end)

    return true
end

local function ExecuteFlankFollowup(target)
    if not IsAlive(LocalPlayer.Character) or not IsAlive(target) then
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = target:FindFirstChild("HumanoidRootPart")

    if not myRoot or not tRoot then
        return
    end

    local dist = (myRoot.Position - tRoot.Position).Magnitude

    AimAt(PredictTargetPosition(tRoot, dist))

    if dist > SETTINGS.AttackRange + 6 then
        return
    end

    if IsIncapacitated(target) and dist < 10 then
        Log("Flank followup: punish")
        ExecutePunish(target)
        return
    end

    local cfg = SETTINGS.FlankDash
    local behind = true

    if cfg.CheckBehind then
        behind = IsBehindTarget(myRoot, tRoot)
    end

    -- Если не оказались за спиной и враг атакует, пробуем парри
    if not behind and EnemyCache.attacking and SETTINGS.AutoParry then
        if TryParry(target, dist, myRoot, tRoot) then
            Log("Flank followup: emergency parry")
            return
        end
    end

    if EnemyCache.blocking and dist < 12 and SETTINGS.BlockBreaker then
        if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak
            and time() - State.BreakerCooldown > SETTINGS.BreakerAttemptCD
        then
            Log("Flank followup: block break")
            ExecuteBlockBreak(target)
            return
        end
    end

    local roll = math.random()

    if behind then
        if roll < 0.45 then
            Log("Flank followup: cancel combo")
            ExecuteCancelCombo(target)
        elseif roll < 0.85 then
            Log("Flank followup: flank skill")
            ExecuteFlankSkill(target)
        else
            Log("Flank followup: cancel combo backup")
            ExecuteCancelCombo(target)
        end
    else
        if roll < 0.65 then
            Log("Flank followup: cancel combo")
            ExecuteCancelCombo(target)
        elseif roll < 0.85 then
            Log("Flank followup: flank skill")
            ExecuteFlankSkill(target)
        else
            Log("Flank followup: quick M1")
            ExecuteQuickM1()
        end
    end
end

local function TryFlankDash(target, dist, myRoot, tRoot)
    local cfg = SETTINGS.FlankDash

    if not cfg or not cfg.Enabled then
        return false
    end

    if ActiveAction.Name == "Flank" then
        return true
    end

    if ActiveAction.Name ~= nil then
        return false
    end

    if time() - State.LastFlank < cfg.Cooldown then
        return false
    end

    if cfg.UseDashCooldown and time() - State.LastDash < SETTINGS.DashCD then
        return false
    end

    if dist < cfg.MinDist or dist > cfg.MaxDist then
        return false
    end

    if EnemyCache.awakened then
        return false
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return false
    end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum then
        return false
    end

    -- Если уже за спиной, не флангуем
    local dirToMe = myRoot.Position - tRoot.Position

    if dirToMe.Magnitude > 0.001 then
        dirToMe = dirToMe.Unit

        local facingDot = tRoot.CFrame.LookVector:Dot(dirToMe)

        if facingDot < 0.05 then
            return false
        end
    end

    local side = cfg.Side

    if cfg.RandomSide then
        side = math.random() < 0.5 and -1 or 1

        if side == State.LastFlankSide then
            side = -side
        end
    end

    local dest = tRoot.Position
        + tRoot.CFrame.RightVector * (cfg.SideOffset * side)
        - tRoot.CFrame.LookVector * cfg.BackOffset

    local moveDir = dest - myRoot.Position
    moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)

    if moveDir.Magnitude < 1 then
        return false
    end

    moveDir = moveDir.Unit

    if cfg.CheckWall and not IsFlankPathSafe(myChar, target, myRoot, dest) then
        return false
    end

    local followDelay = (cfg.FollowupDelay or 0.5)
        + math.random() * (cfg.FollowupRandom or 0)

    local totalDuration = followDelay + 0.3

    local ok, actionId = BeginAction(
        "Flank",
        totalDuration,
        ActionPriority.FLANK,
        true
    )

    if not ok then
        return false
    end

    State.LastFlank = time()
    State.LastFlankSide = side
    State.FlankSide = side

    Log("Flank dash side: " .. tostring(side))

    -- Останавливаем текущий MoveTo
    hum:MoveTo(myRoot.Position)

    local cameraHold = math.max(
        cfg.CameraHold or 0.62,
        followDelay + 0.12
    )

    ForceCameraMoveDirection(moveDir, cameraHold)

    if cfg.RotateCharacter then
        myRoot.CFrame = CFrame.lookAt(
            myRoot.Position,
            myRoot.Position + moveDir
        )
    end

    -- Зажимаем D
    VirtualInputManager:SendKeyEvent(true, cfg.Key, false, game)

    -- Страховочное освобождение D
    Schedule(0.18, function()
        if IsAlive(myChar) then
            VirtualInputManager:SendKeyEvent(false, cfg.Key, false, game)
        end
    end)

    Schedule(0.02 + math.random() * 0.03, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then
            return
        end

        if not IsAlive(myChar) then
            EndAction("Flank")
            return
        end

        PressKey(cfg.QKey, 0.06)
        State.LastDash = time()

        if cfg.FollowupEnabled then
            Schedule(followDelay, function()
                if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then
                    return
                end

                if not IsAlive(myChar) or not IsAlive(target) then
                    EndAction("Flank")
                    return
                end

                EndAction("Flank")
                ExecuteFlankFollowup(target)
            end)
        else
            Schedule(0.25, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "Flank" then
                    EndAction("Flank")
                end
            end)
        end
    end)

    return true
end

-- // MOVEMENT // --
local function HandleMovementAndDef(target, dist, myRoot, tRoot)
    if State.MovementLock then
        return
    end

    if ActiveAction.Name == "GapCloseDash" then
        return
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return
    end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum then
        return
    end

    local dest = tRoot.Position

    if SETTINGS.OrbitMode and dist < 20 and dist > 5 then
        local angle = time() * (1.8 + math.random() * 0.4)
        local jitter = (math.random() - 0.5) * 2

        local ox = math.cos(angle) * (SETTINGS.OrbitRadius + jitter)
        local oz = math.sin(angle) * (SETTINGS.OrbitRadius + jitter)

        dest = tRoot.Position + Vector3.new(ox, 0, oz)
    end

    if SETTINGS.DashGapClose and dist > 35 and dist < 100 and time() - State.LastDash > SETTINGS.DashCD then
        local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q

        local ok, actionId = BeginAction(
            "GapCloseDash",
            0.2,
            ActionPriority.MOVEMENT,
            false
        )

        if ok then
            PressKey(dashKey, 0.05)
            State.LastDash = time()
            return
        end
    end

    if (myRoot.Position - State.LastPos).Magnitude < 0.15 then
        State.StuckCount = State.StuckCount + 1

        if State.StuckCount > 35 then
            hum.Jump = true
            State.StuckCount = 0
        end
    else
        State.StuckCount = 0
    end

    State.LastPos = myRoot.Position

    if not State.MoveDest
        or (dest - State.MoveDest).Magnitude > 3
        or time() - State.LastDestUpdate > 0.35
    then
        State.MoveDest = dest
        State.LastDestUpdate = time()
        hum:MoveTo(dest)
    end
end

-- // COMBAT // --
local function HandleCombat(target, dist)
    if State.ActionBusy then
        return
    end

    if EnemyCache.awakened and dist < SETTINGS.AwakenKiteRange then
        return
    end

    local now = time()
    local isBlocking = EnemyCache.blocking
    local isStunned = IsIncapacitated(target)

    if isBlocking and dist < 20 then
        if SETTINGS.BlockBreaker then
            if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak then
                if ExecuteBlockBreak(target) then
                    State.HitsOnBlock = 0
                end
            else
                if now - State.LastM1 > SETTINGS.M1Cooldown then
                    if ExecuteQuickM1() then
                        State.HitsOnBlock = State.HitsOnBlock + 1
                    end
                end
            end
        end

        return
    else
        State.HitsOnBlock = 0
    end

    if isStunned and dist < 9 then
        ExecutePunish(target)
        return
    end

    if dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > SETTINGS.M1Cooldown + math.random() * 0.08 then
            local roll = math.random()

            if roll < 0.25 then
                if not ExecuteCancelCombo(target) then
                    ExecuteQuickM1()
                end
            elseif roll < 0.45 then
                if not ExecuteRandomSkill(target) then
                    ExecuteQuickM1()
                end
            else
                ExecuteQuickM1()
            end

            return
        end
    end
end

-- // DEATH CLEANUP // --
local DeathConnection = nil

local function OnCharacterDeath()
    CancelAllTimers()
    ForceEndAllActions()
    UnbindFlankCamera()

    State.Target = nil
    State.HitsOnBlock = 0
    State.IsBlocking = false
    State.StuckCount = 0

    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.D, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- // MAIN LOOP // --
RunService.Heartbeat:Connect(function()
    if not SETTINGS.Enabled then
        return
    end

    UpdateAction()

    local myChar = LocalPlayer.Character

    if not IsAlive(myChar) then
        State.Target = nil
        return
    end

    if State.ConnectedChar ~= myChar then
        State.ConnectedChar = myChar

        if DeathConnection then
            pcall(function()
                DeathConnection:Disconnect()
            end)
        end

        local hum = myChar:FindFirstChild("Humanoid")
        if hum then
            DeathConnection = hum.Died:Connect(OnCharacterDeath)
        end
    end

    if IsIncapacitated(myChar) then
        BeginAction("Survival", 0.25, ActionPriority.SURVIVAL, false)

        PressKey(Enum.KeyCode.Space, 0.08)

        if math.random() > 0.75 then
            local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q
            PressKey(dashKey, 0.05)
        end

        return
    end

    local target = State.Target

    if not IsAlive(target) then
        target = FindTarget()
        State.Target = target
        State.HitsOnBlock = 0
    end

    if not target then
        ForceEndAllActions()
        return
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = target:FindFirstChild("HumanoidRootPart")

    if not myRoot or not tRoot then
        ForceEndAllActions()
        return
    end

    UpdateEnemyCache(target)

    local dist = (myRoot.Position - tRoot.Position).Magnitude

    AimAt(PredictTargetPosition(tRoot, dist))

    -- Приоритетные поведения
    if TryAwakenKite(target, dist, myRoot, tRoot) then
        return
    end

    if TryParry(target, dist, myRoot, tRoot) then
        return
    end

    if TryFlankDash(target, dist, myRoot, tRoot) then
        return
    end

    -- Обычное поведение
    HandleMovementAndDef(target, dist, myRoot, tRoot)

    if dist < SETTINGS.AggroRange then
        HandleCombat(target, dist)
    end
end)

