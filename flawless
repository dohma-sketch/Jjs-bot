local function IsAlive(char)
    if not char or not char.Parent then
        return false
    end

    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    return hum and root and hum.Health > 0
end

local function PressKey(key, hold)
    if not IsAlive(LocalPlayer.Character) then
        return
    end

    hold = hold or (0.05 + math.random() * 0.03)

    VirtualInputManager:SendKeyEvent(true, key, false, game)

    Schedule(hold + 0.03, function()
        if IsAlive(LocalPlayer.Character) then
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end
    end)
end

local function ClickM1()
    if not IsAlive(LocalPlayer.Character) then
        return
    end

    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)

    Schedule(0.05 + math.random() * 0.02, function()
        if IsAlive(LocalPlayer.Character) then
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
    end)
end

local function IsSkillReady(key)
    local info = SETTINGS.Skills[key]
    if not info then
        return false
    end

    if time() - State.LastSkillUse < SETTINGS.SkillGlobalCD then
        return false
    end

    return (time() - State.SkillTimers[key]) > (info.CD + math.random() * 0.5)
end

local function RegisterSkill(key)
    State.SkillTimers[key] = time()
    State.LastSkillUse = time()
end

local function IsIncapacitated(char)
    if not IsAlive(char) then
        return false
    end

    if char:GetAttribute("Ragdoll") or char:GetAttribute("Stunned") then
        return true
    end

    local hum = char:FindFirstChild("Humanoid")
    if not hum then
        return false
    end

    local state = hum:GetState()

    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding
end

-- // ENEMY ANALYSIS CACHE // --
local EnemyCache = {
    lastAnimScan = 0,
    blocking = false,
    attacking = false,

    lastAwakenScan = 0,
    awakened = false,
}

local function IsEnemyAwakened(char)
    if char:GetAttribute("Awakened") == true then
        return true
    end

    if char:GetAttribute("Awake") == true then
        return true
    end

    if char:GetAttribute("Domain") == true then
        return true
    end

    if char:GetAttribute("Transformation") == true then
        return true
    end

    local vfx = char:FindFirstChild("VFX")
        or char:FindFirstChild("Effects")
        or char:FindFirstChild("Particles")

    if vfx then
        for _, d in pairs(vfx:GetDescendants()) do
            local n = d.Name:lower()
            if n:find("awaken") or n:find("domain") or n:find("aura") then
                return true
            end
        end
    end

    return false
end

local function UpdateEnemyCache(target)
    if not target then
        return
    end

    local now = time()

    if now - EnemyCache.lastAwakenScan > 0.5 then
        EnemyCache.lastAwakenScan = now
        EnemyCache.awakened = IsEnemyAwakened(target)
    end

    if now - EnemyCache.lastAnimScan < 0.1 then
        return
    end

    EnemyCache.lastAnimScan = now
    EnemyCache.blocking = false
    EnemyCache.attacking = false

    if target:GetAttribute("Blocking") == true then
        EnemyCache.blocking = true
    end

    local hum = target:FindFirstChild("Humanoid")
    if not hum then
        return
    end

    local animator = hum:FindFirstChild("Animator")
    if not animator then
        return
    end

    local success, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)

    if not success then
        return
    end

    for _, t in pairs(tracks) do
        if t.IsPlaying and t.Animation and t.Animation.Name then
            local n = t.Animation.Name:lower()

            if t.Priority == Enum.AnimationPriority.Action then
                if n:find("block") or n:find("guard") or n:find("defend") then
                    EnemyCache.blocking = true
                elseif not n:find("dash")
                    and not n:find("run")
                    and not n:find("jump")
                    and not n:find("fall")
                then
                    EnemyCache.attacking = true
                end
            end
        end
    end
end

local function PredictTargetPosition(tRoot, distance)
    local vel = tRoot.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    local reaction = 0.12 + (distance / 180)

    return tRoot.Position + vel * reaction
end

local function AimAt(pos)
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        return
    end

    local lookPos = Vector3.new(pos.X, myRoot.Position.Y, pos.Z)
    local dir = lookPos - myRoot.Position

    if dir.Magnitude > 0.001 then
        local safeCFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + dir.Unit)
        myRoot.CFrame = safeCFrame
    end
end

-- // TARGETING // --
local function FindTarget()
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return nil
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        return nil
    end

    local myPos = myRoot.Position
    local bestTarget = nil
    local bestScore = -math.huge

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and IsAlive(p.Character) then
            local tRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChild("Humanoid")

            if tRoot and hum then
                local delta = tRoot.Position - myPos
                local dist = delta.Magnitude

                if dist > 0.5 and dist <= SETTINGS.AggroRange then
                    local rayDir = delta.Unit * math.min(SETTINGS.AggroRange, dist)
                    local result = Workspace:Raycast(myPos, rayDir, params)
                    local canSee = result and result.Instance:IsDescendantOf(p.Character)

                    if canSee or not result then
                        local healthRatio = hum.Health / hum.MaxHealth

                        local threat = 1000
                        threat = threat - (dist * 1.8)
                        threat = threat - (healthRatio * 250)

                        if threat > bestScore then
                            bestScore = threat
                            bestTarget = p.Character
                        end
                    end
                end
            end
        end
    end

    return bestTarget
end

local function GetReadySkill(preferBreaker)
    for key, info in pairs(SETTINGS.Skills) do
        if info.Breaker == (preferBreaker == true) and IsSkillReady(key) then
            return key
        end
    end

    if preferBreaker then
        for key, info in pairs(SETTINGS.Skills) do
            if not info.Breaker and IsSkillReady(key) then
                return key
            end
        end
    end

    return nil
end

-- // DEFENSE // --
local function TryParry(target, dist, myRoot, tRoot)
    if not SETTINGS.AutoParry then
        return false
    end

    if ActiveAction.Name == "Parry" then
        return true
    end

    if not EnemyCache.attacking then
        return false
    end

    if time() - State.LastParry < SETTINGS.ParryCD then
        return false
    end

    if dist > 14 then
        return false
    end

    local dirToMe = myRoot.Position - tRoot.Position
    if dirToMe.Magnitude < 0.001 then
        return false
    end

    dirToMe = dirToMe.Unit

    local enemyFace = tRoot.CFrame.LookVector
    if enemyFace:Dot(dirToMe) < 0.25 then
        return false
    end

    local reaction = SETTINGS.HumanReaction + (math.random() * 2 - 1) * SETTINGS.ParryError
    local totalDuration = reaction + 0.28

    local ok, actionId = BeginAction(
        "Parry",
        totalDuration,
        ActionPriority.DEFENSE,
        false
    )

    if not ok then
        return false
    end

    State.LastParry = time()
    Log("Parry attempt")

    Schedule(reaction, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Parry" then
            return
        end

        if not IsAlive(LocalPlayer.Character) or not IsAlive(target) then
            EndAction("Parry")
            return
        end

        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
        State.IsBlocking = true

        local hold = 0.12 + math.random() * 0.03

        -- Освобождение F делаем независимо от прерывания,
        -- чтобы клавиша не залипла.
        Schedule(hold, function()
            if IsAlive(LocalPlayer.Character) then
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                State.IsBlocking = false
            end
        end)

        Schedule(hold + 0.05, function()
            if ActiveAction.Id == actionId and ActiveAction.Name == "Parry" then
                EndAction("Parry")
            end
        end)
    end)

    return true
end

local function TryAwakenKite(target, dist, myRoot, tRoot)
    if ActiveAction.Name == "AwakenKite" then
        return true
    end

    if not EnemyCache.awakened then
        return false
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return false
    end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum then
        return false
    end

    local ok, actionId = BeginAction(
        "AwakenKite",
        0.25,
        ActionPriority.KITE,
        false
    )

    if not ok then
        return false
    end

    local away = myRoot.Position - tRoot.Position

    if away.Magnitude > 0.001 then
        away = away.Unit
    else
        away = Vector3.new(1, 0, 0)
    end

    local dest = myRoot.Position + away * SETTINGS.AwakenKiteRange

    local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q

    if dist < 30 and time() - State.LastDash > SETTINGS.DashCD then
        PressKey(dashKey, 0.05)
        State.LastDash = time()
    end

    State.MoveDest = dest
    State.LastDestUpdate = time()
    hum:MoveTo(dest)

    return true
end

-- // FLANK HELPERS // --
local function IsBehindTarget(myRoot, tRoot)
    local dir = myRoot.Position - tRoot.Position

    if dir.Magnitude < 0.001 then
        return false
    end

    dir = dir.Unit

    return tRoot.CFrame.LookVector:Dot(dir) < -0.25
end

local function IsFlankPathSafe(myChar, target, myRoot, dest)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}

    local dir = dest - myRoot.Position

    if dir.Magnitude < 0.5 then
        return true
    end

    local result = Workspace:Raycast(myRoot.Position, dir, params)

    if not result then
        return true
    end

    if target and result.Instance:IsDescendantOf(target) then
        return true
    end

    return false
end

