-- // FLANK // --

local function IsBehindTarget(myRoot, tRoot)
    local dir = myRoot.Position - tRoot.Position
    if dir.Magnitude < 0.001 then return false end
    dir = dir.Unit
    return tRoot.CFrame.LookVector:Dot(dir) < -0.25
end

local function TryFlankDash(target, dist, myRoot, tRoot)
    local cfg = SETTINGS.FlankDash
    if not cfg or not cfg.Enabled then return false end
    if not InputAvailable() then return false end
    if ActiveAction.Name == "Flank" then return true end
    if ActiveAction.Name ~= nil then return false end
    if time() - State.LastFlank < cfg.Cooldown then return false end
    if not IsDashReady("side") then return false end
    if dist < cfg.MinDist or dist > cfg.MaxDist then return false end
    if EnemyCache.awakened then return false end
    if EnemyCache.attacking or EnemyCache.blocking then return false end
    if EnemyCache.countering then return false end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return false end
    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end

    local side = math.random() < 0.5 and -1 or 1
    local dest = tRoot.Position
        + tRoot.CFrame.RightVector * (cfg.SideOffset * side)
        - tRoot.CFrame.LookVector * cfg.BackOffset

    local moveDir = dest - myRoot.Position
    moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
    if moveDir.Magnitude < 1 then return false end
    moveDir = moveDir.Unit

    local followDelay = (cfg.FollowupDelay or 0.5) + math.random() * (cfg.FollowupRandom or 0)
    local totalDuration = followDelay + 0.3

    local ok, actionId = BeginAction("Flank", totalDuration, ActionPriority.FLANK, true)
    if not ok then return false end

    State.LastFlank = time()
    State.LastFlankSide = side
    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.AvoidanceDir = nil

    myRoot.CFrame = MakeLookCFrame(myRoot.Position, myRoot.Position + moveDir)

    PressKey(SETTINGS.DashKey, 0.05)
    RegisterDash("side")

    Schedule(followDelay, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then return end
        if not IsAlive(myChar) or not IsAlive(target) then EndAction("Flank") return end
        EndAction("Flank")
        if dist <= SETTINGS.AttackRange + 6 then
            if IsBehindTarget(myRoot, tRoot) then
                ExecuteCancelCombo(target)
            else
                ExecuteQuickM1()
            end
        end
    end)

    return true
end

-- // MOVEMENT HANDLER // --

local function HandleMovementAndDef(target, dist, myRoot, tRoot)
    if State.ActionBusy then
        MovementState.StuckFrames = 0
        MovementState.LastPosition = myRoot.Position
        return
    end
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return end
    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return end
    local dest = tRoot.Position
    if SETTINGS.OrbitMode and dist < 20 and dist > 5 then
        dest = GetOrbitPosition(myRoot, tRoot, dist)
    end
    if SETTINGS.DashGapClose and dist > 35 and dist < 100 and IsDashReady("forward") then
        local ok, actionId = BeginAction("GapCloseDash", 0.2, ActionPriority.MOVEMENT, false)
        if ok then
            PressKey(SETTINGS.DashKey, 0.05)
            RegisterDash("forward")
            return
        end
    end
    AdvancedMoveTo(hum, myRoot, tRoot, dest, dist)
end

-- // COMBAT HANDLER // --

local function HandleCombat(target, dist, myRoot, tRoot)
    if State.ActionBusy then return end
    if EnemyCache.awakened and dist < SETTINGS.AwakenKiteRange then return end
    if EnemyCache.countering then return end

    local now = time()
    local isBlocking = EnemyCache.blocking
    local isStunned = IsIncapacitated(target)
    local behindEnemy = IsBehindEnemy(myRoot, tRoot)

    if isBlocking and not behindEnemy and dist < 20 then
        if SETTINGS.BlockBreaker then
            if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak then
                if ExecuteBlockBreak(target) then State.HitsOnBlock = 0
                elseif now - State.LastM1 > 0.5 then
                    if ExecuteQuickM1() then State.HitsOnBlock = State.HitsOnBlock + 1 end
                end
            else
                if now - State.LastM1 > 0.5 then
                    if ExecuteQuickM1() then State.HitsOnBlock = State.HitsOnBlock + 1 end
                end
            end
        else
            if now - State.LastM1 > 0.5 then ExecuteQuickM1() end
        end
        return
    else
        State.HitsOnBlock = 0
    end

    if behindEnemy and dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > 0.5 then
            ExecuteQuickM1()
            return
        end
    end

    if isStunned and dist < 9 then
        ExecutePunish(target)
        return
    end

    if dist > SETTINGS.AttackRange + 3 then return end

    if dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > 0.5 + math.random() * 0.08 then
            local roll = math.random()
            if roll < 0.25 then
                if not ExecuteCancelCombo(target) then ExecuteQuickM1() end
            elseif roll < 0.45 then
                local key = GetReadySkill(false)
                if key then ExecuteSkill(key) else ExecuteQuickM1() end
            else
                ExecuteQuickM1()
            end
            return
        end
    end
end

-- // DEATH / CLEANUP // --

local DeathConnection = nil
local HeartbeatConnection = nil

local function ReleaseAllKeys()
    SendKeyRaw(SETTINGS.BlockKey, false)
    SendKeyRaw(SETTINGS.DashKey, false)
    SendKeyRaw(SETTINGS.AwakenKey, false)
    SendKeyRaw(SETTINGS.SpecialKey, false)
    SendKeyRaw(Enum.KeyCode.Space, false)
    SendMouseRaw(false)
end

local function OnCharacterDeath()
    CancelAllTimers()
    ForceEndAllActions()
    State.Target = nil
    State.HitsOnBlock = 0
    State.IncapacitatedSince = 0
    State.IsAwakened = false
    MovementState.CurrentPath = nil
    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.StuckFrames = 0
    MovementState.AvoidanceDir = nil
    MovementState.AvoidanceUntil = 0
    ReleaseAllKeys()
end

_G.JJS_CombatAgent.Cleanup = function()
    if HeartbeatConnection then pcall(function() HeartbeatConnection:Disconnect() end) end
    if DeathConnection then pcall(function() DeathConnection:Disconnect() end) end
    CancelAllTimers()
    ForceEndAllActions()
    ReleaseAllKeys()
end

-- // MAIN LOOP // --

HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
    MovementState.LastDelta = dt or 0.016

    local now = time()
    local toExecute = {}
    for id, timer in pairs(Timers) do
        if timer.active and timer.gen == TimerGeneration and now >= timer.triggerTime then
            timer.active = false
            Timers[id] = nil
            toExecute[#toExecute + 1] = timer
        end
    end
    for i = 1, #toExecute do
        local timer = toExecute[i]
        if timer.gen == TimerGeneration then
            local ok, err = pcall(timer.callback)
            if not ok then LogDebug("Timer error: " .. tostring(err)) end
        end
    end

    if not SETTINGS.Enabled then return end
    UpdateAction()

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then State.Target = nil return end

    if State.ConnectedChar ~= myChar then
        if DeathConnection then pcall(function() DeathConnection:Disconnect() end) end
        DeathConnection = nil
        State.ConnectedChar = myChar
        local hum = myChar:FindFirstChild("Humanoid")
        if hum and hum:IsA("Humanoid") then
            DeathConnection = hum.Died:Connect(OnCharacterDeath)
        end
    end

    local incapacitated = IsIncapacitated(myChar)
    if incapacitated then
        if State.IncapacitatedSince == 0 then State.IncapacitatedSince = time() end
        local incDuration = time() - State.IncapacitatedSince
        if incDuration >= 0.15 then
            TryRagdollCancel(myChar)
        end
        return
    else
        State.IncapacitatedSince = 0
    end

    local target = State.Target
    if not target or not IsAlive(target) then
        target = FindTarget()
        State.Target = target
        State.HitsOnBlock = 0
        State.LastTargetCheck = time()
        ResetEnemyCache()
    end

    if not target then
        ForceEndAllActions()
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil
        return
    end

    local myRoot = GetRootPart(myChar)
    local tRoot = GetRootPart(target)
    if not myRoot or not tRoot then
        ForceEndAllActions()
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil
        return
    end

    UpdateEnemyCache(target)
    local dist = (myRoot.Position - tRoot.Position).Magnitude

    if time() - State.LastTargetCheck > (SETTINGS.TargetRecheckDelay or 2) then
        State.LastTargetCheck = time()
        if not CanSeeCharacter(myChar, myRoot, target, tRoot) then
            local newTarget = FindTarget()
            if newTarget and newTarget ~= target then
                local newTRoot = GetRootPart(newTarget)
                if newTRoot then
                    State.Target = newTarget
                    target = newTarget
                    tRoot = newTRoot
                    State.HitsOnBlock = 0
                    ResetEnemyCache()
                    dist = (myRoot.Position - tRoot.Position).Magnitude
                    UpdateEnemyCache(target)
                else
                    ForceEndAllActions()
                    return
                end
            end
        end
    end

    TryAwaken(myChar, dist)

    if not State.MovementLock and ActiveAction.Name ~= "Flank" and ActiveAction.Name ~= "BlockBreak" then
        AimAt(PredictTargetPosition(tRoot, dist))
    end

    if TryAwakenKite(target, dist, myRoot, tRoot) then return end
    if TryParry(target, dist, myRoot, tRoot) then return end
    if TryFlankDash(target, dist, myRoot, tRoot) then return end

    HandleMovementAndDef(target, dist, myRoot, tRoot)
    if dist < SETTINGS.AggroRange then
        HandleCombat(target, dist, myRoot, tRoot)
    end
end)

