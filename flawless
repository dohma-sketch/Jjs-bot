-- // FLANK // --

local function IsBehindTarget(myRoot, tRoot)
    local dir = myRoot.Position - tRoot.Position
    if dir.Magnitude < 0.001 then return false end
    dir = dir.Unit
    return tRoot.CFrame.LookVector:Dot(dir) < -0.25
end

local function IsFlankPathSafe(myChar, target, myRoot, dest)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}
    local dir = dest - myRoot.Position
    if dir.Magnitude < 0.5 then return true end
    local result = Workspace:Raycast(myRoot.Position, dir, params)
    if not result then return true end
    if target and result.Instance:IsDescendantOf(target) then return true end
    return false
end

local function ExecuteFlankSkill(target)
    if EnemyCache.countering then return ExecuteCancelCombo(target) end
    local preferBreaker = EnemyCache.blocking and math.random() < 0.65
    local key = GetReadySkill(preferBreaker)
    if not key then key = GetReadySkill(false) end
    if not key then return ExecuteCancelCombo(target) end
    return ExecuteSkill(key)
end

local function ExecuteFlankFollowup(target)
    if not IsAlive(LocalPlayer.Character) or not IsAlive(target) then return end
    local myChar = LocalPlayer.Character
    local myRoot = GetRootPart(myChar)
    local tRoot = GetRootPart(target)
    if not myRoot or not tRoot then return end
    local dist = (myRoot.Position - tRoot.Position).Magnitude
    AimAt(PredictTargetPosition(tRoot, dist), MovementState.LastDelta)
    if dist > SETTINGS.AttackRange + 6 then return end
    if IsIncapacitated(target) and dist < 10 then
        Log("Flank followup: punish")
        ExecutePunish(target)
        return
    end
    local cfg = SETTINGS.FlankDash
    local behind = true
    if cfg.CheckBehind then behind = IsBehindTarget(myRoot, tRoot) end
    if not behind and EnemyCache.attacking and SETTINGS.AutoParry then
        if TryParry(target, dist, myRoot, tRoot) then
            Log("Flank followup: emergency parry")
            return
        end
    end
    if EnemyCache.blocking and dist < 12 and SETTINGS.BlockBreaker then
        if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak
            and time() - State.BreakerCooldown > SETTINGS.BreakerAttemptCD
        then
            Log("Flank followup: block break")
            ExecuteBlockBreak(target)
            return
        end
    end
    local roll = math.random()
    if behind then
        if roll < 0.45 then ExecuteCancelCombo(target)
        elseif roll < 0.85 then ExecuteFlankSkill(target)
        else ExecuteCancelCombo(target) end
    else
        if roll < 0.65 then ExecuteCancelCombo(target)
        elseif roll < 0.85 then ExecuteFlankSkill(target)
        else ExecuteQuickM1() end
    end
end

local function TryFlankDash(target, dist, myRoot, tRoot)
    local cfg = SETTINGS.FlankDash
    if not cfg or not cfg.Enabled then return false end
    if not InputAvailable() then return false end
    if ActiveAction.Name == "Flank" then return true end
    if ActiveAction.Name ~= nil then return false end
    if State.IsBlocking then return false end
    if IsIncapacitated(LocalPlayer.Character) then return false end
    if time() - State.LastFlank < cfg.Cooldown then return false end
    if not IsDashReady("side") then return false end
    if dist < cfg.MinDist or dist > cfg.MaxDist then return false end
    if EnemyCache.awakened then return false end
    if EnemyCache.countering then return false end

    -- JJS: Block only works in front - allow flank even if blocking (we're going to side/back)
    if EnemyCache.blocking and not IsBehindEnemy(myRoot, tRoot) then
        -- Still can flank, we'll end up behind
    end

    if EnemyCache.attacking then
        -- Only flank if enemy isn't directly facing us (safer)
        local dirToMe = myRoot.Position - tRoot.Position
        if dirToMe.Magnitude > 0.001 then
            dirToMe = dirToMe.Unit
            local facingDot = tRoot.CFrame.LookVector:Dot(dirToMe)
            if facingDot > 0.7 then return false end  -- enemy directly facing us
        end
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return false end
    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end

    local side = math.random() < 0.5 and -1 or 1
    if side == State.LastFlankSide then side = -side end

    local dest = tRoot.Position
        + tRoot.CFrame.RightVector * (cfg.SideOffset * side)
        - tRoot.CFrame.LookVector * cfg.BackOffset

    local moveDir = dest - myRoot.Position
    moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
    if moveDir.Magnitude < 1 then return false end
    moveDir = moveDir.Unit

    if cfg.CheckWall and not IsFlankPathSafe(myChar, target, myRoot, dest) then return false end

    local followDelay = (cfg.FollowupDelay or 0.5) + math.random() * (cfg.FollowupRandom or 0)
    local totalDuration = followDelay + 0.3

    local ok, actionId = BeginAction("Flank", totalDuration, ActionPriority.FLANK, true)
    if not ok then return false end

    State.LastFlank = time()
    State.LastFlankSide = side
    Log("Flank dash side: " .. tostring(side))

    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.AvoidanceDir = nil

    hum:MoveTo(myRoot.Position)

    local cameraHold = math.max(0.62, followDelay + 0.12)
    ForceCameraMoveDirection(moveDir, cameraHold)

    -- JJS: hold D (or move key) to move sideways, then press Q for side dash
    myRoot.CFrame = MakeLookCFrame(myRoot.Position, myRoot.Position + moveDir)

    SendKeyRaw(SETTINGS.MoveKey, true)  -- hold movement key in dash direction

    Schedule(cfg.WalkHoldTime or 0.18, function()
        if IsAlive(myChar) then
            SendKeyRaw(SETTINGS.MoveKey, false)
            -- Now press Q for dash
            PressKey(SETTINGS.DashKey, 0.06)
            RegisterDash("side")
        end
    end)

    if cfg.FollowupEnabled then
        Schedule(followDelay, function()
            if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then return end
            if not IsAlive(myChar) or not IsAlive(target) then EndAction("Flank") return end
            EndAction("Flank")
            ExecuteFlankFollowup(target)
        end)
    else
        Schedule(0.4, function()
            if ActiveAction.Id == actionId and ActiveAction.Name == "Flank" then EndAction("Flank") end
        end)
    end
    return true
end

-- // HANDLERS // --

local function HandleMovementAndDef(target, dist, myRoot, tRoot)
    if State.ActionBusy then
        State.StuckCount = 0
        State.LastPos = myRoot.Position
        return
    end
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return end
    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return end
    local dest = tRoot.Position
    if SETTINGS.OrbitMode and dist < 20 and dist > 5 then
        dest = GetOrbitPosition(myRoot, tRoot, dist)
    end
    if SETTINGS.DashGapClose and dist > 35 and dist < 100 then
        -- JJS: don't forward dash if enemy blocking from front (double endlag)
        local canForwardDash = true
        if EnemyCache.blocking and IsInFrontOfEnemy(myRoot, tRoot) then
            canForwardDash = false
        end
        if canForwardDash and IsDashReady("forward") then
            local ok, actionId = BeginAction("GapCloseDash", 0.2, ActionPriority.MOVEMENT, false)
            if ok then
                PressKey(SETTINGS.DashKey, 0.05)
                RegisterDash("forward")
                return
            end
        end
    end
    AdvancedMoveTo(hum, myRoot, tRoot, dest, dist)
end

local function HandleCombat(target, dist, myRoot, tRoot)
    if State.ActionBusy then return end
    if State.IsBlocking then return end
    if EnemyCache.awakened and dist < SETTINGS.AwakenKiteRange then return end
    if EnemyCache.countering then return end

    local now = time()
    local isBlocking = EnemyCache.blocking
    local isStunned = IsIncapacitated(target)
    local behindEnemy = IsBehindEnemy(myRoot, tRoot)

    -- JJS: Block only works from FRONT
    if isBlocking and not behindEnemy and dist < 20 then
        if SETTINGS.BlockBreaker then
            if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak then
                if ExecuteBlockBreak(target) then State.HitsOnBlock = 0
                elseif now - State.LastM1 > SETTINGS.M1Cooldown then
                    if ExecuteQuickM1() then State.HitsOnBlock = State.HitsOnBlock + 1 end
                end
            else
                if now - State.LastM1 > SETTINGS.M1Cooldown then
                    if ExecuteQuickM1() then State.HitsOnBlock = State.HitsOnBlock + 1 end
                end
            end
        else
            if now - State.LastM1 > SETTINGS.M1Cooldown then ExecuteQuickM1() end
        end
        return
    else
        State.HitsOnBlock = 0
    end

    -- JJS: Behind enemy - block doesn't work, just attack
    if behindEnemy and dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > SETTINGS.M1Cooldown then
            ExecuteQuickM1()
            return
        end
    end

    if isStunned and dist < 9 then
        ExecutePunish(target)
        return
    end

    if dist > SETTINGS.AttackRange + 1.5 then return end

    if dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > SETTINGS.M1Cooldown + math.random() * 0.08 then
            local roll = math.random()
            if roll < 0.25 then
                if not ExecuteCancelCombo(target) then ExecuteQuickM1() end
            elseif roll < 0.45 then
                if not ExecuteRandomSkill(target) then ExecuteQuickM1() end
            elseif roll < 0.55 then
                ExecuteSpecial(target)
            else
                ExecuteQuickM1()
            end
            return
        end
    end
end

-- // DEATH / CLEANUP // --

local DeathConnection = nil
local HeartbeatConnection = nil

local function ReleaseAllKeys()
    SendKeyRaw(SETTINGS.BlockKey, false)
    SendKeyRaw(SETTINGS.DashKey, false)
    SendKeyRaw(SETTINGS.AwakenKey, false)
    SendKeyRaw(SETTINGS.SpecialKey, false)
    SendKeyRaw(SETTINGS.MoveKey, false)
    SendKeyRaw(Enum.KeyCode.Space, false)
    SendMouseRaw(false)
end

local function OnCharacterDeath()
    CancelAllTimers()
    ForceEndAllActions()
    UnbindFlankCamera()
    State.Target = nil
    State.HitsOnBlock = 0
    State.IsBlocking = false
    State.StuckCount = 0
    State.IncapacitatedSince = 0
    State.IsAwakened = false
    MovementState.CurrentPath = nil
    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.StuckFrames = 0
    MovementState.AvoidanceDir = nil
    MovementState.AvoidanceUntil = 0
    ReleaseAllKeys()
end

_G.JJS_CombatAgent.Cleanup = function()
    if HeartbeatConnection then pcall(function() HeartbeatConnection:Disconnect() end) end
    if DeathConnection then pcall(function() DeathConnection:Disconnect() end) end
    CancelAllTimers()
    ForceEndAllActions()
    UnbindFlankCamera()
    ReleaseAllKeys()
end

-- // MAIN LOOP // --

HeartbeatConnection = RunService.Heartbeat:Connect(function(dt)
    MovementState.LastDelta = dt or 0.016

    -- Process timers
    local now = time()
    local toExecute = {}
    for id, timer in pairs(Timers) do
        if timer.active and timer.gen == TimerGeneration and now >= timer.triggerTime then
            timer.active = false
            Timers[id] = nil
            toExecute[#toExecute + 1] = timer
        end
    end
    for i = 1, #toExecute do
        local timer = toExecute[i]
        if timer.gen == TimerGeneration then
            local ok, err = pcall(timer.callback)
            if not ok then LogDebug("Timer error: " .. tostring(err)) end
        end
    end

    if not SETTINGS.Enabled then return end
    UpdateAction()

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then State.Target = nil return end

    if State.ConnectedChar ~= myChar then
        if DeathConnection then pcall(function() DeathConnection:Disconnect() end) end
        DeathConnection = nil
        State.ConnectedChar = myChar
        local hum = myChar:FindFirstChild("Humanoid")
        if hum and hum:IsA("Humanoid") then
            DeathConnection = hum.Died:Connect(OnCharacterDeath)
        end
    end

    -- JJS: Ragdoll cancel
    local incapacitated = IsIncapacitated(myChar)
    if incapacitated then
        if State.IncapacitatedSince == 0 then State.IncapacitatedSince = time() end
        local incDuration = time() - State.IncapacitatedSince
        if incDuration >= SETTINGS.RagdollCancelDelay then
            TryRagdollCancel(myChar)
        end
        return  -- Don't aim or attack while incapacitated
    else
        State.IncapacitatedSince = 0
    end

    local target = State.Target
    if not target or not IsAlive(target) then
        target = FindTarget()
        State.Target = target
        State.HitsOnBlock = 0
        State.LastTargetCheck = time()
        ResetEnemyCache()
    end

    if not target then
        ForceEndAllActions()
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil
        return
    end

    local myRoot = GetRootPart(myChar)
    local tRoot = GetRootPart(target)
    if not myRoot or not tRoot then
        ForceEndAllActions()
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil
        return
    end

    UpdateEnemyCache(target)
    local dist = (myRoot.Position - tRoot.Position).Magnitude

    if time() - State.LastTargetCheck > (SETTINGS.TargetRecheckDelay or 2) then
        State.LastTargetCheck = time()
        if not CanSeeCharacter(myChar, myRoot, target, tRoot) then
            local newTarget = FindTarget()
            if newTarget and newTarget ~= target then
                local newTRoot = GetRootPart(newTarget)
                if newTRoot then
                    State.Target = newTarget
                    target = newTarget
                    tRoot = newTRoot
                    State.HitsOnBlock = 0
                    ResetEnemyCache()
                    dist = (myRoot.Position - tRoot.Position).Magnitude
                    UpdateEnemyCache(target)
                else
                    ForceEndAllActions()
                    return
                end
            end
        end
    end

    TryAwaken(myChar, dist)

    -- Aim with framerate-independent smoothing, only when not incapacitated
    if not State.MovementLock
        and ActiveAction.Name ~= "Flank"
        and ActiveAction.Name ~= "BlockBreak"
    then
        AimAt(PredictTargetPosition(tRoot, dist), dt)
    end

    if TryAwakenKite(target, dist, myRoot, tRoot) then return end
    if TryParry(target, dist, myRoot, tRoot) then return end
    if TryFlankDash(target, dist, myRoot, tRoot) then return end

    HandleMovementAndDef(target, dist, myRoot, tRoot)
    if dist < SETTINGS.AggroRange then
        HandleCombat(target, dist, myRoot, tRoot)
    end
end)

pcall(function()
    game.StarterGui:SetCore("SendNotification", {
        Title = "JJS AI v12.0",
        Text = "Triple-checked precision build",
        Duration = 5,
    })
end)

