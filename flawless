-- // CAMERA OVERRIDE // --

local CameraOverrideId = 0

local function UnbindFlankCamera()
    pcall(function()
        RunService:UnbindFromRenderStep(FLANK_CAMERA_BINDING)
    end)
end

local function ForceCameraMoveDirection(worldDir, duration)
    worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)
    if worldDir.Magnitude < 0.001 then return end
    worldDir = worldDir.Unit

    UnbindFlankCamera()

    CameraOverrideId = CameraOverrideId + 1
    local id = CameraOverrideId
    local startTime = time()

    pcall(function()
        RunService:BindToRenderStep(
            FLANK_CAMERA_BINDING,
            Enum.RenderPriority.Camera.Value + 1,
            function()
                if id ~= CameraOverrideId then return end
                if time() - startTime > duration then
                    UnbindFlankCamera()
                    return
                end
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local look = Vector3.new(0, 1, 0):Cross(worldDir)
                if look.Magnitude < 0.001 then
                    look = Vector3.new(0, 0, -1)
                else
                    look = look.Unit
                end
                cam.CFrame = MakeLookCFrame(cam.CFrame.Position, cam.CFrame.Position + look)
            end
        )
    end)

    Schedule(duration + 0.05, function()
        if id == CameraOverrideId then
            UnbindFlankCamera()
        end
    end)
end

-- // ACTION MANAGER // --

local ActionPriority = {
    NONE = 0,
    MOVEMENT = 10,
    OFFENSE = 30,
    FLANK = 50,
    BLOCK_BREAK = 60,
    DEFENSE = 80,
    KITE = 90,
    SURVIVAL = 100,
}

local ActiveAction = {
    Id = 0,
    Name = nil,
    Priority = ActionPriority.NONE,
    StartTime = 0,
    EndTime = 0,
    LockMovement = false,
}

local function SyncActionToState()
    State.ActionBusy = ActiveAction.Name ~= nil
    State.MovementLock = ActiveAction.Name ~= nil and ActiveAction.LockMovement
end

local function ForceEndAllActions()
    if ActiveAction.Name == "Flank" then
        UnbindFlankCamera()
    end
    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = nil
    ActiveAction.Priority = ActionPriority.NONE
    ActiveAction.StartTime = 0
    ActiveAction.EndTime = 0
    ActiveAction.LockMovement = false
    SyncActionToState()
end

local function EndAction(name)
    if ActiveAction.Name == name then
        if name == "Flank" then
            UnbindFlankCamera()
        end
        ActiveAction.Id = ActiveAction.Id + 1
        ActiveAction.Name = nil
        ActiveAction.Priority = ActionPriority.NONE
        ActiveAction.StartTime = 0
        ActiveAction.EndTime = 0
        ActiveAction.LockMovement = false
        SyncActionToState()
    end
end

local function UpdateAction()
    if ActiveAction.Name and time() >= ActiveAction.EndTime then
        ForceEndAllActions()
    end
    SyncActionToState()
end

local function CanStartAction(name, priority)
    if not ActiveAction.Name then return true end
    if ActiveAction.Name == name then return true end
    return priority > ActiveAction.Priority
end

local function BeginAction(name, duration, priority, lockMovement)
    UpdateAction()
    if not CanStartAction(name, priority) then return false, 0 end
    local oldName = ActiveAction.Name
    if oldName == "Flank" and name ~= "Flank" then
        UnbindFlankCamera()
    end
    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = name
    ActiveAction.Priority = priority
    ActiveAction.StartTime = time()
    ActiveAction.EndTime = time() + duration
    ActiveAction.LockMovement = lockMovement == true
    SyncActionToState()
    return true, ActiveAction.Id
end

-- // UTILITIES // --

local function GetRootPart(char)
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then return root end
    local ok, primary = pcall(function() return char.PrimaryPart end)
    if ok and primary then return primary end
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function IsAlive(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChild("Humanoid")
    local root = GetRootPart(char)
    if not hum or not root then return false end
    if not hum:IsA("Humanoid") then return false end
    return hum.Health > 0
end

local function GetBoolAttr(obj, name)
    if not obj then return false end
    local ok, value = pcall(function() return obj:GetAttribute(name) end)
    return ok and value == true
end

local function IsIncapacitated(char)
    if not IsAlive(char) then return false end
    if GetBoolAttr(char, "Ragdoll") then return true end
    if GetBoolAttr(char, "Stunned") then return true end
    if GetBoolAttr(char, "Knocked") then return true end
    if GetBoolAttr(char, "Incapacitated") then return true end
    if SETTINGS.StrictIncapacitated then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.FallingDown
end

