local function ExecuteFlankFollowup(target)
    if not IsAlive(LocalPlayer.Character) or not IsAlive(target) then
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = target:FindFirstChild("HumanoidRootPart")

    if not myRoot or not tRoot then
        return
    end

    local dist = (myRoot.Position - tRoot.Position).Magnitude

    AimAt(PredictTargetPosition(tRoot, dist))

    if dist > SETTINGS.AttackRange + 6 then
        return
    end

    if IsIncapacitated(target) and dist < 10 then
        Log("Flank followup: punish")
        ExecutePunish(target)
        return
    end

    local cfg = SETTINGS.FlankDash
    local behind = true

    if cfg.CheckBehind then
        behind = IsBehindTarget(myRoot, tRoot)
    end

    if not behind and EnemyCache.attacking and SETTINGS.AutoParry then
        if TryParry(target, dist, myRoot, tRoot) then
            Log("Flank followup: emergency parry")
            return
        end
    end

    if EnemyCache.blocking and dist < 12 and SETTINGS.BlockBreaker then
        if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak
            and time() - State.BreakerCooldown > SETTINGS.BreakerAttemptCD
        then
            Log("Flank followup: block break")
            ExecuteBlockBreak(target)
            return
        end
    end

    local roll = math.random()

    if behind then
        if roll < 0.45 then
            Log("Flank followup: cancel combo")
            ExecuteCancelCombo(target)
        elseif roll < 0.85 then
            Log("Flank followup: flank skill")
            ExecuteFlankSkill(target)
        else
            Log("Flank followup: cancel combo backup")
            ExecuteCancelCombo(target)
        end
    else
        if roll < 0.65 then
            Log("Flank followup: cancel combo")
            ExecuteCancelCombo(target)
        elseif roll < 0.85 then
            Log("Flank followup: flank skill")
            ExecuteFlankSkill(target)
        else
            Log("Flank followup: quick M1")
            ExecuteQuickM1()
        end
    end
end

local function TryFlankDash(target, dist, myRoot, tRoot)
    local cfg = SETTINGS.FlankDash

    if not cfg or not cfg.Enabled then
        return false
    end

    if ActiveAction.Name == "Flank" then
        return true
    end

    if ActiveAction.Name ~= nil then
        return false
    end

    if time() - State.LastFlank < cfg.Cooldown then
        return false
    end

    if cfg.UseDashCooldown and time() - State.LastDash < SETTINGS.DashCD then
        return false
    end

    if dist < cfg.MinDist or dist > cfg.MaxDist then
        return false
    end

    if EnemyCache.awakened then
        return false
    end

    if EnemyCache.attacking or EnemyCache.blocking then
        return false
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return false
    end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum then
        return false
    end

    local dirToMe = myRoot.Position - tRoot.Position

    if dirToMe.Magnitude > 0.001 then
        dirToMe = dirToMe.Unit

        local facingDot = tRoot.CFrame.LookVector:Dot(dirToMe)

        if facingDot < 0.05 then
            return false
        end
    end

    local side = cfg.Side

    if cfg.RandomSide then
        side = math.random() < 0.5 and -1 or 1

        if side == State.LastFlankSide then
            side = -side
        end
    end

    local dest = tRoot.Position
        + tRoot.CFrame.RightVector * (cfg.SideOffset * side)
        - tRoot.CFrame.LookVector * cfg.BackOffset

    local moveDir = dest - myRoot.Position
    moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)

    if moveDir.Magnitude < 1 then
        return false
    end

    moveDir = moveDir.Unit

    if cfg.CheckWall and not IsFlankPathSafe(myChar, target, myRoot, dest) then
        return false
    end

    local followDelay = (cfg.FollowupDelay or 0.5)
        + math.random() * (cfg.FollowupRandom or 0)

    local totalDuration = followDelay + 0.3

    local ok, actionId = BeginAction(
        "Flank",
        totalDuration,
        ActionPriority.FLANK,
        true
    )

    if not ok then
        return false
    end

    State.LastFlank = time()
    State.LastFlankSide = side
    State.FlankSide = side

    Log("Flank dash side: " .. tostring(side))

    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.AvoidanceDir = nil

    hum:MoveTo(myRoot.Position)

    local cameraHold = math.max(
        cfg.CameraHold or 0.62,
        followDelay + 0.12
    )

    ForceCameraMoveDirection(moveDir, cameraHold)

    if cfg.RotateCharacter then
        myRoot.CFrame = CFrame.lookAt(
            myRoot.Position,
            myRoot.Position + moveDir
        )
    end

    VirtualInputManager:SendKeyEvent(true, cfg.Key, false, game)

    Schedule(0.18, function()
        if IsAlive(myChar) then
            VirtualInputManager:SendKeyEvent(false, cfg.Key, false, game)
        end
    end)

    Schedule(0.02 + math.random() * 0.03, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then
            return
        end

        if not IsAlive(myChar) then
            EndAction("Flank")
            return
        end

        PressKey(cfg.QKey, 0.06)
        State.LastDash = time()

        if cfg.FollowupEnabled then
            Schedule(followDelay, function()
                if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Flank" then
                    return
                end

                if not IsAlive(myChar) or not IsAlive(target) then
                    EndAction("Flank")
                    return
                end

                EndAction("Flank")
                ExecuteFlankFollowup(target)
            end)
        else
            Schedule(0.25, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "Flank" then
                    EndAction("Flank")
                end
            end)
        end
    end)

    return true
end

-- // MOVEMENT / COMBAT HANDLERS // --
local function HandleMovementAndDef(target, dist, myRoot, tRoot)
    if State.ActionBusy then
        State.StuckCount = 0
        State.LastPos = myRoot.Position
        return
    end

    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return
    end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum then
        return
    end

    local dest = tRoot.Position

    if SETTINGS.OrbitMode and dist < 20 and dist > 5 then
        dest = GetOrbitPosition(myRoot, tRoot, dist)
    end

    if SETTINGS.DashGapClose
        and dist > 35
        and dist < 100
        and time() - State.LastDash > SETTINGS.DashCD
    then
        local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q

        local ok, actionId = BeginAction(
            "GapCloseDash",
            0.2,
            ActionPriority.MOVEMENT,
            false
        )

        if ok then
            PressKey(dashKey, 0.05)
            State.LastDash = time()
            return
        end
    end

    AdvancedMoveTo(hum, myRoot, tRoot, dest, dist)
end

local function HandleCombat(target, dist)
    if State.ActionBusy then
        return
    end

    if EnemyCache.awakened and dist < SETTINGS.AwakenKiteRange then
        return
    end

    local now = time()
    local isBlocking = EnemyCache.blocking
    local isStunned = IsIncapacitated(target)

    if isBlocking and dist < 20 then
        if SETTINGS.BlockBreaker then
            if State.HitsOnBlock >= SETTINGS.PostureHitsBeforeBreak then
                if ExecuteBlockBreak(target) then
                    State.HitsOnBlock = 0
                end
            else
                if now - State.LastM1 > SETTINGS.M1Cooldown then
                    if ExecuteQuickM1() then
                        State.HitsOnBlock = State.HitsOnBlock + 1
                    end
                end
            end
        end

        return
    else
        State.HitsOnBlock = 0
    end

    if isStunned and dist < 9 then
        ExecutePunish(target)
        return
    end

    if dist > SETTINGS.AttackRange + 3 then
        return
    end

    if dist <= SETTINGS.AttackRange then
        if now - State.LastM1 > SETTINGS.M1Cooldown + math.random() * 0.08 then
            local roll = math.random()

            if roll < 0.25 then
                if not ExecuteCancelCombo(target) then
                    ExecuteQuickM1()
                end
            elseif roll < 0.45 then
                if not ExecuteRandomSkill(target) then
                    ExecuteQuickM1()
                end
            else
                ExecuteQuickM1()
            end

            return
        end
    end
end

