            if not IsAlive(myChar) or not IsAlive(target) then EndAction("CancelCombo") return end
            local key = GetReadySkill(false)
            if key then ExecuteSkill(key) else ClickM1() end
            Schedule(0.25, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "CancelCombo" then EndAction("CancelCombo") end
            end)
        end)
    end)
    return true
end

local function ExecutePunish(target)
    if not InputAvailable() then return false end
    local ok, actionId = BeginAction("Punish", 0.68, ActionPriority.OFFENSE, false)
    if not ok then return false end
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) or not IsAlive(target) then EndAction("Punish") return false end
    State.LastM1 = time()
    ClickM1()
    Schedule(0.2, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Punish" then return end
        if not IsAlive(myChar) or not IsAlive(target) then EndAction("Punish") return end
        ClickM1()
        Schedule(0.2, function()
            if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Punish" then return end
            if not IsAlive(myChar) or not IsAlive(target) then EndAction("Punish") return end
            if math.random(1, 3) == 1 then
                local key = GetReadySkill(false)
                if key then ExecuteSkill(key) end
            end
            Schedule(0.2, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "Punish" then EndAction("Punish") end
            end)
        end)
    end)
    return true
end

local function ExecuteBlockBreak(target)
    if not InputAvailable() then return false end
    if time() - State.BreakerCooldown < 2 then return false end
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return false end
    local myRoot = GetRootPart(myChar)
    local tRoot = target and GetRootPart(target)
    if not myRoot or not tRoot then return false end
    local ok, actionId = BeginAction("BlockBreak", 0.72, ActionPriority.BLOCK_BREAK, true)
    if not ok then return false end
    State.BreakerCooldown = time()
    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.AvoidanceDir = nil
    local side = (math.random() > 0.5) and 1 or -1
    local offset = tRoot.CFrame.RightVector * (side * (10 + math.random() * 3))
        - tRoot.CFrame.LookVector * (5 + math.random() * 2)
    local dashTargetPos = tRoot.Position + offset
    myRoot.CFrame = MakeLookCFrame(myRoot.Position, dashTargetPos)
    if IsDashReady("side") then
        PressKey(SETTINGS.DashKey, 0.05)
        RegisterDash("side")
    end
    Schedule(0.18 + math.random() * 0.04, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "BlockBreak" then return end
        if not IsAlive(myChar) or not IsAlive(target) then EndAction("BlockBreak") return end
        local rootNow = GetRootPart(myChar)
        local targetRootNow = GetRootPart(target)
        if not rootNow or not targetRootNow then EndAction("BlockBreak") return end
        if (rootNow.Position - targetRootNow.Position).Magnitude > 20 then EndAction("BlockBreak") return end
        AimAt(targetRootNow.Position)
        local key = GetReadySkill(true)
        if key then ExecuteSkill(key)
        else
            ClickM1()
            Schedule(0.12, function()
                if ActiveAction.Id == actionId and ActiveAction.Name == "BlockBreak" then
                    if IsAlive(myChar) then ClickM1() end
                end
            end)
        end
        Schedule(0.32, function()
            if ActiveAction.Id == actionId and ActiveAction.Name == "BlockBreak" then EndAction("BlockBreak") end
        end)
    end)
    return true
end

-- // JJS AWAKENING // --

local function TryAwaken(myChar, dist)
    if not SETTINGS.UseAwakening then return false end
    if not InputAvailable() then return false end
    if time() - State.LastAwaken < SETTINGS.AwakenCD then return false end
    if State.IsAwakened then return false end

    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end
    if hum.MaxHealth <= 0 then return false end

    local healthRatio = hum.Health / hum.MaxHealth

    if healthRatio <= SETTINGS.AwakenHealthThreshold then
        PressKey(SETTINGS.AwakenKey, 0.15)
        State.LastAwaken = time()
        State.IsAwakened = true
        LogDebug("Awakening activated!")
        return true
    end

    return false
end

local function TryAwakenKite(target, dist, myRoot, tRoot)
    if ActiveAction.Name == "AwakenKite" then return true end
    if not EnemyCache.awakened then return false end
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return false end
    local hum = myChar:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end
    local ok, actionId = BeginAction("AwakenKite", 0.25, ActionPriority.KITE, false)
    if not ok then return false end
    MovementState.PathWaypoints = {}
    MovementState.CurrentWaypointIndex = 0
    MovementState.AvoidanceDir = nil
    local away = myRoot.Position - tRoot.Position
    if away.Magnitude > 0.001 then away = away.Unit else away = Vector3.new(1, 0, 0) end
    local dest = myRoot.Position + away * SETTINGS.AwakenKiteRange
    if dist < 30 and IsDashReady("side") then
        PressKey(SETTINGS.DashKey, 0.05)
        RegisterDash("side")
    end
    AdvancedMoveTo(hum, myRoot, tRoot, dest, dist)
    return true
end

-- // DEFENSE // --

local function TryParry(target, dist, myRoot, tRoot)
    if not SETTINGS.AutoParry then return false end
    if not InputAvailable() then return false end
    if ActiveAction.Name == "Parry" then return true end
    if EnemyCache.blocking then return false end
    if not EnemyCache.attacking then return false end
    if time() - State.LastParry < SETTINGS.ParryCD then return false end
    if dist > SETTINGS.ParryRange then return false end
    local dirToMe = myRoot.Position - tRoot.Position
    if dirToMe.Magnitude < 0.001 then return false end
    dirToMe = dirToMe.Unit
    local enemyFace = tRoot.CFrame.LookVector
    if enemyFace:Dot(dirToMe) < 0.35 then return false end
    local reaction = 0.18 + (math.random() * 2 - 1) * 0.05
    local totalDuration = reaction + 0.28
    local ok, actionId = BeginAction("Parry", totalDuration, ActionPriority.DEFENSE, false)
    if not ok then return false end
    State.LastParry = time()
    Schedule(reaction, function()
        if ActiveAction.Id ~= actionId or ActiveAction.Name ~= "Parry" then return end
        if not IsAlive(LocalPlayer.Character) or not IsAlive(target) then EndAction("Parry") return end
        SendKeyRaw(SETTINGS.BlockKey, true)
        local hold = 0.12 + math.random() * 0.03
        Schedule(hold, function()
            if IsAlive(LocalPlayer.Character) then SendKeyRaw(SETTINGS.BlockKey, false) end
        end)
        Schedule(hold + 0.05, function()
            if ActiveAction.Id == actionId and ActiveAction.Name == "Parry" then EndAction("Parry") end
        end)
    end)
    return true
end

