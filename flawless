-- // CAMERA OVERRIDE // --
local FLANK_CAMERA_BINDING = "JJS_FlankCameraOverride"
local CameraOverrideId = 0

local function UnbindFlankCamera()
    pcall(function()
        RunService:UnbindFromRenderStep(FLANK_CAMERA_BINDING)
    end)
end

local function ForceCameraMoveDirection(worldDir, duration)
    worldDir = Vector3.new(worldDir.X, 0, worldDir.Z)

    if worldDir.Magnitude < 0.001 then
        return
    end

    worldDir = worldDir.Unit

    UnbindFlankCamera()

    CameraOverrideId = CameraOverrideId + 1
    local id = CameraOverrideId

    local startTime = time()

    pcall(function()
        RunService:BindToRenderStep(
            FLANK_CAMERA_BINDING,
            Enum.RenderPriority.Camera.Value + 1,
            function()
                if id ~= CameraOverrideId then
                    return
                end

                if time() - startTime > duration then
                    UnbindFlankCamera()
                    return
                end

                local cam = Workspace.CurrentCamera
                if not cam then
                    return
                end

                local look = Vector3.new(0, 1, 0):Cross(worldDir)

                if look.Magnitude < 0.001 then
                    look = Vector3.new(0, 0, -1)
                else
                    look = look.Unit
                end

                cam.CFrame = CFrame.lookAt(
                    cam.CFrame.Position,
                    cam.CFrame.Position + look
                )
            end
        )
    end)

    Schedule(duration + 0.05, function()
        if id == CameraOverrideId then
            UnbindFlankCamera()
        end
    end)
end

-- // ACTION MANAGER // --
local ActionPriority = {
    NONE = 0,
    MOVEMENT = 10,
    OFFENSE = 30,
    FLANK = 50,
    BLOCK_BREAK = 60,
    DEFENSE = 80,
    KITE = 90,
    SURVIVAL = 100,
}

local ActiveAction = {
    Id = 0,
    Name = nil,
    Priority = ActionPriority.NONE,
    StartTime = 0,
    EndTime = 0,
    LockMovement = false,
}

local function SyncActionToState()
    State.ActionBusy = ActiveAction.Name ~= nil
    State.MovementLock = ActiveAction.Name ~= nil and ActiveAction.LockMovement
end

local function ForceEndAllActions()
    if ActiveAction.Name == "Flank" then
        UnbindFlankCamera()
    end

    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = nil
    ActiveAction.Priority = ActionPriority.NONE
    ActiveAction.StartTime = 0
    ActiveAction.EndTime = 0
    ActiveAction.LockMovement = false

    SyncActionToState()
end

local function EndAction(name)
    if ActiveAction.Name == name then
        if name == "Flank" then
            UnbindFlankCamera()
        end

        ActiveAction.Id = ActiveAction.Id + 1
        ActiveAction.Name = nil
        ActiveAction.Priority = ActionPriority.NONE
        ActiveAction.StartTime = 0
        ActiveAction.EndTime = 0
        ActiveAction.LockMovement = false

        SyncActionToState()
    end
end

local function UpdateAction()
    if ActiveAction.Name and time() >= ActiveAction.EndTime then
        ForceEndAllActions()
    end

    SyncActionToState()
end

local function CanStartAction(name, priority)
    if not ActiveAction.Name then
        return true
    end

    if ActiveAction.Name == name then
        return true
    end

    return priority > ActiveAction.Priority
end

local function BeginAction(name, duration, priority, lockMovement)
    UpdateAction()

    if not CanStartAction(name, priority) then
        return false, 0
    end

    local oldName = ActiveAction.Name

    if oldName == "Flank" and name ~= "Flank" then
        UnbindFlankCamera()
    end

    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = name
    ActiveAction.Priority = priority
    ActiveAction.StartTime = time()
    ActiveAction.EndTime = time() + duration
    ActiveAction.LockMovement = lockMovement == true

    SyncActionToState()

    return true, ActiveAction.Id
end

-- // UTILITIES // --
local function IsAlive(char)
    if not char or not char.Parent then
        return false
    end

    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    return hum and root and hum.Health > 0
end

local function PressKey(key, hold)
    if not IsAlive(LocalPlayer.Character) then
        return
    end

    hold = hold or (0.05 + math.random() * 0.03)

    VirtualInputManager:SendKeyEvent(true, key, false, game)

    Schedule(hold + 0.03, function()
        if IsAlive(LocalPlayer.Character) then
            VirtualInputManager:SendKeyEvent(false, key, false, game)
        end
    end)
end

local function ClickM1()
    if not IsAlive(LocalPlayer.Character) then
        return
    end

    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)

    Schedule(0.05 + math.random() * 0.02, function()
        if IsAlive(LocalPlayer.Character) then
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        end
    end)
end

local function IsSkillReady(key)
    local info = SETTINGS.Skills[key]
    if not info then
        return false
    end

    if time() - State.LastSkillUse < SETTINGS.SkillGlobalCD then
        return false
    end

    return (time() - State.SkillTimers[key]) > (info.CD + math.random() * 0.5)
end

local function RegisterSkill(key)
    State.SkillTimers[key] = time()
    State.LastSkillUse = time()
end

local function IsIncapacitated(char)
    if not IsAlive(char) then
        return false
    end

    if char:GetAttribute("Ragdoll") == true then
        return true
    end

    if char:GetAttribute("Stunned") == true then
        return true
    end

    if char:GetAttribute("Knocked") == true then
        return true
    end

    if char:GetAttribute("Incapacitated") == true then
        return true
    end

    if SETTINGS.StrictIncapacitated then
        return false
    end

    local hum = char:FindFirstChild("Humanoid")
    if not hum then
        return false
    end

    local state = hum:GetState()

    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.FallingDown
end

-- // ENEMY ANALYSIS CACHE // --
local EnemyCache = {
    lastAnimScan = 0,
    blocking = false,
    attacking = false,

    lastAwakenScan = 0,
    awakened = false,
}

local function ResetEnemyCache()
    EnemyCache.lastAnimScan = 0
    EnemyCache.blocking = false
    EnemyCache.attacking = false
    EnemyCache.lastAwakenScan = 0
    EnemyCache.awakened = false
end

local function IsEnemyAwakened(char)
    if char:GetAttribute("Awakened") == true then
        return true
    end

    if char:GetAttribute("Awake") == true then
        return true
    end

    if char:GetAttribute("Domain") == true then
        return true
    end

    if char:GetAttribute("Transformation") == true then
        return true
    end

    local vfx = char:FindFirstChild("VFX")
        or char:FindFirstChild("Effects")
        or char:FindFirstChild("Particles")

    if vfx then
        for _, d in pairs(vfx:GetChildren()) do
            local n = d.Name:lower()

            if n:find("awaken") or n:find("domain") then
                return true
            end
        end
    end

    return false
end

local function UpdateEnemyCache(target)
    if not target then
        return
    end

    local now = time()

    if now - EnemyCache.lastAwakenScan > 0.5 then
        EnemyCache.lastAwakenScan = now
        EnemyCache.awakened = IsEnemyAwakened(target)
    end

    if now - EnemyCache.lastAnimScan < 0.12 then
        return
    end

    EnemyCache.lastAnimScan = now
    EnemyCache.blocking = false
    EnemyCache.attacking = false

    if target:GetAttribute("Blocking") == true then
        EnemyCache.blocking = true
    end

    if target:GetAttribute("Attacking") == true then
        EnemyCache.attacking = true
    end

    if target:GetAttribute("M1") == true then
        EnemyCache.attacking = true
    end

    local hum = target:FindFirstChild("Humanoid")
    if not hum then
        return
    end

    local animator = hum:FindFirstChild("Animator")
    if not animator then
        return
    end

    local success, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)

    if not success then
        return
    end

    for _, t in pairs(tracks) do
        if t.IsPlaying and t.Animation and t.Animation.Name then
            local n = t.Animation.Name:lower()

            if t.Priority == Enum.AnimationPriority.Action then
                if n:find("block") or n:find("guard") or n:find("defend") then
                    EnemyCache.blocking = true
                elseif n:find("swing")
                    or n:find("punch")
                    or n:find("kick")
                    or n:find("slash")
                    or n:find("hit")
                    or n:find("m1")
                    or n:find("attack")
                    or n:find("combo")
                then
                    EnemyCache.attacking = true
                end
            end
        end
    end
end

-- // TARGET HELPERS // --
local function PredictTargetPosition(tRoot, distance)
    local vel = tRoot.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
    local reaction = 0.12 + (distance / 180)

    return tRoot.Position + vel * reaction
end

local function AimAt(pos)
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        return
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        return
    end

    local lookPos = Vector3.new(pos.X, myRoot.Position.Y, pos.Z)
    local dir = lookPos - myRoot.Position

    if dir.Magnitude > 0.001 then
        local safeCFrame = CFrame.lookAt(myRoot.Position, myRoot.Position + dir.Unit)
        myRoot.CFrame = safeCFrame
    end
end

local function CanSeeCharacter(myChar, myRoot, target, targetRoot)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}

    local rayStart = myRoot.Position + Vector3.new(0, 2, 0)
    local rayEnd = targetRoot.Position + Vector3.new(0, 2, 0)

    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(target)
end

local function FindTarget()
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then
        LogDebug("FindTarget: myChar not alive")
        return nil
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then
        LogDebug("FindTarget: no myRoot")
        return nil
    end

    local myPos = myRoot.Position
    local bestTarget = nil
    local bestScore = -math.huge

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tChar = p.Character
            local tRoot = tChar:FindFirstChild("HumanoidRootPart")
            local hum = tChar:FindFirstChild("Humanoid")

            if tRoot and hum and hum.Health > 0 then
                local delta = tRoot.Position - myPos
                local dist = delta.Magnitude

                if dist > 0.1 and dist <= SETTINGS.AggroRange then
                    local rayStart = myPos + Vector3.new(0, 2, 0)
                    local rayEnd = tRoot.Position + Vector3.new(0, 2, 0)

                    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)

                    local canSee = false

                    if not result then
                        canSee = true
                    elseif result.Instance:IsDescendantOf(tChar) then
                        canSee = true
                    end

                    -- Аккуратный fallback для очень близких целей
                    if not canSee and dist < 10 then
                        canSee = true
                    end

                    if canSee then
                        local healthRatio = hum.Health / hum.MaxHealth

                        local threat = 1000
                        threat = threat - (dist * 1.8)
                        threat = threat - (healthRatio * 250)

                        if threat > bestScore then
                            bestScore = threat
                            bestTarget = tChar
                        end
                    end
                end
            end
        end
    end

    if bestTarget then
        LogDebug("FindTarget: target found")
    else
        LogDebug("FindTarget: no target")
    end

    return bestTarget
end

local function GetReadySkill(preferBreaker)
    for key, info in pairs(SETTINGS.Skills) do
        if info.Breaker == (preferBreaker == true) and IsSkillReady(key) then
            return key
        end
    end

    if preferBreaker then
        for key, info in pairs(SETTINGS.Skills) do
            if not info.Breaker and IsSkillReady(key) then
                return key
            end
        end
    end

    return nil
end

-- ======================================================
-- ADVANCED MOVEMENT CONTROLLER
-- ======================================================

local MovementState = {
    CurrentPath = nil,
    PathWaypoints = {},
    CurrentWaypointIndex = 0,
    LastPathCompute = 0,
    LastMoveTo = 0,
    StuckFrames = 0,
    LastPosition = Vector3.new(0, 0, 0),
    OrbitAngle = 0,
    OrbitDirection = 1,
    LastOrbitSwitch = 0,
    AvoidanceDir = nil,
    AvoidanceUntil = 0,
}

local function ComputePathSafe(startPos, endPos)
    local ok, path = pcall(function()
        local p = PathfindingService:CreatePath({
            AgentRadius = SETTINGS.Movement.AgentRadius,
            AgentHeight = SETTINGS.Movement.AgentHeight,
            AgentCanJump = SETTINGS.Movement.AgentCanJump,
        })

        p:ComputeAsync(startPos, endPos)

        return p
    end)

    if ok and path and path.Status == Enum.PathStatus.Success then
        return path
    end

    return nil
end

local function IsEdgeAhead(myRoot, direction)
    if not SETTINGS.Movement.CheckEdges then
        return false
    end

    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.001 then
        return false
    end

    direction = direction.Unit

    local rayStart = myRoot.Position + Vector3.new(0, 0.5, 0)
    local rayEnd = rayStart + direction * SETTINGS.Movement.EdgeRayDistance

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}

    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)

    if not result then
        return true
    end

    local heightDiff = myRoot.Position.Y - result.Position.Y

    return heightDiff > SETTINGS.Movement.EdgeHeightLimit
end

local function IsObstacleAhead(myRoot, direction, distance)
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.001 then
        return false, false
    end

    direction = direction.Unit

    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local rayEnd = rayStart + direction * distance

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}

    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)

    if result then
        local heightDiff = result.Position.Y - myRoot.Position.Y

        if heightDiff < 3.5 then
            return true, true
        end

        return true, false
    end

    return false, false
end

local function FindAvoidanceDirection(myRoot, targetPos)
    local forward = targetPos - myRoot.Position
    forward = Vector3.new(forward.X, 0, forward.Z)

    if forward.Magnitude < 0.1 then
        forward = Vector3.new(1, 0, 0)
    else
        forward = forward.Unit
    end

    local right = Vector3.new(0, 1, 0):Cross(forward).Unit
    local left = -right

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}

    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local checkDist = SETTINGS.Movement.StuckRayDistance

    local forwardRay = Workspace:Raycast(rayStart, forward * checkDist, params)
    local rightRay = Workspace:Raycast(rayStart, right * checkDist, params)
    local leftRay = Workspace:Raycast(rayStart, left * checkDist, params)

    if not forwardRay then
        return forward
    end

    local rightClear = not rightRay
    local leftClear = not leftRay

    if rightClear and leftClear then
        return math.random() > 0.5 and right or left
    elseif rightClear then
        return right
    elseif leftClear then
        return left
    end

    return forward
end

local function UpdatePath(myRoot, targetPos)
    local now = time()

    if now - MovementState.LastPathCompute < SETTINGS.Movement.PathRecomputeDelay then
        return
    end

    local dist = (targetPos - myRoot.Position).Magnitude

    if dist < SETTINGS.Movement.DirectMoveRange then
        MovementState.CurrentPath = nil
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return
    end

    if dist > SETTINGS.Movement.PathfindingRange and SETTINGS.Movement.UsePathfinding then
        local path = ComputePathSafe(myRoot.Position, targetPos)

        if path then
            MovementState.CurrentPath = path
            MovementState.PathWaypoints = path:GetWaypoints()
            MovementState.CurrentWaypointIndex = 2
            MovementState.LastPathCompute = now
        else
            MovementState.CurrentPath = nil
            MovementState.PathWaypoints = {}
            MovementState.CurrentWaypointIndex = 0
        end
    end
end

local function FollowPath(hum, myRoot)
    if not MovementState.PathWaypoints or #MovementState.PathWaypoints == 0 then
        return false
    end

    local idx = MovementState.CurrentWaypointIndex

    if idx > #MovementState.PathWaypoints then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end

    local waypoint = MovementState.PathWaypoints[idx]
    local waypointPos = waypoint.Position

    local distToWaypoint = (waypointPos - myRoot.Position).Magnitude

    if distToWaypoint < 4 then
        MovementState.CurrentWaypointIndex = idx + 1
        return true
    end

    if waypoint.Action == Enum.PathWaypointAction.Jump then
        hum.Jump = true
    end

    local direction = waypointPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.1 then
        return true
    end

    direction = direction.Unit

    if IsEdgeAhead(myRoot, direction) then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end

    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)

    if hasObstacle and canJump then
        hum.Jump = true
    end

    local now = time()

    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(waypointPos)
    end

    return true
end

local function HandleAntiStuck(hum, myRoot, targetPos)
    local currentPos = myRoot.Position
    local movement = (currentPos - MovementState.LastPosition).Magnitude

    if movement < SETTINGS.Movement.StuckThreshold then
        MovementState.StuckFrames = MovementState.StuckFrames + 1
    else
        MovementState.StuckFrames = 0
        MovementState.AvoidanceDir = nil
    end

    MovementState.LastPosition = currentPos

    if MovementState.StuckFrames >= SETTINGS.Movement.StuckFrames then
        MovementState.StuckFrames = 0

        local avoidDir = FindAvoidanceDirection(myRoot, targetPos)

        if not IsEdgeAhead(myRoot, avoidDir) then
            MovementState.AvoidanceDir = avoidDir
            MovementState.AvoidanceUntil = time() + 0.5

            local hasObstacle, canJump = IsObstacleAhead(myRoot, avoidDir, 5)

            if hasObstacle and canJump then
                hum.Jump = true
            end

            local avoidTarget = myRoot.Position + avoidDir * 8

            local now = time()

            if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
                MovementState.LastMoveTo = now
                hum:MoveTo(avoidTarget)
            end

            MovementState.PathWaypoints = {}
            MovementState.CurrentWaypointIndex = 0
        else
            hum.Jump = true
        end

        return true
    end

    if MovementState.AvoidanceDir and time() < MovementState.AvoidanceUntil then
        local avoidTarget = myRoot.Position + MovementState.AvoidanceDir * 8

        local now = time()

        if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
            MovementState.LastMoveTo = now
            hum:MoveTo(avoidTarget)
        end

        return true
    end

    return false
end

local function GetOrbitPosition(myRoot, tRoot, dist)
    if not SETTINGS.Movement.SmoothOrbit then
        return tRoot.Position
    end

    local now = time()

    if now - MovementState.LastOrbitSwitch > 2.5 + math.random() * 2 then
        MovementState.LastOrbitSwitch = now
        MovementState.OrbitDirection = -MovementState.OrbitDirection
    end

    MovementState.OrbitAngle = MovementState.OrbitAngle
        + SETTINGS.Movement.OrbitSpeed * MovementState.OrbitDirection * 0.016

    local jitter = (math.random() - 0.5) * SETTINGS.Movement.OrbitJitter

    local radius = math.clamp(
        SETTINGS.OrbitRadius + jitter,
        SETTINGS.Movement.OrbitMinDist,
        SETTINGS.Movement.OrbitMaxDist
    )

    local offsetX = math.cos(MovementState.OrbitAngle) * radius
    local offsetZ = math.sin(MovementState.OrbitAngle) * radius

    return tRoot.Position + Vector3.new(offsetX, 0, offsetZ)
end

local function AdvancedMoveTo(hum, myRoot, tRoot, targetPos, dist)
    if HandleAntiStuck(hum, myRoot, targetPos) then
        return
    end

    UpdatePath(myRoot, targetPos)

    if #MovementState.PathWaypoints > 0 then
        if FollowPath(hum, myRoot) then
            return
        end
    end

    local direction = targetPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude < 0.5 then
        return
    end

    direction = direction.Unit

    if IsEdgeAhead(myRoot, direction) then
        return
    end

    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)

    if hasObstacle and canJump then
        hum.Jump = true
    end

    local now = time()

    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(targetPos)
    end
end

