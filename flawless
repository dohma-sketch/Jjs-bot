-- // INPUT // --

local function InputAvailable()
    return VIM ~= nil
end

local function SendKeyRaw(key, isDown)
    if not VIM then return end
    local resolved = ResolveKeyCode(key)
    if not resolved then return end
    pcall(function()
        VIM:SendKeyEvent(isDown, resolved, false, game)
    end)
end

local function SendMouseRaw(isDown)
    if not VIM then return end
    local x, y = 0, 0
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam and cam.ViewportSize then
            x = cam.ViewportSize.X / 2
            y = cam.ViewportSize.Y / 2
        end
    end)
    pcall(function()
        VIM:SendMouseButtonEvent(x, y, SETTINGS.M1MouseButton, isDown, game, 1)
    end)
end

local function PressKey(key, hold)
    if not InputAvailable() then return end
    if not IsAlive(LocalPlayer.Character) then return end
    hold = hold or (0.05 + math.random() * 0.03)
    SendKeyRaw(key, true)
    Schedule(hold + 0.03, function()
        if IsAlive(LocalPlayer.Character) then
            SendKeyRaw(key, false)
        end
    end)
end

local function ClickM1()
    if not InputAvailable() then return end
    if not IsAlive(LocalPlayer.Character) then return end
    SendMouseRaw(true)
    Schedule(0.05 + math.random() * 0.02, function()
        if IsAlive(LocalPlayer.Character) then
            SendMouseRaw(false)
        end
    end)
end

-- // UTILITIES // --

local function GetRootPart(char)
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then return root end
    local ok, primary = pcall(function() return char.PrimaryPart end)
    if ok and primary then return primary end
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function IsAlive(char)
    if not char or not char.Parent then return false end
    local hum = char:FindFirstChild("Humanoid")
    local root = GetRootPart(char)
    if not hum or not root then return false end
    if not hum:IsA("Humanoid") then return false end
    return hum.Health > 0
end

local function GetBoolAttr(obj, name)
    if not obj then return false end
    local ok, value = pcall(function() return obj:GetAttribute(name) end)
    return ok and value == true
end

local function IsIncapacitated(char)
    if not IsAlive(char) then return false end
    if GetBoolAttr(char, "Ragdoll") then return true end
    if GetBoolAttr(char, "Stunned") then return true end
    if GetBoolAttr(char, "Knocked") then return true end
    if GetBoolAttr(char, "Incapacitated") then return false end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end
    local state = hum:GetState()
    return state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.PlatformStanding
        or state == Enum.HumanoidStateType.FallingDown
end

-- // JJS SPECIFIC: Block Angle Check // --

local function IsInFrontOfEnemy(myRoot, tRoot)
    local toMe = myRoot.Position - tRoot.Position
    if toMe.Magnitude < 0.001 then return false end
    toMe = toMe.Unit
    local enemyLook = tRoot.CFrame.LookVector
    local dot = enemyLook:Dot(toMe)
    return dot > 0
end

local function IsBehindEnemy(myRoot, tRoot)
    local toMe = myRoot.Position - tRoot.Position
    if toMe.Magnitude < 0.001 then return false end
    toMe = toMe.Unit
    local enemyLook = tRoot.CFrame.LookVector
    return enemyLook:Dot(toMe) < -0.3
end

-- // JJS SPECIFIC: Dash Type Detection // --

local function GetDashType(myRoot)
    local moveDir = myRoot.CFrame.LookVector
    local forward = myRoot.CFrame.LookVector
    local dot = forward:Dot(moveDir)
    if dot > 0.7 then
        return "forward"
    end
    return "side"
end

local function IsDashReady(dashType)
    if dashType == "forward" then
        return time() - State.LastForwardDash >= SETTINGS.ForwardDashCD
    end
    return time() - State.LastSideDash >= SETTINGS.SideDashCD
end

local function RegisterDash(dashType)
    if dashType == "forward" then
        State.LastForwardDash = time()
    else
        State.LastSideDash = time()
    end
end

-- // JJS SPECIFIC: Counter Detection // --

local function IsEnemyCountering(target)
    if not target then return false end
    if GetBoolAttr(target, "CounterReady") then return true end
    if GetBoolAttr(target, "CounterStance") then return true end
    if GetBoolAttr(target, "Countering") then return true end

    local hum = target:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return false end
    local animator = hum:FindFirstChild("Animator")
    if not animator or not animator:IsA("Animator") then return false end

    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if not ok then return false end

    for _, t in pairs(tracks) do
        if t.IsPlaying and t.Animation and t.Animation.Name then
            local n = string.lower(t.Animation.Name)
            if string.find(n, "counter")
                or string.find(n, "parry")
                or string.find(n, "reflect")
                or string.find(n, "stance")
            then
                return true
            end
        end
    end

    return false
end

-- // ENEMY CACHE // --

local EnemyCache = {
    lastAnimScan = 0,
    blocking = false,
    attacking = false,
    countering = false,
    lastAwakenScan = 0,
    awakened = false,
}

local function ResetEnemyCache()
    EnemyCache.lastAnimScan = 0
    EnemyCache.blocking = false
    EnemyCache.attacking = false
    EnemyCache.countering = false
    EnemyCache.lastAwakenScan = 0
    EnemyCache.awakened = false
end

local function IsEnemyAwakened(char)
    if GetBoolAttr(char, "Awakened") then return true end
    if GetBoolAttr(char, "Awake") then return true end
    if GetBoolAttr(char, "Domain") then return true end
    if GetBoolAttr(char, "Transformation") then return true end
    local vfx = char:FindFirstChild("VFX")
        or char:FindFirstChild("Effects")
        or char:FindFirstChild("Particles")
    if vfx then
        for _, d in pairs(vfx:GetChildren()) do
            local n = string.lower(d.Name)
            if string.find(n, "awaken") or string.find(n, "domain") then
                return true
            end
        end
    end
    return false
end

local function UpdateEnemyCache(target)
    if not target then return end
    local now = time()

    if now - EnemyCache.lastAwakenScan > 0.5 then
        EnemyCache.lastAwakenScan = now
        EnemyCache.awakened = IsEnemyAwakened(target)
    end

    EnemyCache.countering = IsEnemyCountering(target)

    if now - EnemyCache.lastAnimScan < 0.12 then return end
    EnemyCache.lastAnimScan = now
    EnemyCache.blocking = false
    EnemyCache.attacking = false

    if GetBoolAttr(target, "Blocking") then EnemyCache.blocking = true end
    if GetBoolAttr(target, "Attacking") then EnemyCache.attacking = true end
    if GetBoolAttr(target, "M1") then EnemyCache.attacking = true end

    local hum = target:FindFirstChild("Humanoid")
    if not hum or not hum:IsA("Humanoid") then return end
    local animator = hum:FindFirstChild("Animator")
    if not animator or not animator:IsA("Animator") then return end

    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if not ok then return end

    for _, t in pairs(tracks) do
        if t.IsPlaying and t.Animation and t.Animation.Name then
            local n = string.lower(t.Animation.Name)
            if t.Priority == Enum.AnimationPriority.Action then
                if string.find(n, "block") or string.find(n, "guard") or string.find(n, "defend") then
                    EnemyCache.blocking = true
                elseif string.find(n, "swing") or string.find(n, "punch")
                    or string.find(n, "kick") or string.find(n, "slash")
                    or string.find(n, "hit") or string.find(n, "m1")
                    or string.find(n, "attack") or string.find(n, "combo")
                then
                    EnemyCache.attacking = true
                end
            end
        end
    end
end

-- // ACTION MANAGER // --

local ActionPriority = {
    NONE = 0, MOVEMENT = 10, OFFENSE = 30, FLANK = 50,
    BLOCK_BREAK = 60, DEFENSE = 80, KITE = 90, SURVIVAL = 100,
}

local ActiveAction = {
    Id = 0, Name = nil, Priority = ActionPriority.NONE,
    StartTime = 0, EndTime = 0, LockMovement = false,
}

local function SyncActionToState()
    State.ActionBusy = ActiveAction.Name ~= nil
    State.MovementLock = ActiveAction.Name ~= nil and ActiveAction.LockMovement
end

local function ForceEndAllActions()
    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = nil
    ActiveAction.Priority = ActionPriority.NONE
    ActiveAction.StartTime = 0
    ActiveAction.EndTime = 0
    ActiveAction.LockMovement = false
    SyncActionToState()
end

local function EndAction(name)
    if ActiveAction.Name == name then
        ActiveAction.Id = ActiveAction.Id + 1
        ActiveAction.Name = nil
        ActiveAction.Priority = ActionPriority.NONE
        ActiveAction.StartTime = 0
        ActiveAction.EndTime = 0
        ActiveAction.LockMovement = false
        SyncActionToState()
    end
end

local function UpdateAction()
    if ActiveAction.Name and time() >= ActiveAction.EndTime then
        ForceEndAllActions()
    end
    SyncActionToState()
end

local function CanStartAction(name, priority)
    if not ActiveAction.Name then return true end
    if ActiveAction.Name == name then return true end
    return priority > ActiveAction.Priority
end

local function BeginAction(name, duration, priority, lockMovement)
    UpdateAction()
    if not CanStartAction(name, priority) then return false, 0 end
    ActiveAction.Id = ActiveAction.Id + 1
    ActiveAction.Name = name
    ActiveAction.Priority = priority
    ActiveAction.StartTime = time()
    ActiveAction.EndTime = time() + duration
    ActiveAction.LockMovement = lockMovement == true
    SyncActionToState()
    return true, ActiveAction.Id
end

-- // SKILL SYSTEM // --

local function IsSkillReady(key)
    local info = SETTINGS.Skills[key]
    if not info then return false end
    if time() - State.LastSkillUse < SETTINGS.SkillGlobalCD then return false end
    return time() >= (State.SkillReadyAt[key] or 0)
end

local function RegisterSkill(key)
    local info = SETTINGS.Skills[key]
    local now = time()
    State.SkillTimers[key] = now
    State.LastSkillUse = now
    State.SkillReadyAt[key] = now + info.CD + math.random() * 0.5
end

local function GetReadySkill(preferBreaker)
    for key, info in pairs(SETTINGS.Skills) do
        if info.Breaker == (preferBreaker == true) and IsSkillReady(key) then
            return key
        end
    end
    if preferBreaker then
        for key, info in pairs(SETTINGS.Skills) do
            if not info.Breaker and IsSkillReady(key) then
                return key
            end
        end
    end
    return nil
end

-- // TARGETING // --

local function PredictTargetPosition(tRoot, distance)
    local vel = Vector3.new(0, 0, 0)
    pcall(function()
        vel = tRoot.AssemblyLinearVelocity or tRoot.Velocity or Vector3.new(0, 0, 0)
    end)
    local reaction = 0.12 + (distance / 180)
    if reaction > 0.65 then reaction = 0.65 end
    return tRoot.Position + vel * reaction
end

local function AimAt(pos)
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return end
    local myRoot = GetRootPart(myChar)
    if not myRoot then return end
    local lookPos = Vector3.new(pos.X, myRoot.Position.Y, pos.Z)
    local dir = lookPos - myRoot.Position
    if dir.Magnitude > 0.001 then
        local goal = MakeLookCFrame(myRoot.Position, myRoot.Position + dir.Unit)
        if SETTINGS.UseSmoothAim then
            local alpha = clamp(SETTINGS.AimSmooth, 0.05, 1)
            myRoot.CFrame = SafeCFrameLerp(myRoot.CFrame, goal, alpha)
        else
            myRoot.CFrame = goal
        end
    end
end

local function CanSeeCharacter(myChar, myRoot, target, targetRoot)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}
    local rayStart = myRoot.Position + Vector3.new(0, 2, 0)
    local rayEnd = targetRoot.Position + Vector3.new(0, 2, 0)
    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(target)
end

local function GetTargetCandidates()
    local candidates = {}
    local seen = {}
    local playerChars = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then playerChars[plr.Character] = plr end
    end
    if SETTINGS.TargetPlayers then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local allowed = true
                if SETTINGS.IgnoreSameTeam and plr.Team and LocalPlayer.Team
                    and plr.Team == LocalPlayer.Team then
                    allowed = false
                end
                if allowed and not seen[plr.Character] then
                    seen[plr.Character] = true
                    candidates[#candidates + 1] = plr.Character
                end
            end
        end
    end
    if SETTINGS.TargetNPCs then
        for _, folderName in pairs(SETTINGS.NPCFolders) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, obj in pairs(folder:GetChildren()) do
                    if obj:IsA("Model") and not playerChars[obj] and not seen[obj] then
                        seen[obj] = true
                        candidates[#candidates + 1] = obj
                    end
                end
            end
        end
        if SETTINGS.ScanWorkspaceModels then
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj:IsA("Model") and not playerChars[obj] and not seen[obj] then
                    seen[obj] = true
                    candidates[#candidates + 1] = obj
                end
            end
        end
    end
    return candidates
end

local function FindTarget()
    local myChar = LocalPlayer.Character
    if not IsAlive(myChar) then return nil end
    local myRoot = GetRootPart(myChar)
    if not myRoot then return nil end
    local myPos = myRoot.Position
    local bestTarget = nil
    local bestScore = -math.huge
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myChar}
    local candidates = GetTargetCandidates()
    for _, tChar in pairs(candidates) do
        local tRoot = GetRootPart(tChar)
        local hum = tChar:FindFirstChild("Humanoid")
        if tRoot and hum and hum:IsA("Humanoid") then
            if hum.Health > 0 and hum.MaxHealth > 0 then
                local delta = tRoot.Position - myPos
                local dist = delta.Magnitude
                if dist > 0.1 and dist <= SETTINGS.AggroRange then
                    local rayStart = myPos + Vector3.new(0, 2, 0)
                    local rayEnd = tRoot.Position + Vector3.new(0, 2, 0)
                    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)
                    local canSee = false
                    if not result then canSee = true
                    elseif result.Instance:IsDescendantOf(tChar) then canSee = true end
                    if not canSee and dist < 10 and SETTINGS.AllowCloseWallTarget then
                        canSee = true
                    end
                    if canSee then
                        local healthRatio = hum.Health / hum.MaxHealth
                        local threat = 1000 - (dist * 1.8) - (healthRatio * 250)
                        if threat > bestScore then
                            bestScore = threat
                            bestTarget = tChar
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

-- // MOVEMENT // --

local MovementState = {
    CurrentPath = nil, PathWaypoints = {}, CurrentWaypointIndex = 0,
    LastPathCompute = 0, LastMoveTo = 0, StuckFrames = 0,
    LastPosition = Vector3.new(0, 0, 0), OrbitAngle = 0,
    OrbitDirection = 1, NextOrbitSwitch = 0, AvoidanceDir = nil,
    AvoidanceUntil = 0, LastDelta = 0.016,
}

local function ComputePathSafe(startPos, endPos)
    local ok, path = pcall(function()
        local p = PathfindingService:CreatePath({
            AgentRadius = SETTINGS.Movement.AgentRadius,
            AgentHeight = SETTINGS.Movement.AgentHeight,
            AgentCanJump = SETTINGS.Movement.AgentCanJump,
        })
        p:ComputeAsync(startPos, endPos)
        return p
    end)
    if ok and path and path.Status == Enum.PathStatus.Success then return path end
    return nil
end

local function IsEdgeAhead(myRoot, direction)
    if not SETTINGS.Movement.CheckEdges then return false end
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.001 then return false end
    direction = direction.Unit
    local aheadPos = myRoot.Position + direction * SETTINGS.Movement.EdgeRayDistance
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}
    local rayOrigin = aheadPos + Vector3.new(0, 2, 0)
    local rayDirection = Vector3.new(0, -(SETTINGS.Movement.EdgeHeightLimit + 8), 0)
    local result = Workspace:Raycast(rayOrigin, rayDirection, params)
    if not result then return true end
    return (myRoot.Position.Y - result.Position.Y) > SETTINGS.Movement.EdgeHeightLimit
end

local function IsObstacleAhead(myRoot, direction, distance)
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.001 then return false, false end
    direction = direction.Unit
    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local rayEnd = rayStart + direction * distance
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}
    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)
    if result then
        local heightDiff = result.Position.Y - myRoot.Position.Y
        if heightDiff < 3.5 then return true, true end
        return true, false
    end
    return false, false
end

local function FindAvoidanceDirection(myRoot, targetPos)
    local forward = targetPos - myRoot.Position
    forward = Vector3.new(forward.X, 0, forward.Z)
    if forward.Magnitude < 0.1 then forward = Vector3.new(1, 0, 0) else forward = forward.Unit end
    local right = Vector3.new(0, 1, 0):Cross(forward).Unit
    local left = -right
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}
    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local checkDist = SETTINGS.Movement.StuckRayDistance
    local forwardRay = Workspace:Raycast(rayStart, forward * checkDist, params)
    local rightRay = Workspace:Raycast(rayStart, right * checkDist, params)
    local leftRay = Workspace:Raycast(rayStart, left * checkDist, params)
    if not forwardRay then return forward end
    if not rightRay and not leftRay then return math.random() > 0.5 and right or left
    elseif not rightRay then return right
    elseif not leftRay then return left end
    return forward
end

local PathfindingBusy = false

local function UpdatePath(myRoot, targetPos)
    local now = time()
    if now - MovementState.LastPathCompute < SETTINGS.Movement.PathRecomputeDelay then return end
    local dist = (targetPos - myRoot.Position).Magnitude
    if dist < SETTINGS.Movement.DirectMoveRange then
        MovementState.CurrentPath = nil
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return
    end
    if dist > SETTINGS.Movement.PathfindingRange and SETTINGS.Movement.UsePathfinding and not PathfindingBusy then
        PathfindingBusy = true
        local char = myRoot.Parent
        local startPos = myRoot.Position
        coroutine.wrap(function()
            local path = ComputePathSafe(startPos, targetPos)
            PathfindingBusy = false
            if not char or not char.Parent then return end
            if path then
                MovementState.CurrentPath = path
                MovementState.PathWaypoints = path:GetWaypoints()
                MovementState.CurrentWaypointIndex = 2
                MovementState.LastPathCompute = time()
            else
                MovementState.CurrentPath = nil
                MovementState.PathWaypoints = {}
                MovementState.CurrentWaypointIndex = 0
            end
        end)()
    end
end

local function FollowPath(hum, myRoot)
    if not MovementState.PathWaypoints or #MovementState.PathWaypoints == 0 then return false end
    local idx = MovementState.CurrentWaypointIndex
    if idx > #MovementState.PathWaypoints then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end
    local waypoint = MovementState.PathWaypoints[idx]
    local waypointPos = waypoint.Position
    if (waypointPos - myRoot.Position).Magnitude < 4 then
        MovementState.CurrentWaypointIndex = idx + 1
        return true
    end
    if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
    local direction = waypointPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.1 then return true end
    direction = direction.Unit
    if IsEdgeAhead(myRoot, direction) then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end
    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)
    if hasObstacle and canJump then hum.Jump = true end
    local now = time()
    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(waypointPos)
    end
    return true
end

local function HandleAntiStuck(hum, myRoot, targetPos)
    local currentPos = myRoot.Position
    local movement = (currentPos - MovementState.LastPosition).Magnitude
    local expectedMin = SETTINGS.Movement.StuckThreshold * (MovementState.LastDelta or 0.016) * 60
    if movement < expectedMin then MovementState.StuckFrames = MovementState.StuckFrames + 1
    else MovementState.StuckFrames = 0 MovementState.AvoidanceDir = nil end
    MovementState.LastPosition = currentPos
    if MovementState.StuckFrames >= SETTINGS.Movement.StuckFrames then
        MovementState.StuckFrames = 0
        local avoidDir = FindAvoidanceDirection(myRoot, targetPos)
        if not IsEdgeAhead(myRoot, avoidDir) then
            MovementState.AvoidanceDir = avoidDir
            MovementState.AvoidanceUntil = time() + 0.5
            local hasObstacle, canJump = IsObstacleAhead(myRoot, avoidDir, 5)
            if hasObstacle and canJump then hum.Jump = true end
            local avoidTarget = myRoot.Position + avoidDir * 8
            local now = time()
            if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
                MovementState.LastMoveTo = now
                hum:MoveTo(avoidTarget)
            end
            MovementState.PathWaypoints = {}
            MovementState.CurrentWaypointIndex = 0
        else
            hum.Jump = true
        end
        return true
    end
    if MovementState.AvoidanceDir and time() < MovementState.AvoidanceUntil then
        local avoidTarget = myRoot.Position + MovementState.AvoidanceDir * 8
        local now = time()
        if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
            MovementState.LastMoveTo = now
            hum:MoveTo(avoidTarget)
        end
        return true
    end
    return false
end

local function GetOrbitPosition(myRoot, tRoot, dist)
    if not SETTINGS.Movement.SmoothOrbit then return tRoot.Position end
    local now = time()
    if MovementState.NextOrbitSwitch == 0 then
        MovementState.NextOrbitSwitch = now + 2.5 + math.random() * 2
    end
    if now >= MovementState.NextOrbitSwitch then
        MovementState.OrbitDirection = -MovementState.OrbitDirection
        MovementState.NextOrbitSwitch = now + 2.5 + math.random() * 2
    end
    MovementState.OrbitAngle = MovementState.OrbitAngle
        + SETTINGS.Movement.OrbitSpeed * MovementState.OrbitDirection * (MovementState.LastDelta or 0.016)
    local jitter = (math.random() - 0.5) * SETTINGS.Movement.OrbitJitter
    local radius = clamp(SETTINGS.OrbitRadius + jitter, SETTINGS.Movement.OrbitMinDist, SETTINGS.Movement.OrbitMaxDist)
    local offsetX = math.cos(MovementState.OrbitAngle) * radius
    local offsetZ = math.sin(MovementState.OrbitAngle) * radius
    return tRoot.Position + Vector3.new(offsetX, 0, offsetZ)
end

local function AdvancedMoveTo(hum, myRoot, tRoot, targetPos, dist)
    if HandleAntiStuck(hum, myRoot, targetPos) then return end
    UpdatePath(myRoot, targetPos)
    if #MovementState.PathWaypoints > 0 then
        if FollowPath(hum, myRoot) then return end
    end
    local direction = targetPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.5 then return end
    direction = direction.Unit
    if IsEdgeAhead(myRoot, direction) then return end
    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)
    if hasObstacle and canJump then hum.Jump = true end
    local now = time()
    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(targetPos)
    end
end

