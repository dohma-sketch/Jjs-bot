    CurrentPath = nil,
    PathWaypoints = {},
    CurrentWaypointIndex = 0,
    LastPathCompute = 0,
    LastMoveTo = 0,
    StuckFrames = 0,
    LastPosition = Vector3.new(0, 0, 0),
    OrbitAngle = 0,
    OrbitDirection = 1,
    NextOrbitSwitch = 0,
    AvoidanceDir = nil,
    AvoidanceUntil = 0,
    LastDelta = 0.016,
}

local function ComputePathSafe(startPos, endPos)
    local ok, path = pcall(function()
        local p = PathfindingService:CreatePath({
            AgentRadius = SETTINGS.Movement.AgentRadius,
            AgentHeight = SETTINGS.Movement.AgentHeight,
            AgentCanJump = SETTINGS.Movement.AgentCanJump,
        })
        p:ComputeAsync(startPos, endPos)
        return p
    end)
    if ok and path and path.Status == Enum.PathStatus.Success then return path end
    return nil
end

local function IsEdgeAhead(myRoot, direction)
    if not SETTINGS.Movement.CheckEdges then return false end
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.001 then return false end
    direction = direction.Unit
    local aheadPos = myRoot.Position + direction * SETTINGS.Movement.EdgeRayDistance
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}
    local rayOrigin = aheadPos + Vector3.new(0, 2, 0)
    local rayDirection = Vector3.new(0, -(SETTINGS.Movement.EdgeHeightLimit + 8), 0)
    local result = Workspace:Raycast(rayOrigin, rayDirection, params)
    if not result then return true end
    return (myRoot.Position.Y - result.Position.Y) > SETTINGS.Movement.EdgeHeightLimit
end

local function IsObstacleAhead(myRoot, direction, distance)
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.001 then return false, false end
    direction = direction.Unit
    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local rayEnd = rayStart + direction * distance
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}
    local result = Workspace:Raycast(rayStart, rayEnd - rayStart, params)
    if result then
        local heightDiff = result.Position.Y - myRoot.Position.Y
        if heightDiff < 3.5 then return true, true end
        return true, false
    end
    return false, false
end

local function FindAvoidanceDirection(myRoot, targetPos)
    local forward = targetPos - myRoot.Position
    forward = Vector3.new(forward.X, 0, forward.Z)
    if forward.Magnitude < 0.1 then forward = Vector3.new(1, 0, 0) else forward = forward.Unit end

    local right = Vector3.new(0, 1, 0):Cross(forward).Unit
    local left = -right
    local backward = -forward

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {myRoot.Parent}

    local rayStart = myRoot.Position + Vector3.new(0, 1.5, 0)
    local checkDist = SETTINGS.Movement.StuckRayDistance

    local forwardRay = Workspace:Raycast(rayStart, forward * checkDist, params)
    local rightRay = Workspace:Raycast(rayStart, right * checkDist, params)
    local leftRay = Workspace:Raycast(rayStart, left * checkDist, params)
    local backwardRay = Workspace:Raycast(rayStart, backward * checkDist, params)

    -- Priority: forward, right, left, backward
    if not forwardRay then return forward end
    if not rightRay then return right end
    if not leftRay then return left end
    if not backwardRay then return backward end

    -- All blocked: pick a side randomly
    return math.random() > 0.5 and right or left
end

local PathfindingBusy = false

local function UpdatePath(myRoot, targetPos)
    local now = time()
    if now - MovementState.LastPathCompute < SETTINGS.Movement.PathRecomputeDelay then return end
    local dist = (targetPos - myRoot.Position).Magnitude
    if dist < SETTINGS.Movement.DirectMoveRange then
        MovementState.CurrentPath = nil
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return
    end
    if dist > SETTINGS.Movement.PathfindingRange and SETTINGS.Movement.UsePathfinding and not PathfindingBusy then
        PathfindingBusy = true
        local char = myRoot.Parent
        local startPos = myRoot.Position
        coroutine.wrap(function()
            local path = ComputePathSafe(startPos, targetPos)
            PathfindingBusy = false
            if not char or not char.Parent then return end
            if path then
                MovementState.CurrentPath = path
                MovementState.PathWaypoints = path:GetWaypoints()
                MovementState.CurrentWaypointIndex = 2
                MovementState.LastPathCompute = time()
            else
                MovementState.CurrentPath = nil
                MovementState.PathWaypoints = {}
                MovementState.CurrentWaypointIndex = 0
            end
        end)()
    end
end

local function FollowPath(hum, myRoot)
    if not MovementState.PathWaypoints or #MovementState.PathWaypoints == 0 then return false end
    local idx = MovementState.CurrentWaypointIndex
    if idx > #MovementState.PathWaypoints then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end
    local waypoint = MovementState.PathWaypoints[idx]
    local waypointPos = waypoint.Position
    if (waypointPos - myRoot.Position).Magnitude < 4 then
        MovementState.CurrentWaypointIndex = idx + 1
        return true
    end
    if waypoint.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
    local direction = waypointPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.1 then return true end
    direction = direction.Unit
    if IsEdgeAhead(myRoot, direction) then
        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        return false
    end
    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)
    if hasObstacle and canJump then hum.Jump = true end
    local now = time()
    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(waypointPos)
    end
    return true
end

local function HandleAntiStuck(hum, myRoot, targetPos)
    local currentPos = myRoot.Position
    local movement = (currentPos - MovementState.LastPosition).Magnitude
    local dt = MovementState.LastDelta or 0.016

    -- Framerate-independent threshold: 0.15 studs/frame at 60 FPS
    local expectedMin = SETTINGS.Movement.StuckThreshold * dt * 60

    if movement < expectedMin then
        MovementState.StuckFrames = MovementState.StuckFrames + 1
    else
        MovementState.StuckFrames = 0
        MovementState.AvoidanceDir = nil
    end
    MovementState.LastPosition = currentPos

    if MovementState.StuckFrames >= SETTINGS.Movement.StuckFrames then
        MovementState.StuckFrames = 0
        local avoidDir = FindAvoidanceDirection(myRoot, targetPos)
        if not IsEdgeAhead(myRoot, avoidDir) then
            MovementState.AvoidanceDir = avoidDir
            MovementState.AvoidanceUntil = time() + 0.5
            local hasObstacle, canJump = IsObstacleAhead(myRoot, avoidDir, 5)
            if hasObstacle and canJump then hum.Jump = true end
            local avoidTarget = myRoot.Position + avoidDir * 8
            local now = time()
            if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
                MovementState.LastMoveTo = now
                hum:MoveTo(avoidTarget)
            end
            MovementState.PathWaypoints = {}
            MovementState.CurrentWaypointIndex = 0
        else
            hum.Jump = true
        end
        return true
    end

    if MovementState.AvoidanceDir and time() < MovementState.AvoidanceUntil then
        local avoidTarget = myRoot.Position + MovementState.AvoidanceDir * 8
        local now = time()
        if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
            MovementState.LastMoveTo = now
            hum:MoveTo(avoidTarget)
        end
        return true
    end
    return false
end

local function GetOrbitPosition(myRoot, tRoot, dist)
    if not SETTINGS.Movement.SmoothOrbit then return tRoot.Position end
    local now = time()

    if MovementState.NextOrbitSwitch == 0 then
        MovementState.NextOrbitSwitch = now + 2.5 + math.random() * 2
    end

    if now >= MovementState.NextOrbitSwitch then
        MovementState.OrbitDirection = -MovementState.OrbitDirection
        MovementState.NextOrbitSwitch = now + 2.5 + math.random() * 2
    end

    -- Framerate-independent angular velocity
    local angularVelocity = (2 * math.pi) / (SETTINGS.Movement.OrbitPeriod or 3.5)
    local dt = MovementState.LastDelta or 0.016
    MovementState.OrbitAngle = MovementState.OrbitAngle
        + angularVelocity * MovementState.OrbitDirection * dt

    local jitter = (math.random() - 0.5) * SETTINGS.Movement.OrbitJitter
    local radius = clamp(SETTINGS.OrbitRadius + jitter, SETTINGS.Movement.OrbitMinDist, SETTINGS.Movement.OrbitMaxDist)

    local offsetX = math.cos(MovementState.OrbitAngle) * radius
    local offsetZ = math.sin(MovementState.OrbitAngle) * radius
    return tRoot.Position + Vector3.new(offsetX, 0, offsetZ)
end

local function AdvancedMoveTo(hum, myRoot, tRoot, targetPos, dist)
    if HandleAntiStuck(hum, myRoot, targetPos) then return end
    UpdatePath(myRoot, targetPos)
    if #MovementState.PathWaypoints > 0 then
        if FollowPath(hum, myRoot) then return end
    end
    local direction = targetPos - myRoot.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.5 then return end
    direction = direction.Unit
    if IsEdgeAhead(myRoot, direction) then return end
    local hasObstacle, canJump = IsObstacleAhead(myRoot, direction, 4)
    if hasObstacle and canJump then hum.Jump = true end
    local now = time()
    if now - MovementState.LastMoveTo > SETTINGS.Movement.MoveToThrottle then
        MovementState.LastMoveTo = now
        hum:MoveTo(targetPos)
    end
end

