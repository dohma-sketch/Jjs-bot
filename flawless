-- // HELPERS // --

local function clamp(val, min, max)
    if val < min then return min end
    if val > max then return max end
    return val
end

local function MakeLookCFrame(pos, look)
    if CFrame.lookAt then
        return CFrame.lookAt(pos, look)
    end
    return CFrame.new(pos, look)
end

local function SafeCFrameLerp(a, b, alpha)
    if a.Lerp then return a:Lerp(b, alpha) end
    return b
end

