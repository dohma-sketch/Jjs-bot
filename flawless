-- // MAIN LOOP // --
RunService.Heartbeat:Connect(function()
    if not SETTINGS.Enabled then
        return
    end

    UpdateAction()

    local myChar = LocalPlayer.Character

    if not IsAlive(myChar) then
        State.Target = nil
        return
    end

    if State.ConnectedChar ~= myChar then
        State.ConnectedChar = myChar

        if DeathConnection then
            pcall(function()
                DeathConnection:Disconnect()
            end)
        end

        local hum = myChar:FindFirstChild("Humanoid")
        if hum then
            DeathConnection = hum.Died:Connect(OnCharacterDeath)
        end
    end

    local incapacitated = IsIncapacitated(myChar)

    if incapacitated then
        if State.IncapacitatedSince == 0 then
            State.IncapacitatedSince = time()
        end

        local incDuration = time() - State.IncapacitatedSince

        if incDuration >= (SETTINGS.SurvivalDebounce or 0.2) then
            if ActiveAction.Name ~= "Survival" then
                BeginAction("Survival", 0.35, ActionPriority.SURVIVAL, false)

                PressKey(Enum.KeyCode.Space, 0.08)

                local dashKey = SETTINGS.FlankDash and SETTINGS.FlankDash.QKey or Enum.KeyCode.Q

                if math.random() > 0.75 and time() - State.LastDash > SETTINGS.DashCD then
                    PressKey(dashKey, 0.05)
                    State.LastDash = time()
                end
            end
        end

        return
    else
        State.IncapacitatedSince = 0
    end

    local target = State.Target

    if not target or not IsAlive(target) then
        target = FindTarget()
        State.Target = target
        State.HitsOnBlock = 0
        ResetEnemyCache()
    end

    if not target then
        ForceEndAllActions()

        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil

        return
    end

    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tRoot = target:FindFirstChild("HumanoidRootPart")

    if not myRoot or not tRoot then
        ForceEndAllActions()

        MovementState.PathWaypoints = {}
        MovementState.CurrentWaypointIndex = 0
        MovementState.AvoidanceDir = nil

        return
    end

    UpdateEnemyCache(target)

    local dist = (myRoot.Position - tRoot.Position).Magnitude

    -- Периодическая проверка видимости цели
    if time() - State.LastTargetCheck > (SETTINGS.TargetRecheckDelay or 2) then
        State.LastTargetCheck = time()

        if not CanSeeCharacter(myChar, myRoot, target, tRoot) then
            local newTarget = FindTarget()

            if newTarget and newTarget ~= target then
                State.Target = newTarget
                target = newTarget
                State.HitsOnBlock = 0
                ResetEnemyCache()

                local newTRoot = target:FindFirstChild("HumanoidRootPart")

                if not newTRoot then
                    ForceEndAllActions()
                    return
                end

                tRoot = newTRoot
                dist = (myRoot.Position - tRoot.Position).Magnitude
                UpdateEnemyCache(target)
            end
        end
    end

    AimAt(PredictTargetPosition(tRoot, dist))

    -- Приоритетные поведения
    if TryAwakenKite(target, dist, myRoot, tRoot) then
        return
    end

    if TryParry(target, dist, myRoot, tRoot) then
        return
    end

    if TryFlankDash(target, dist, myRoot, tRoot) then
        return
    end

    -- Обычное поведение
    HandleMovementAndDef(target, dist, myRoot, tRoot)

    if dist < SETTINGS.AggroRange then
        HandleCombat(target, dist)
    end
end)

