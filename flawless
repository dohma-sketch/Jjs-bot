-- // MATH HELPERS // --

local function clamp(val, min, max)
    if val < min then return min end
    if val > max then return max end
    return val
end

local function MakeLookCFrame(pos, look)
    if CFrame.lookAt then
        return CFrame.lookAt(pos, look)
    end
    return CFrame.new(pos, look)
end

-- Framerate-independent exponential smoothing
-- k = -math.log(1 - baseAlpha) / baseDt
-- For baseAlpha=0.22, baseDt=0.016: k ≈ 15.54
local SMOOTH_K = 15.54

local function SmoothCFrame(current, target, dt)
    local alpha = 1 - math.exp(-SMOOTH_K * (dt or 0.016))
    alpha = clamp(alpha, 0, 1)
    if current.Lerp then
        return current:Lerp(target, alpha)
    end
    return target
end

