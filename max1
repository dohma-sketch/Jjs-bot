-- SMART AWAKENING (FIX 10: проверка своего пробуждения)
-- ============================================================
local Awakening = { isAwakened = false, awakenedAt = 0 }
function Awakening:Update(myChar)
    -- реальная проверка через атрибут
    if GetBoolAttr(myChar, "Awakened") or GetBoolAttr(myChar, "Awake") then
        self.isAwakened = true
    end
    if self.isAwakened and (time() - self.awakenedAt) > SETTINGS.AwakenDuration then
        if not GetBoolAttr(myChar, "Awakened") then self.isAwakened = false end
    end
    return self.isAwakened
end
local function ScoreAwaken(ctx)
    if Awakening.isAwakened then return 0 end
    if not Resources:IsReady("Awaken") then return 0 end
    if ctx.incapacitated then return 0 end
    if not ctx.target then return 0 end
    local score = 0
    if ctx.enemyHealthRatio and ctx.enemyHealthRatio < 0.35 and ctx.dist < 25 then score = score + 40 end
    if ctx.enemyStunned then score = score + 25 end
    if ctx.myHealthRatio < 0.4 and ctx.enemyAwakened then score = score + 45 end
    if ctx.myHealthRatio < 0.25 then score = score + 30 end
    if ctx.enemyHealthRatio and ctx.enemyHealthRatio > 0.8 and ctx.myHealthRatio > 0.6 then score = score - 30 end
    if ctx.dist > 40 then score = score - 20 end
    return score
end
function Awakening:SmartUpdate(ctx)
    if not SETTINGS.SmartAwaken then return false end
    self:Update(ctx.myChar)
    if ScoreAwaken(ctx) >= SETTINGS.AwakenScoreThreshold then
        Resources:Use("Awaken")
        InputSystem:PressKeySafe(CONFIG.Keys.Awaken, 0.15)
        self.isAwakened = true; self.awakenedAt = time()
        local M = _G.JJS_Metrics
        if M then M.awakensUsed = M.awakensUsed + 1 end
        return true
    end
    return false
end

