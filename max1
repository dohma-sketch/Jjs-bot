local DomainCounter = { active = false, caster = nil, untilT = 0, lastDodge = 0, counted = false }
function DomainCounter:Detect()
    local now = time()
    local F = _G.JJS_Feed
    local M = _G.JJS_Metrics
    if F and F.domain and (now - F.domain.time) < 0.5 then
        self.caster = F.domain.char
        self.untilT = now + 10
        if not self.counted then
            if M then M.domainsSeen = M.domainsSeen + 1 end
            self.counted = true
        end
        self.active = true
    end
    if DomainBarrier.obj and DomainBarrier.obj.Parent then
        if not self.active and M then M.domainsSeen = M.domainsSeen + 1 end
        self.active = true; self.untilT = now + 2; self.counted = true
    end
    if now > self.untilT then
        if self.active and M and IsAlive(LocalPlayer.Character) then
            M.domainsSurvived = M.domainsSurvived + 1
        end
        self.active = false; self.caster = nil; self.counted = false
    end
    return self.active
end
function DomainCounter:Escape(ctx)
    local hum = ctx.myChar:FindFirstChild("Humanoid")
    if not hum then return end
    local center, radius = GetBarrierInfo()
    local away
    if center then away = ctx.myRoot.Position - center
    elseif self.caster then
        local cr = self.caster:FindFirstChild("HumanoidRootPart")
        away = cr and (ctx.myRoot.Position - cr.Position) or nil
    end
    if not away or away.Magnitude < 0.001 then away = Vector3.new(1, 0, 0)
    else away = Vector3.new(away.X, 0, away.Z).Unit end
    hum:MoveTo(ctx.myRoot.Position + away * (radius or 30))
    if Resources:IsReady("ForwardDash") and (time() - self.lastDodge) > 1 then
        self.lastDodge = time(); Resources:Use("ForwardDash")
        InputSystem:PressKeySafe(CONFIG.Keys.Dash, 0.06)
    end
end

