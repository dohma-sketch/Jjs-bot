local Perception = { target = nil, cache = {} }
function Perception:UpdateCache(target)
    local cache = self.cache
    local now = time()
    cache.attacking = false; cache.blocking = false; cache.dashing = false
    cache.awakened = false; cache.stunned = false; cache.countering = false; cache.ragdolled = false
    local F = _G.JJS_Feed
    if F and target then
        if F.attack.char == target and (now - F.attack.time) < 0.2 then cache.attacking = true end
        if F.hitboxChar == target and (now - F.hitboxTime) < 0.25 then cache.attacking = true end
        if F.block.char == target and F.block.active and (now - F.block.start) < 2 then
            cache.blocking = true
        end
        if F.dash.char == target and (now - F.dash.time) < 0.2 then cache.dashing = true end
        if F.awaken.char == target and (now - F.awaken.time) < 2 then cache.awakened = true end
        if F.counter.char == target and (now - F.counter.time) < 0.5 then cache.countering = true end
    end
    if target then
        local hum = target:FindFirstChild("Humanoid")
        if hum then
            local st = hum:GetState()
            cache.ragdolled = st == Enum.HumanoidStateType.Ragdoll
            cache.stunned = cache.ragdolled or st == Enum.HumanoidStateType.GettingUp
        end
    end
    return cache
end

