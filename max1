-- PATHFINDING (FIX 2,8: обход стен + прыжок)
-- ============================================================
local Pathfinding = { points = {}, idx = 1, computing = false, lastCompute = 0 }
local function ComputePath(from, to)
    if Pathfinding.computing then return end
    Pathfinding.computing = true
    pcall(function()
        task.defer(function()
            local pf = PathS:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
            local ok = pcall(function() pf:ComputeAsync(from, to) end)
            if ok and pf.Status == Enum.PathStatus.Success then
                Pathfinding.points = pf:GetWaypoints()
                Pathfinding.idx = 2
            else
                Pathfinding.points = {}
            end
            Pathfinding.computing = false
        end)
    end)
end
local function FollowPath(hum, myRoot)
    local pts = Pathfinding.points
    if #pts == 0 then return false end
    local wp = pts[Pathfinding.idx]
    if not wp then Pathfinding.points = {}; return false end
    if wp.Action == Enum.PathWaypointAction.Jump then InputSystem:Jump() end
    hum:MoveTo(wp.Position)
    if (myRoot.Position - wp.Position).Magnitude < 4 then
        Pathfinding.idx = Pathfinding.idx + 1
    end
    return true
end

