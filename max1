local function IsAlive(char)
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    return hum and hum.Health > 0
end
local function GetHealth(char)
    local hum = char and char:FindFirstChild("Humanoid")
    if hum then return hum.Health end
    return nil
end
local function GetBoolAttr(obj, name)
    if not obj then return false end
    local ok, v = pcall(function() return obj:GetAttribute(name) end)
    return ok and v == true
end
local function PredictPosition(root, dist)
    if not root then return nil end
    local vel = root.AssemblyLinearVelocity or root.Velocity or Vector3.new()
    return root.Position + vel * math.min(dist * 0.02, 0.4)
end
local function MakeLookCFrame(pos, lookAt)
    local dir = lookAt - pos
    if dir.Magnitude < 0.001 then return CFrame.new(pos) end
    return CFrame.new(pos, pos + Vector3.new(dir.X, 0, dir.Z))
end

-- ============================================================
-- TIMER
-- ============================================================
local TimerQueue = {}
local function TimerDelay(dur, fn) table.insert(TimerQueue, {at = time() + dur, fn = fn}) end
local function TimerTick()
    local now = time()
    for i = #TimerQueue, 1, -1 do
        local t = TimerQueue[i]
        if now >= t.at then table.remove(TimerQueue, i); pcall(t.fn) end
    end
end

