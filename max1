-- SURVIVAL
-- ============================================================
local Survival = { lastHideScan = 0, hideSpot = nil, hideScore = 0, mode = "-" }
local function HasLineOfSight(aRoot, bRoot, params)
    local from = aRoot.Position + Vector3.new(0, 2, 0)
    local to = bRoot.Position + Vector3.new(0, 2, 0)
    return Workspace:Raycast(from, to - from, params) == nil
end
local function FindHideSpot(myRoot, enemyRoot, params)
    local myPos = myRoot.Position; local enemyPos = enemyRoot.Position
    local up = Vector3.new(0, 2, 0)
    local best = nil; local bestScore = -math.huge
    for i = 0, 11 do
        local ang = math.rad(i * 30)
        local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
        local cand = myPos + dir * 12
        local toCand = Workspace:Raycast(myPos + up, cand - myPos, params)
        local reachable = (toCand == nil)
        local los = Workspace:Raycast(enemyPos + up, cand - enemyPos, params)
        local hidden = (los ~= nil)
        local score = 0
        if hidden then score = score + 100 end
        if reachable then score = score + 50 end
        score = score + math.min((cand - enemyPos).Magnitude * 0.5, 30)
        if score > bestScore then bestScore = score; best = cand end
    end
    return best, bestScore
end
function Survival:Update(ctx)
    local hum = ctx.myChar:FindFirstChild("Humanoid")
    if not hum then return end
    local now = time()
    local params = WallParams()
    if now - self.lastHideScan > 0.4 then
        self.lastHideScan = now
        self.hideSpot, self.hideScore = FindHideSpot(ctx.myRoot, ctx.tRoot, params)
    end
    if ctx.enemyAttacking and ctx.dist < 16 then
        if Resources:IsReady("SideDash") then self.mode = "DODGE"; DoDodgeNow(ctx.tRoot, false)
        else
            self.mode = "BLOCK"
            InputSystem:SendKey(CONFIG.Keys.Block, true)
            TimerDelay(0.3, function() InputSystem:SendKey(CONFIG.Keys.Block, false) end)
        end
        return
    end
    local visible = HasLineOfSight(ctx.tRoot, ctx.myRoot, params)
    if visible and self.hideSpot and self.hideScore > 120 then
        self.mode = "HIDE"; hum:MoveTo(self.hideSpot); return
    end
    if not visible then
        self.mode = "HIDDEN"   -- FIX 26: стоим, не лезем в стену
        return
    end
    self.mode = "KITE"
    local away = ctx.myRoot.Position - ctx.tRoot.Position
    away = Vector3.new(away.X, 0, away.Z)
    if away.Magnitude < 0.001 then away = Vector3.new(1, 0, 0) else away = away.Unit end
    hum:MoveTo(ctx.myRoot.Position + away * 12)
end

