    if not obj or not obj.Parent then DomainBarrier.obj = nil; return nil, 0 end
    local center, radius
    pcall(function()
        if obj:IsA("BasePart") then center = obj.Position; radius = obj.Size.Magnitude / 2
        else local cf, size = obj:GetBoundingBox(); center = cf.Position; radius = size.Magnitude / 2 end
    end)
    if radius and radius > 60 then radius = 60 end   -- FIX 25: кламп
    return center, radius
