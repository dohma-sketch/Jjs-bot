-- HIT CONFIRM
-- ============================================================
local function StartHitTrack(ctx)
    State.preHitHealth = GetHealth(ctx.target) or 0
    State.hitTrackAt = time()
end
local function ConfirmHit(ctx)
    if not State.preHitHealth or State.preHitHealth == 0 then return nil end
    if (time() - State.hitTrackAt) < 0.15 then return nil end
    if (time() - State.hitTrackAt) > 1.5 then return nil end
    local cur = GetHealth(ctx.target)
    if not cur then return nil end
    if cur < State.preHitHealth then return true end
    if ctx.enemyStunned then return true end
    return false
end

