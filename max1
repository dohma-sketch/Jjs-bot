local ActionManager = { current = nil, priority = {
    SURVIVAL = 100, DEFENSE = 80, BLOCK_BREAK = 60, OFFENSE = 30, MOVEMENT = 10 }}
function ActionManager:Begin(name, dur, prio, lockMove)
    if self.current and self.current.priority > prio then return false, self.current.id end
    local id = math.random(1, 999999)
    self.current = {name = name, id = id, priority = prio, lockMove = lockMove, untilT = time() + dur}
