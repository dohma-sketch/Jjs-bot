function FightLog:Record(ev)
    ev.t = math.floor(time() - Metrics.startedAt)
    table.insert(self.events, ev)
    if #self.events > 800 then table.remove(self.events, 1) end
end
function FightLog:Export()
    local lines = {"=== FIGHT LOG (" .. #self.events .. ") ==="}
    for _, e in pairs(self.events) do
        local parts = {}
        for k, v in pairs(e) do parts[#parts+1] = k .. "=" .. tostring(v) end
        lines[#lines+1] = table.concat(parts, " ")
    end
    if type(setclipboard) == "function" then setclipboard(table.concat(lines, "\n")) end
    return #self.events
end
