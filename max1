RunService.Heartbeat:Connect(function(dt)
    pcall(function()
        TimerTick()
        ActionManager:Tick()

        local myChar = LocalPlayer.Character
        local hum0 = myChar and myChar:FindFirstChild("Humanoid")
        local aliveNow = hum0 and hum0.Health > 0

        if wasAlive and not aliveNow then
            Metrics.deaths = Metrics.deaths + 1
            FightLog:Record({type = "DEATH"})
        end
        wasAlive = aliveNow

        if not myChar or not aliveNow then return end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        local hum = hum0
        if not myRoot then return end

        local incapacitated = hum:GetState() == Enum.HumanoidStateType.Ragdoll
        if incapacitated then
            if MainState.incapacitatedSince == 0 then MainState.incapacitatedSince = time() end
            local sinceInc = time() - MainState.incapacitatedSince
            local top0 = ThreatManager:Top(myRoot)
            local realCombo = top0 and top0.attacking and top0.dist < 15
            if sinceInc > 0.3 and realCombo and Resources:IsReady("SideDash") then
                Resources:Use("SideDash")
                InputSystem:PressKeySafe(CONFIG.Keys.Dash, 0.06)
            end
            return
        else
            MainState.incapacitatedSince = 0
        end

        -- target
        local target = nil; local tRoot = nil; local dist = math.huge
        local bestD = 60
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                local ph = plr.Character:FindFirstChild("Humanoid")
                if tr and ph and ph.Health > 0 then
                    local d = (tr.Position - myRoot.Position).Magnitude
                    if d < bestD then bestD = d; target = plr.Character; tRoot = tr end
                end
            end
        end
        if not target then return end
        dist = bestD

        Perception:UpdateCache(target)
        local cache = Perception.cache

        -- 360 threats (FIX 22: любой атакующий, не только топ)
        if SETTINGS.ThreatAwareness then
            local top, all = ThreatManager:Top(myRoot)
            local anyAttacker = nil
            for _, t in pairs(all) do
                if t.attacking and t.dist < 18 then anyAttacker = t; break end
            end
            local dodgeSource = top
            if anyAttacker then dodgeSource = anyAttacker end

            if top and (top.attacking or top.predictive) and top.dist < 20 then
                if SETTINGS.AutoSwitchTarget and top.char ~= target and top.threat > 70
                   and (time() - State.lastTargetSwitch) > 2 then
                    State.lastTargetSwitch = time()
                    target = top.char; tRoot = top.root; dist = top.dist
                    Perception:UpdateCache(target)
                    cache = Perception.cache
                end
            end
            if dodgeSource and SETTINGS.AutoDodge
               and (dodgeSource.attacking or dodgeSource.predictive) then
                if DoDodgeNow(dodgeSource.root, dodgeSource.predictive) then return end
            end
        end

        -- context
        local myWall = WallAwareness:GetInfo(myRoot)
        local enemyWall = tRoot and WallAwareness:GetInfo(tRoot, false) or nil
        local hasLOS = true
        pcall(function()
            local params = WallParams()
            local from = myRoot.Position + Vector3.new(0, 2, 0)
            local to = tRoot.Position + Vector3.new(0, 2, 0)
            hasLOS = Workspace:Raycast(from, to - from, params) == nil
        end)
        local behindEnemy = false
        pcall(function()
            local toMe = (myRoot.Position - tRoot.Position).Unit
            behindEnemy = tRoot.CFrame.LookVector:Dot(toMe) > 0.5
        end)

        local ctx = {
            myChar = myChar, myRoot = myRoot, target = target, tRoot = tRoot, dist = dist,
            incapacitated = incapacitated,
            myHealthRatio = hum.Health / hum.MaxHealth,
            enemyHealthRatio = (function()
                local eh = GetHealth(target)
                local eh2 = target:FindFirstChild("Humanoid")
                if eh and eh2 then return eh / eh2.MaxHealth end
                return 1
            end)(),
            enemyAttacking = cache.attacking, enemyBlocking = cache.blocking,
            enemyDashing = cache.dashing, enemyAwakened = cache.awakened,
            enemyStunned = cache.stunned, enemyRagdolled = cache.ragdolled,
            enemyCountering = cache.countering,
            cornered = myWall.cornered, enemyCornered = enemyWall and enemyWall.cornered or false,
            hasLOS = hasLOS, behindEnemy = behindEnemy,
            sideDashReady = Resources:IsReady("SideDash"),
        }

        -- FIX 3: прицел ДО атаки
        local aim = PredictPosition(tRoot, dist)
        if aim and not ActionManager:IsMovementLocked() then
            myRoot.CFrame = MakeLookCFrame(myRoot.Position, aim)
        end

        -- domain
        if DomainCounter:Detect() then
            DomainCounter:Escape(ctx)
            return
        end

        -- awaken
        Awakening:SmartUpdate(ctx)

        -- punish on block end
        if SETTINGS.PunishAfterBlock then
            if ctx.enemyBlocking then
                State.blockSeenAt = time(); State.prevEnemyBlocking = true
            elseif State.prevEnemyBlocking and (time() - State.blockSeenAt) < 1
                and ctx.dist <= CONFIG.Combat.AttackRange and not ctx.enemyCountering then
                State.prevEnemyBlocking = false
                PlanExecutor:StartPattern(GetComboSequence(ctx))
            else
                State.prevEnemyBlocking = false
            end
        end

        -- decide + execute
        if SETTINGS.AutoCombat and not (ctx.enemyAwakened and SETTINGS.EvadeAwakened) then
            if PlanExecutor:Tick(ctx) then
                -- combo running
            else
                local action = Strategy:Decide(ctx)
                if action == "Combo" then
                    PlanExecutor:StartPattern(GetComboSequence(ctx))
                elseif action == "BlockBreak" then
                    CombatExecutor:Skill(ctx)
                    Metrics.blocksDone = Metrics.blocksDone + 1
                elseif action == "Skill" then
                    CombatExecutor:Skill(ctx)
                end
            end
        end

        -- heal
        TryHeal(ctx)

        -- movement
        MovementController:Update(ctx, hum)

        -- kill detect (FIX 23: dedupe)
        local thp = GetHealth(target)
        if thp == 0 and State.lastKillTarget ~= target then
            State.lastKillTarget = target
            Metrics.kills = Metrics.kills + 1
            FightLog:Record({type = "KILL", vs = target.Name})
        end
    end)
end)

