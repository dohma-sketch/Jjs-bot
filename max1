-- ============================================================
-- PLAN EXECUTOR (FIX 21,27: стоп на мёртвом/лежащем)
-- ============================================================
local PlanExecutor = { queue = {}, stepAt = 0 }
function PlanExecutor:Active() return #self.queue > 0 end
function PlanExecutor:StartPattern(seq) self.queue = seq; self.stepAt = 0 end
function PlanExecutor:Tick(ctx)
    if #self.queue == 0 then return false end
    -- FIX 21/27: цель мертва или лежит — прекращаем махать
    if ctx.target then
        local th = GetHealth(ctx.target)
        if not th or th <= 0 then self.queue = {}; return false end
        local thum = ctx.target:FindFirstChild("Humanoid")
        if thum and thum:GetState() == Enum.HumanoidStateType.Ragdoll then
            self.queue = {}; return false
        end
    end
    local now = time()
    if now < self.stepAt then return true end
    local step = table.remove(self.queue, 1)
    self.stepAt = now + 0.25
    if step == "M1" then CombatExecutor:M1(ctx)
    elseif step == "Skill" then CombatExecutor:Skill(ctx) end
    return #self.queue > 0
end

-- ============================================================
-- STRATEGY (FIX 41: учитывает CD)
-- ============================================================
local Strategy = {}
function Strategy:Decide(ctx)
    local best = nil; local bestScore = 0
    local combo = 0
    if ctx.dist <= CONFIG.Combat.AttackRange and not ctx.enemyBlocking and not ctx.enemyCountering
       and not ctx.enemyRagdolled then
        combo = 30
        local hit = ConfirmHit(ctx)
        if hit == true then combo = combo + 15 end
        if hit == false then combo = combo - 10 end
        if ctx.enemyStunned or ctx.behindEnemy then combo = combo + 20 end
        if ctx.cornered then combo = combo - 15 end
        if ctx.enemyCornered then combo = combo + 10 end
        if Awakening.isAwakened then combo = combo + 20 end
    end
    if combo > bestScore then bestScore = combo; best = "Combo" end

    local blockBreak = 0
    if ctx.enemyBlocking and ctx.dist <= CONFIG.Combat.AttackRange then blockBreak = 40 end
    if blockBreak > bestScore then bestScore = blockBreak; best = "BlockBreak" end

    local skill = 0
    if ctx.dist <= CONFIG.Combat.SkillRange and ctx.hasLOS and not ctx.enemyCountering
       and Resources:IsReady("Skill") then
        skill = 25
        if ctx.enemyStunned then skill = skill + 10 end
    end
    if skill > bestScore then bestScore = skill; best = "Skill" end

    return best
end

-- ============================================================
-- MOVEMENT (FIX 2,4,19: pathfind, стоять в комбо, чередовать орбиту)
-- ============================================================
local MovementController = { lastMoveTo = 0, stuckSince = 0, lastPos = nil }
local function MoveTo(hum, pos)
    local now = time()
    if now - MovementController.lastMoveTo > 0.08 then
        MovementController.lastMoveTo = now
        hum:MoveTo(pos)
    end
end
function MovementController:Update(ctx, hum)
    if ActionManager:IsMovementLocked() then return end
    local myRoot = ctx.myRoot

    if ctx.cornered then
        local esc = WallAwareness:FindEscapeDirection(myRoot)
        if esc then MoveTo(hum, myRoot.Position + esc * 10) end
        return
    end

    if ctx.enemyAwakened and SETTINGS.EvadeAwakened then
        Survival:Update(ctx)
        return
    end

    -- anti-stuck
    if MovementController.lastPos then
        local moved = (myRoot.Position - MovementController.lastPos).Magnitude
        if moved < 0.5 then
            if MovementController.stuckSince == 0 then MovementController.stuckSince = time() end
            if time() - MovementController.stuckSince > 1 then
                InputSystem:Jump()
                local esc = WallAwareness:FindEscapeDirection(myRoot)
                if esc then MoveTo(hum, myRoot.Position + esc * 8) end
                MovementController.stuckSince = 0
            end
        else
            MovementController.stuckSince = 0
        end
    end
    MovementController.lastPos = myRoot.Position

    if not ctx.target then return end

    if ctx.dist > CONFIG.Combat.AttackRange then
        -- FIX 2: pathfinding если нет LOS
        if SETTINGS.Pathfind and not ctx.hasLOS
           and (time() - Pathfinding.lastCompute) > 1 then
            Pathfinding.lastCompute = time()
            ComputePath(myRoot.Position, ctx.tRoot.Position)
        end
        if SETTINGS.Pathfind and #Pathfinding.points > 0 then
            FollowPath(hum, myRoot)
        else
            MoveTo(hum, ctx.tRoot.Position)
        end
    else
        -- FIX 4: стоим и бьём во время комбо
        if PlanExecutor:Active() then return end
        -- FIX 19: чередуем направление орбиты
        State.orbitDir = State.orbitDir * -1
        local toEnemy = ctx.tRoot.Position - myRoot.Position
        toEnemy = Vector3.new(toEnemy.X, 0, toEnemy.Z)
        if toEnemy.Magnitude > 0.001 then toEnemy = toEnemy.Unit end
        local side = Vector3.new(0, 1, 0):Cross(toEnemy).Unit * State.orbitDir
        local orbitPos = ctx.tRoot.Position - toEnemy * CONFIG.Movement.OrbitDist + side * 3
        MoveTo(hum, orbitPos)
    end
end

