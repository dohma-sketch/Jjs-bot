-- WALL AWARENESS (FIX 16,17,18: меньше ложных углов, детект края, лучший побег)
-- ============================================================
local WallAwareness = { lastScan = 0, cache = nil }
local BAD_NAMES = {"debree","debris","prop","item","projectile","effect","particle","vfx","weapon","soda"}
local function IsRealWall(result)
    if not result then return false end
    local inst = result.Instance
    local name = string.lower(inst.Name)
    for _, bad in pairs(BAD_NAMES) do
        if string.find(name, bad, 1, true) then return false end
    end
    local ok, size = pcall(function() return inst.Size end)
    if not ok then return false end
    if size.Y >= 8 then return true end        -- выше порог
    if size.Magnitude >= 16 then return true end
    return false
end
local function WallParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local chars = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then table.insert(chars, plr.Character) end
    end
    params.FilterDescendantsInstances = chars
    return params
end
local function IsEdgeAhead(rootPart, dir)
    local from = rootPart.Position + dir * 4 + Vector3.new(0, 1, 0)
    local hit = Workspace:Raycast(from, Vector3.new(0, -12, 0), WallParams())
    return hit == nil
end
function WallAwareness:GetInfo(rootPart, useCache)
    local now = time()
    if useCache ~= false and self.cache and (now - self.lastScan) < 0.3 then return self.cache end
    self.lastScan = now
    local params = WallParams()
    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local checkDist = CONFIG.Movement.WallCheckDist
    local openCount = 0
    for i = 0, 7 do
        local ang = math.rad(i * 45)
        local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
        local hit = Workspace:Raycast(origin, dir * checkDist, params)
        if not IsRealWall(hit) and not IsEdgeAhead(rootPart, dir) then
            openCount = openCount + 1
        end
    end
    self.cache = { openDirections = openCount, cornered = openCount <= 1, wallsAround = 8 - openCount }
    return self.cache
end
function WallAwareness:FindEscapeDirection(rootPart)
    local params = WallParams()
    local origin = rootPart.Position + Vector3.new(0, 2, 0)
    local checkDist = CONFIG.Movement.WallCheckDist
    local best = nil; local bestDist = 0
    for i = 0, 7 do
        local ang = math.rad(i * 45)
        local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
        local hit = Workspace:Raycast(origin, dir * checkDist, params)
        local clear = not IsRealWall(hit) and not IsEdgeAhead(rootPart, dir)
        local d = 0
        if clear then
            d = hit and (hit.Position - rootPart.Position).Magnitude or checkDist
        end
        if clear and d > bestDist then bestDist = d; best = dir end   -- FIX 18: лучший
    end
    return best
end

