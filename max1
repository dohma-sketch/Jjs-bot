local function DoDodgeNow(threatRoot, predictive)
    if not Resources:IsReady("SideDash") then return false end
    Resources:Use("SideDash")
    local M = _G.JJS_Metrics
    if M then
        M.dodgesUsed = M.dodgesUsed + 1
        if predictive then M.dodgesSaved = M.dodgesSaved + 1 end
    end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    if threatRoot then
        local away = myRoot.Position - threatRoot.Position
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.001 then away = Vector3.new(1, 0, 0) else away = away.Unit end
        local perp = Vector3.new(0, 1, 0):Cross(away).Unit
        if math.random() < 0.5 then perp = -perp end
        myRoot.CFrame = MakeLookCFrame(myRoot.Position, myRoot.Position + perp)
        InputSystem:PressKeySafe(CONFIG.Keys.Dash, 0.06)
    else
        InputSystem:SendKey(CONFIG.Keys.Move, true)
        TimerDelay(0.05, function()
            InputSystem:PressKeySafe(CONFIG.Keys.Dash, 0.06)
            InputSystem:SendKey(CONFIG.Keys.Move, false)
        end)
    end
    return true
end

