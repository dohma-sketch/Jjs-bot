local feedConnections = {}
local function feedHook(remote, fn)
    local ok, conn = pcall(function() return remote.OnClientEvent:Connect(fn) end)
    if ok and conn then table.insert(feedConnections, conn) end
end

local function pickChar(...)
    for i = 1, select("#", ...) do
        local a = select(i, ...)
        if type(a) == "userdata" then
            local ok, isModel = pcall(function() return a:IsA("Model") end)
            if ok and isModel then return a end
        end
    end
    return nil
end

local function classify(serviceName, effectType)
    local s = tostring(serviceName):lower()
    local e = tostring(effectType):lower()
    if string.find(s, "movement") then return "dash" end
    if string.find(s, "block") then return "block" end
    if string.find(e, "dash") then return "dash" end
    if string.find(s, "domain") or string.find(s, "void") or string.find(s, "shrine")
       or string.find(s, "palace") or string.find(e, "domain") or string.find(e, "barrier") then
        return "domain"
    end
    if string.find(e, "hit") or string.find(e, "swing") or string.find(e, "slash")
       or string.find(e, "kick") or string.find(e, "strike") or string.find(e, "punch")
       or string.find(e, "blackflash") or string.find(e, "combo") then
        return "attack"
    end
    if string.find(e, "counter") then return "counter" end
    if string.find(e, "awaken") then return "awaken" end
    -- FIX 12: только явные windup-слова, без "start/charge" ложных
    if string.find(e, "startup") or string.find(e, "windup") or string.find(e, "build") then
        return "skillstart"
    end
    return "skill"
end

local function route(cat, who, svcName, effectType)
    local now = time()
    Feed.last.cat = cat; Feed.last.service = svcName; Feed.last.effect = tostring(effectType)
    if who then
        local pc = Feed.perChar[who]
        if not pc then pc = {attack = 0, skill = 0, dash = 0, block = 0, startup = 0}; Feed.perChar[who] = pc end
        if cat == "attack" then pc.attack = now
        elseif cat == "skill" or cat == "skillstart" then
            pc.skill = now
            if cat == "skillstart" then pc.startup = now end
        elseif cat == "dash" then pc.dash = now
        elseif cat == "block" then pc.block = now end
    end
    if cat == "attack" then
        Feed.attack.time = now; Feed.attack.char = who; Feed.attack.kind = tostring(effectType)
    elseif cat == "block" then
        Feed.block.start = now; Feed.block.active = true; Feed.block.char = who
    elseif cat == "blockend" then
        if Feed.block.char == who then Feed.block.active = false; Feed.block.stop = now end
    elseif cat == "dash" then
        Feed.dash.time = now; Feed.dash.char = who; Feed.dash.dir = tostring(effectType)
    elseif cat == "awaken" then
        Feed.awaken.time = now; Feed.awaken.char = who
    elseif cat == "domain" then
        Feed.domain.time = now; Feed.domain.char = who
    elseif cat == "counter" then
        Feed.counter.time = now; Feed.counter.char = who
    elseif cat == "hitbox" then
        Feed.hitboxTime = now; Feed.hitboxChar = who
        Feed.attack.time = now; Feed.attack.char = who; Feed.attack.kind = "hitbox"
    elseif cat == "skillstart" then
        Feed.skillStartup = now; Feed.skillStartupChar = who
        Feed.skill.time = now; Feed.skill.char = who; Feed.skill.service = svcName
    else
        Feed.skill.time = now; Feed.skill.char = who; Feed.skill.service = svcName
    end
end

