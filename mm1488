local function getTargetPart(obj)
    if obj == nil then
        return nil
    end

    local ok, part = pcall(function()
        if not obj.Parent then
            return nil
        end

        if obj:IsA("BasePart") then
            return obj
        end

        if obj:IsA("Model") then
            local primary = obj.PrimaryPart
            if primary and primary.Parent then
                return primary
            end

            local children = obj:GetChildren()
            for i = 1, #children do
                local child = children[i]
                if child:IsA("BasePart") then
                    return child
                end
            end

            return nil
        end

        local base = obj:FindFirstChild("BasePart")
        if base and base:IsA("BasePart") then
            return base
        end

        local children = obj:GetChildren()
        for i = 1, #children do
            local child = children[i]
            if child:IsA("BasePart") then
                return child
            end
        end

        return nil
    end)

    if ok and isInstanceValid(part) then
        return part
    end

    return nil
end

local function scanCoinParts(obj, cfg, out, depth)
    if #out >= cfg.MaxScanParts then
        return
    end

    if depth > cfg.ScanDepth then
        return
    end

    if not isInstanceValid(obj) then
        return
    end

    pcall(function()
        if depth > 0 then
            if obj:IsA("BasePart") then
                out[#out + 1] = obj
                return
            end

            if obj:IsA("Model") then
                local target = getTargetPart(obj)
                if target then
                    out[#out + 1] = target
                    return
                end
            end
        end

        local children = obj:GetChildren()

        for i = 1, #children do
            if #out >= cfg.MaxScanParts then
                break
            end

            scanCoinParts(children[i], cfg, out, depth + 1)
        end
    end)
end

local function getAliveRootPart()
    local character = LocalPlayer.Character
    if not isInstanceValid(character) then
        return nil
    end

    local humanoid = character:FindFirstChild("Humanoid")
    if not isInstanceValid(humanoid) then
        return nil
    end

    local okAlive, alive = pcall(function()
        return humanoid:IsA("Humanoid") and humanoid.Health > 0
    end)

    if not okAlive or not alive then
        return nil
    end

    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not isInstanceValid(rootPart) then
        return nil
    end

    local okRoot, isRootPart = pcall(function()
        return rootPart:IsA("BasePart")
    end)

    if not okRoot or not isRootPart then
        return nil
    end

    return rootPart
end

local function getCandidates(container, rootPart, cfg)
    local candidates = {}
    local parts = {}

    scanCoinParts(container, cfg, parts, 0)

    local okRootPos, rootPos = pcall(function()
        return rootPart.Position
    end)

    if not okRootPos then
        return candidates
    end

    for i = 1, #parts do
        local part = parts[i]

        if isInstanceValid(part) then
            local okDist, dist = pcall(function()
                return (part.Position - rootPos).Magnitude
            end)

            if okDist and type(dist) == "number" and dist <= cfg.MaxDistance then
                candidates[#candidates + 1] = {
                    part = part,
                    dist = dist
                }
            end
        end
    end

    if #candidates > 1 then
        table.sort(candidates, function(a, b)
            return a.dist < b.dist
        end)
    end

    return candidates
end

------------------------------------------------------------
-- Запасной автономный поиск, если контейнер не найден
------------------------------------------------------------

local fallbackCache = {}
local fallbackCacheTime = 0

local function getFallbackCandidates(rootPart, cfg)
    local now = getTime()

    if fallbackCache and (now - fallbackCacheTime) < cfg.FallbackCacheTime then
        return fallbackCache
    end

    fallbackCacheTime = now
    fallbackCache = {}

    if not cfg.DeepFallback then
        return fallbackCache
    end

    local okRootPos, rootPos = pcall(function()
        return rootPart.Position
    end)

    if not okRootPos then
        return fallbackCache
    end

    local parts = {}
    local seen = {}

    local state = {
        nodes = 0,
        maxNodes = cfg.FallbackScanBudget,
        maxDepth = cfg.FallbackScanDepth
    }

    local function scan(obj, depth)
        if state.nodes >= state.maxNodes then
            return
        end

        if depth > state.maxDepth then
            return
        end

        state.nodes = state.nodes + 1

        pcall(function()
            local children = obj:GetChildren()

            for i = 1, #children do
                if state.nodes >= state.maxNodes then
                    break
                end

                local child = children[i]

                if isInstanceValid(child) then
                    local okName, name = pcall(function()
                        return child.Name
                    end)

                    local okParentName, parentName = pcall(function()
                        return child.Parent and child.Parent.Name
                    end)

                    local nameCoin = okName and isCoinLikeName(name)
                    local parentCoin = okParentName and isCoinLikeName(parentName)

                    if nameCoin or parentCoin then
                        local target = nil

                        pcall(function()
                            if child:IsA("BasePart") then
                                target = child
                            elseif child:IsA("Model") then
                                target = getTargetPart(child)
                            else
                                target = getTargetPart(child)
                            end
                        end)

                        if isInstanceValid(target) and not seen[target] then
                            local okChar, notChar = pcall(function()
                                return not target:IsDescendantOf(LocalPlayer.Character)
                            end)

                            if (not okChar) or notChar then
                                seen[target] = true
                                parts[#parts + 1] = target
                            end
                        end
                    end

                    scan(child, depth + 1)
                end
            end
        end)
    end

    scan(Workspace, 0)

    local candidates = {}

    for i = 1, #parts do
        local part = parts[i]

        if isInstanceValid(part) then
            local okDist, dist = pcall(function()
                return (part.Position - rootPos).Magnitude
            end)

            if okDist and type(dist) == "number" and dist <= cfg.MaxDistance then
                candidates[#candidates + 1] = {
                    part = part,
                    dist = dist
                }
            end
        end
    end

    if #candidates > 1 then
        table.sort(candidates, function(a, b)
            return a.dist < b.dist
        end)
    end

    if #candidates > 50 then
        local trimmed = {}
        for i = 1, 50 do
            trimmed[i] = candidates[i]
        end
        candidates = trimmed
    end

    fallbackCache = candidates
    return candidates
end

------------------------------------------------------------
-- Телепорт и сбор
------------------------------------------------------------

local function teleportToPart(rootPart, part, cfg)
    local ok = pcall(function()
        local cf = part.CFrame
        local yOffset = tonumber(cfg.YOffset) or 0

        if yOffset ~= 0 and Vector3 then
            cf = cf + Vector3.new(0, yOffset, 0)
        end

        rootPart.CFrame = cf
    end)

    return ok
end

local function collectCycle(rootPart, cfg, activeId)
    local container = getCoinContainer(cfg)
    local candidates = {}

    if isInstanceValid(container) then
        candidates = getCandidates(container, rootPart, cfg)
    end

    if #candidates == 0 and cfg.DeepFallback then
        candidates = getFallbackCandidates(rootPart, cfg)
    end

    Env.__MM2Stats.LastCoins = #candidates

    if #candidates == 0 then
        return false
    end

    local maxTargets = math.min(#candidates, cfg.MaxTargetsPerCycle)

    for i = 1, maxTargets do
        local currentCfg = getConfig()

        if not currentCfg.Enabled or Env.__MM2AutoFarmActiveId ~= activeId then
            break
        end

        if not isInstanceValid(rootPart) then
            break
        end

        local entry = candidates[i]
        local part = entry and entry.part

        if isInstanceValid(part) then
            local okDist, distNow = pcall(function()
                return (part.Position - rootPart.Position).Magnitude
            end)

            if okDist and type(distNow) == "number" and distNow <= currentCfg.MaxDistance then
                if teleportToPart(rootPart, part, currentCfg) then
                    safeWait(humanizedDelay(currentCfg.TeleportDelay, currentCfg))
                end
            end
        end
    end

    return true
end

------------------------------------------------------------
-- Управление потоком
------------------------------------------------------------

local function stopThreadOnly()
    Env.__MM2AutoFarmActiveId = nil
end

local function startLoop()
    if Env.__MM2AutoFarmActiveId ~= nil then
        return false
    end

    local id = (tonumber(Env.__MM2AutoFarmId) or 0) + 1
    Env.__MM2AutoFarmId = id
    Env.__MM2AutoFarmActiveId = id

    safeSpawn(function()
        while Env.__MM2AutoFarmActiveId == id do
            local ok, err = pcall(function()
                while Env.__MM2AutoFarmActiveId == id do
                    local cfg = getConfig()
                    safeWait(cfg.LoopDelay)

                    if cfg.Enabled and Env.__MM2AutoFarmActiveId == id then
                        pcall(function()
                            local rootPart = getAliveRootPart()

                            if rootPart then
                                collectCycle(rootPart, cfg, id)
                            end
                        end)
                    end
                end
            end)

            if not ok then
                Env.__MM2Stats.LastError = tostring(err)
                log("Loop error: " .. tostring(err))

                local cfg = getConfig()
                if not cfg.AutoRecover then
                    Env.__MM2AutoFarmActiveId = nil
                    break
                end
            end

            if Env.__MM2AutoFarmActiveId == id then
                safeWait(1)
            end
        end

        if Env.__MM2AutoFarmActiveId == id then
            Env.__MM2AutoFarmActiveId = nil
        end
    end)

    return true
end

Env.StartAutoFarm = function()
    Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
    Env.AutoFarmConfig.Enabled = true
    return startLoop()
end

Env.StopAutoFarm = function()
    stopThreadOnly()
    Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
    Env.AutoFarmConfig.Enabled = false
end

Env.ToggleAutoFarm = function(state)
    if state == nil then
        state = not (Env.AutoFarmConfig and Env.AutoFarmConfig.Enabled)
    end

    if state then
        return Env.StartAutoFarm()
    else
        Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
        Env.AutoFarmConfig.Enabled = false
        return false
    end
end

Env.RestartAutoFarm = function()
    local cfg = getConfig()
    local wasEnabled = cfg.Enabled

    stopThreadOnly()
    safeWait(0.05)

    Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
    Env.AutoFarmConfig.Enabled = wasEnabled

    if wasEnabled then
        return Env.StartAutoFarm()
    end

    return false
end

