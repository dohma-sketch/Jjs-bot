-- Задержки
------------------------------------------------------------

local function humanizedDelay(baseDelay, cfg)
    baseDelay = tonumber(baseDelay) or 0

    if baseDelay <= 0 then
        return 0
    end

    if not cfg or cfg.HumanizeDelays ~= true then
        return baseDelay
    end

    local jitter = baseDelay * 0.20
    local result = baseDelay + ((math.random() - 0.5) * 2 * jitter)

    if result < 0 then
        result = 0
    end

    return result
end

------------------------------------------------------------
-- Поиск контейнера монет
------------------------------------------------------------

local cachedContainer = nil
local lastContainerCheck = 0
local CONTAINER_CACHE_TIME = 5

local heuristicContainer = nil
local lastHeuristicCheck = 0
local HEURISTIC_CACHE_TIME = 12

local function isCoinLikeName(name)
    if type(name) ~= "string" then
        return false
    end

    local n = string.lower(name)

    return string.find(n, "coin", 1, true) ~= nil
        or string.find(n, "pickup", 1, true) ~= nil
        or string.find(n, "drop", 1, true) ~= nil
end

local function heuristicScan(root, depth, state)
    if state.nodes >= state.maxNodes then
        return
    end

    if depth > state.maxDepth then
        return
    end

    state.nodes = state.nodes + 1

    pcall(function()
        local children = root:GetChildren()

        for i = 1, #children do
            if state.nodes >= state.maxNodes then
                break
            end

            local child = children[i]

            if isInstanceValid(child) then
                local okName, name = pcall(function()
                    return child.Name
                end)

                if okName and isCoinLikeName(name) then
                    local okType, coinLike = pcall(function()
                        return child:IsA("BasePart") or child:IsA("Model")
                    end)

                    if okType and coinLike then
                        local parent = child.Parent
                        if parent and parent ~= Workspace then
                            state.scores[parent] = (state.scores[parent] or 0) + 1
                        end
                    end
                end

                heuristicScan(child, depth + 1, state)
            end
        end
    end)
end

local function findContainerHeuristic(cfg)
    local now = getTime()

    if isInstanceValid(heuristicContainer) and (now - lastHeuristicCheck) < HEURISTIC_CACHE_TIME then
        return heuristicContainer
    end

    lastHeuristicCheck = now
    heuristicContainer = nil

    if not cfg.AutonomousDiscovery then
        return nil
    end

    local state = {
        scores = {},
        nodes = 0,
        maxNodes = cfg.AutonomousScanBudget,
        maxDepth = cfg.AutonomousScanDepth
    }

    heuristicScan(Workspace, 0, state)

    local bestParent = nil
    local bestTotal = 0
    local bestRaw = 0

    for parent, score in pairs(state.scores) do
        if score >= 2 and isInstanceValid(parent) then
            local bonus = 0

            pcall(function()
                if isCoinLikeName(parent.Name) then
                    bonus = bonus + 6
                end

                if parent:IsA("Folder") or parent:IsA("Model") or parent:IsA("Configuration") then
                    bonus = bonus + 2
                end
            end)

            local total = score + bonus

            if total > bestTotal then
                bestParent = parent
                bestTotal = total
                bestRaw = score
            end
        end
    end

    if bestParent and bestTotal >= 7 and bestRaw >= 2 then
        heuristicContainer = bestParent
        return bestParent
    end

    return nil
end

local function getCoinContainer(cfg)
    local now = getTime()

    if isInstanceValid(cachedContainer) and (now - lastContainerCheck) < CONTAINER_CACHE_TIME then
        return cachedContainer
    end

    lastContainerCheck = now
    cachedContainer = nil

    for i = 1, #cfg.ContainerNames do
        local name = cfg.ContainerNames[i]

        if type(name) == "string" then
            local ok, found = pcall(function()
                return Workspace:FindFirstChild(name)
            end)

            if ok and found then
                cachedContainer = found
                pcall(function()
                    Env.__MM2Stats.Container = found.Name
                end)
                return found
            end
        end
    end

    if cfg.AutonomousDiscovery then
        local heuristic = findContainerHeuristic(cfg)

        if heuristic then
            cachedContainer = heuristic
            pcall(function()
                Env.__MM2Stats.Container = heuristic.Name .. " [auto]"
            end)
            return heuristic
        end
    end

    Env.__MM2Stats.Container = "не найден"
    return nil
end

