local function copyArray(arr)
    local out = {}
    if type(arr) == "table" then
        for i = 1, #arr do
            out[i] = arr[i]
        end
    end
    return out
end

local function normalizeConfig(userCfg)
    local cfg = {}

    for k, v in pairs(DEFAULT_CONFIG) do
        cfg[k] = v
    end

    if type(userCfg) == "table" then
        for k, _ in pairs(DEFAULT_CONFIG) do
            if userCfg[k] ~= nil then
                cfg[k] = userCfg[k]
            end
        end
    end

    cfg.Enabled = cfg.Enabled ~= false
    cfg.HumanizeDelays = cfg.HumanizeDelays == true
    cfg.AutoRecover = cfg.AutoRecover ~= false
    cfg.AutonomousDiscovery = cfg.AutonomousDiscovery ~= false
    cfg.DeepFallback = cfg.DeepFallback ~= false
    cfg.GuiVisible = cfg.GuiVisible ~= false
    cfg.GuiAutoRecreate = cfg.GuiAutoRecreate ~= false
    cfg.Debug = cfg.Debug == true

    cfg.LoopDelay = tonumber(cfg.LoopDelay) or DEFAULT_CONFIG.LoopDelay
    if cfg.LoopDelay < 0.05 then cfg.LoopDelay = 0.05 end
    if cfg.LoopDelay > 5 then cfg.LoopDelay = 5 end

    cfg.TeleportDelay = tonumber(cfg.TeleportDelay) or DEFAULT_CONFIG.TeleportDelay
    if cfg.TeleportDelay < 0 then cfg.TeleportDelay = 0 end
    if cfg.TeleportDelay > 5 then cfg.TeleportDelay = 5 end

    cfg.MaxDistance = tonumber(cfg.MaxDistance) or DEFAULT_CONFIG.MaxDistance
    if cfg.MaxDistance < 10 then cfg.MaxDistance = 10 end
    if cfg.MaxDistance > 1000 then cfg.MaxDistance = 1000 end

    cfg.MaxTargetsPerCycle = tonumber(cfg.MaxTargetsPerCycle) or DEFAULT_CONFIG.MaxTargetsPerCycle
    if cfg.MaxTargetsPerCycle < 1 then cfg.MaxTargetsPerCycle = 1 end
    if cfg.MaxTargetsPerCycle > 50 then cfg.MaxTargetsPerCycle = 50 end

    cfg.ScanDepth = tonumber(cfg.ScanDepth) or DEFAULT_CONFIG.ScanDepth
    if cfg.ScanDepth < 1 then cfg.ScanDepth = 1 end
    if cfg.ScanDepth > 6 then cfg.ScanDepth = 6 end

    cfg.MaxScanParts = tonumber(cfg.MaxScanParts) or DEFAULT_CONFIG.MaxScanParts
    if cfg.MaxScanParts < 10 then cfg.MaxScanParts = 10 end
    if cfg.MaxScanParts > 1000 then cfg.MaxScanParts = 1000 end

    cfg.YOffset = tonumber(cfg.YOffset) or DEFAULT_CONFIG.YOffset

    cfg.AutonomousScanBudget = tonumber(cfg.AutonomousScanBudget) or DEFAULT_CONFIG.AutonomousScanBudget
    if cfg.AutonomousScanBudget < 500 then cfg.AutonomousScanBudget = 500 end
    if cfg.AutonomousScanBudget > 10000 then cfg.AutonomousScanBudget = 10000 end

    cfg.AutonomousScanDepth = tonumber(cfg.AutonomousScanDepth) or DEFAULT_CONFIG.AutonomousScanDepth
    if cfg.AutonomousScanDepth < 2 then cfg.AutonomousScanDepth = 2 end
    if cfg.AutonomousScanDepth > 7 then cfg.AutonomousScanDepth = 7 end

    cfg.FallbackScanBudget = tonumber(cfg.FallbackScanBudget) or DEFAULT_CONFIG.FallbackScanBudget
    if cfg.FallbackScanBudget < 100 then cfg.FallbackScanBudget = 100 end
    if cfg.FallbackScanBudget > 5000 then cfg.FallbackScanBudget = 5000 end

    cfg.FallbackScanDepth = tonumber(cfg.FallbackScanDepth) or DEFAULT_CONFIG.FallbackScanDepth
    if cfg.FallbackScanDepth < 1 then cfg.FallbackScanDepth = 1 end
    if cfg.FallbackScanDepth > 6 then cfg.FallbackScanDepth = 6 end

    cfg.FallbackCacheTime = tonumber(cfg.FallbackCacheTime) or DEFAULT_CONFIG.FallbackCacheTime
    if cfg.FallbackCacheTime < 0.2 then cfg.FallbackCacheTime = 0.2 end
    if cfg.FallbackCacheTime > 5 then cfg.FallbackCacheTime = 5 end

    local namesSource = DEFAULT_CONFIG.ContainerNames
    if type(userCfg) == "table" and type(userCfg.ContainerNames) == "table" then
        namesSource = userCfg.ContainerNames
    end

    cfg.ContainerNames = copyArray(namesSource)

    if #cfg.ContainerNames == 0 then
        cfg.ContainerNames = copyArray(DEFAULT_CONFIG.ContainerNames)
    end

    return cfg
end

