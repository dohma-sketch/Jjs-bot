local function connectCharacterEvents()
    local ok, con = pcall(function()
        return LocalPlayer.CharacterAdded:Connect(function(character)
            if session.Active then
                clearFlight()
                resetRoundState("CharacterAdded", 1.0)
            end
        end)
    end)

    if ok and con then
        addConnection(con)
    end
end

-- ==========================
-- API
-- ==========================
Env.MM2FlyStart = function()
    State.Enabled = true
    State.PauseUntil = 0
    updateStatus("Started")
end

Env.MM2FlyStop = function()
    State.Enabled = false
    stopVelocity()
    updateStatus("Stopped")
end

Env.MM2FlyToggle = function(value)
    if value == nil then
        value = not State.Enabled
    end

    if value then
        Env.MM2FlyStart()
    else
        Env.MM2FlyStop()
    end

    return State.Enabled
end

Env.MM2FlyReset = function()
    resetRoundState("Manual", 0.35)
end

Env.MM2FlyUnload = function()
    session.Active = false
    State.Enabled = false

    clearFlight()

    for _, con in ipairs(connections) do
        pcall(function()
            con:Disconnect()
        end)
    end

    pcall(function()
        if Env.__MM2FlyGui ~= nil then
            Env.__MM2FlyGui:Destroy()
        end
    end)

    Env.__MM2FlyConnections = {}
    Env.__MM2FlySession = nil
end

