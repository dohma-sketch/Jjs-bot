------------------------------------------------------------
-- Базовые утилиты совместимости
------------------------------------------------------------

local tickFn = nil
pcall(function()
    if type(tick) == "function" then
        tickFn = tick
    end
end)

local function getTime()
    if tickFn then
        return tickFn()
    end
    return os.clock()
end

local taskWaitFn = nil
pcall(function()
    if task ~= nil and type(task.wait) == "function" then
        taskWaitFn = function(n)
            return task.wait(n)
        end
    end
end)

local waitFn = nil
pcall(function()
    if type(wait) == "function" then
        waitFn = function(n)
            return wait(n)
        end
    end
end)

local spawnFn = nil
pcall(function()
    if task ~= nil and type(task.spawn) == "function" then
        spawnFn = function(fn)
            return task.spawn(fn)
        end
    elseif type(spawn) == "function" then
        spawnFn = function(fn)
            return spawn(fn)
        end
    end
end)

local function safeWait(n)
    n = tonumber(n) or 0
    if n <= 0 then
        return
    end

    if taskWaitFn then
        taskWaitFn(n)
        return
    end

    if waitFn then
        waitFn(n)
        return
    end

    local start = getTime()
    repeat
        until getTime() - start >= n
end

local function safeSpawn(fn)
    if spawnFn then
        spawnFn(fn)
        return
    end

    local co = coroutine.create(fn)
    coroutine.resume(co)
end

