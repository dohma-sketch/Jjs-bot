local function newInst(className, props)
    local ok, inst = pcall(function()
        return Instance.new(className)
    end)

    if not ok or not inst then
        return nil
    end

    if props then
        for k, v in pairs(props) do
            pcall(function()
                inst[k] = v
            end)
        end
    end

    return inst
end

local function attachGui(screenGui)
    if not screenGui then
        return false
    end

    local ok1 = pcall(function()
        if type(gethui) == "function" then
            local h = gethui()
            if h then
                screenGui.Parent = h
            end
        end
    end)

    if ok1 and isInstanceValid(screenGui) then
        return true
    end

    local ok2 = pcall(function()
        screenGui.Parent = game:GetService("CoreGui")
    end)

    if ok2 and isInstanceValid(screenGui) then
        return true
    end

    local ok3 = pcall(function()
        screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end)

    if ok3 and isInstanceValid(screenGui) then
        return true
    end

    return false
end

local buildGUI

buildGUI = function()
    pcall(function()
        if isInstanceValid(Env.__MM2Gui) then
            Env.__MM2Gui:Destroy()
        end
    end)

    local guiId = (tonumber(Env.__MM2GuiId) or 0) + 1
    Env.__MM2GuiId = guiId

    local cfg = getConfig()

    local screenGui = newInst("ScreenGui", {
        Name = "MM2AutoFarmGUI",
        ResetOnSpawn = false,
        DisplayOrder = 999999
    })

    if not screenGui then
        return
    end

    if not attachGui(screenGui) then
        pcall(function()
            screenGui:Destroy()
        end)
        log("GUI parent failed")
        return
    end

    Env.__MM2Gui = screenGui

    pcall(function()
        screenGui.Enabled = cfg.GuiVisible
    end)

    local main = newInst("Frame", {
        Parent = screenGui,
        Size = UDim2.new(0, 260, 0, 420),
        Position = UDim2.new(0.5, -130, 0.5, -210),
        BackgroundColor3 = Color3.fromRGB(20, 20, 26),
        BorderSizePixel = 0
    })

    if not main then
        pcall(function()
            screenGui:Destroy()
        end)
        return
    end

    newInst("UICorner", {
        Parent = main,
        CornerRadius = UDim.new(0, 8)
    })

    local titleBar = newInst("Frame", {
        Parent = main,
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        BorderSizePixel = 0
    })

    newInst("UICorner", {
        Parent = titleBar,
        CornerRadius = UDim.new(0, 8)
    })

    newInst("TextLabel", {
        Parent = titleBar,
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "MM2 AutoFarm | RightShift",
        TextColor3 = Color3.fromRGB(230, 230, 230),
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local closeBtn = newInst("TextButton", {
        Parent = titleBar,
        Size = UDim2.new(0, 24, 0, 24),
        Position = UDim2.new(1, -28, 0, 2),
        BackgroundColor3 = Color3.fromRGB(70, 35, 35),
        Text = "X",
        TextColor3 = Color3.fromRGB(230, 230, 230),
        TextSize = 14,
        BorderSizePixel = 0
    })

    newInst("UICorner", {
        Parent = closeBtn,
        CornerRadius = UDim.new(0, 6)
    })

    local body = newInst("Frame", {
        Parent = main,
        Position = UDim2.new(0, 10, 0, 34),
        Size = UDim2.new(1, -20, 1, -44),
        BackgroundTransparency = 1
    })

    newInst("UIListLayout", {
        Parent = body,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder
    })

    local guiUpdaters = {}

    local statusLabel = newInst("TextLabel", {
        Parent = body,
        LayoutOrder = 1,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = Color3.fromRGB(28, 28, 36),
        BorderSizePixel = 0,
        Text = "",
        TextColor3 = Color3.fromRGB(210, 210, 210),
        TextSize = 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top
    })

    newInst("UICorner", {
        Parent = statusLabel,
        CornerRadius = UDim.new(0, 6)
    })

    newInst("UIPadding", {
        Parent = statusLabel,
        PaddingLeft = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 6),
        PaddingBottom = UDim.new(0, 4)
    })

    local function createButton(parent, order, text, onClick)
        local btn = newInst("TextButton", {
            Parent = parent,
            LayoutOrder = order,
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = Color3.fromRGB(45, 45, 55),
            Text = text,
            TextColor3 = Color3.fromRGB(230, 230, 230),
            TextSize = 15,
            BorderSizePixel = 0,
            AutoButtonColor = true
        })

        if btn then
            newInst("UICorner", {
                Parent = btn,
                CornerRadius = UDim.new(0, 6)
            })

            btn.MouseButton1Click:Connect(function()
                pcall(onClick)
            end)
        end

        return btn
    end

    local toggleBtn = createButton(body, 2, "Запустить", function()
        local current = getConfig()

        if current.Enabled and Env.__MM2AutoFarmActiveId ~= nil then
            Env.StopAutoFarm()
        else
            Env.StartAutoFarm()
        end
    end)

    createButton(body, 3, "Перезапустить", function()
        Env.RestartAutoFarm()
    end)

    createButton(body, 4, "Скрыть GUI", function()
        pcall(function()
            screenGui.Enabled = false
            Env.AutoFarmConfig.GuiVisible = false
        end)
    end)

    local function createSettingRow(parent, order, labelText, getCurrentText, onApply)
        local row = newInst("Frame", {
            Parent = parent,
            LayoutOrder = order,
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1
        })

        newInst("TextLabel", {
            Parent = row,
            Size = UDim2.new(1, -84, 1, 0),
            BackgroundTransparency = 1,
            Text = labelText,
            TextColor3 = Color3.fromRGB(210, 210, 210),
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left
        })

        local box = newInst("TextBox", {
            Parent = row,
            Position = UDim2.new(1, -80, 0, 0),
            Size = UDim2.new(0, 80, 1, 0),
            BackgroundColor3 = Color3.fromRGB(35, 35, 45),
            Text = getCurrentText(),
            TextColor3 = Color3.fromRGB(230, 230, 230),
            TextSize = 14,
            BorderSizePixel = 0,
            ClearTextOnFocus = false
        })

        if box then
            newInst("UICorner", {
                Parent = box,
                CornerRadius = UDim.new(0, 5)
            })

            box.FocusLost:Connect(function()
                pcall(function()
                    onApply(box.Text)
                end)

                pcall(function()
                    box.Text = getCurrentText()
                end)
            end)
        end

        return box
    end

    local maxDistBox = createSettingRow(
        body,
        5,
        "Дистанция",
        function()
            return tostring(getConfig().MaxDistance)
        end,
        function(text)
            local value = tonumber(text)
            if value then
                Env.AutoFarmConfig.MaxDistance = value
            end
            Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
        end
    )

    local delayBox = createSettingRow(
        body,
        6,
        "Задержка",
        function()
            return tostring(getConfig().TeleportDelay)
        end,
        function(text)
            local value = tonumber(text)
            if value then
                Env.AutoFarmConfig.TeleportDelay = value
            end
            Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
        end
    )

    local targetsBox = createSettingRow(
        body,
        7,
        "Целей за цикл",
        function()
            return tostring(getConfig().MaxTargetsPerCycle)
        end,
        function(text)
            local value = tonumber(text)
            if value then
                Env.AutoFarmConfig.MaxTargetsPerCycle = value
            end
            Env.AutoFarmConfig = normalizeConfig(Env.AutoFarmConfig)
        end
    )

    local function createToggleRow(parent, order, labelText, getValue, setValue)
        local row = newInst("Frame", {
            Parent = parent,
            LayoutOrder = order,
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1
        })

        newInst("TextLabel", {
            Parent = row,
            Size = UDim2.new(1, -60, 1, 0),
            BackgroundTransparency = 1,
            Text = labelText,
            TextColor3 = Color3.fromRGB(210, 210, 210),
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left
        })

        local btn = newInst("TextButton", {
            Parent = row,
            Position = UDim2.new(1, -54, 0, 0),
            Size = UDim2.new(0, 54, 1, 0),
            BackgroundColor3 = Color3.fromRGB(45, 45, 55),
            Text = getValue() and "ON" or "OFF",
            TextColor3 = Color3.fromRGB(230, 230, 230),
            TextSize = 13,
            BorderSizePixel = 0
        })

        if btn then
            newInst("UICorner", {
                Parent = btn,
                CornerRadius = UDim.new(0, 5)
            })

            btn.MouseButton1Click:Connect(function()
                pcall(function()
                    local newValue = not getValue()
                    setValue(newValue)
                    btn.Text = getValue() and "ON" or "OFF"
                end)
            end)

            guiUpdaters[#guiUpdaters + 1] = function()
                if isInstanceValid(btn) then
                    pcall(function()
                        btn.Text = getValue() and "ON" or "OFF"
                    end)
                end
            end
        end

        return btn
    end

    createToggleRow(
        body,
        8,
        "Авто-поиск контейнера",
        function()
            return getConfig().AutonomousDiscovery
        end,
        function(value)
            getConfig().AutonomousDiscovery = value
        end
    )

    createToggleRow(
        body,
        9,
        "Глубокий fallback",
        function()
            return getConfig().DeepFallback
        end,
        function(value)
            getConfig().DeepFallback = value
        end
    )

    createToggleRow(
        body,
        10,
        "Humanize delays",
        function()
            return getConfig().HumanizeDelays
        end,
        function(value)
            getConfig().HumanizeDelays = value
        end
    )

    local function addBoxUpdater(box, getCurrentText)
        guiUpdaters[#guiUpdaters + 1] = function()
            if isInstanceValid(box) then
                local ok, focused = pcall(function()
                    return box:IsFocused()
                end)

                if not (ok and focused) then
                    pcall(function()
                        box.Text = getCurrentText()
                    end)
                end
            end
        end
    end

    addBoxUpdater(maxDistBox, function()
        return tostring(getConfig().MaxDistance)
    end)

    addBoxUpdater(delayBox, function()
        return tostring(getConfig().TeleportDelay)
    end)

    addBoxUpdater(targetsBox, function()
        return tostring(getConfig().MaxTargetsPerCycle)
    end)

    guiUpdaters[#guiUpdaters + 1] = function()
        if isInstanceValid(toggleBtn) then
            local current = getConfig()
            local running = current.Enabled and Env.__MM2AutoFarmActiveId ~= nil

            pcall(function()
                toggleBtn.Text = running and "Остановить" or "Запустить"
                toggleBtn.BackgroundColor3 = running
                    and Color3.fromRGB(95, 40, 45)
                    or Color3.fromRGB(35, 85, 50)
            end)
        end
    end

    guiUpdaters[#guiUpdaters + 1] = function()
        if isInstanceValid(statusLabel) then
            local current = getConfig()
            local running = current.Enabled and Env.__MM2AutoFarmActiveId ~= nil

            local err = tostring(Env.__MM2Stats.LastError or "")
            if #err > 35 then
                err = string.sub(err, 1, 35) .. "..."
            end

            pcall(function()
                statusLabel.Text = string.format(
                    "Статус: %s | Контейнер: %s\nОбъектов рядом: %s\nОшибка: %s",
                    running and "ВКЛ" or "ВЫКЛ",
                    tostring(Env.__MM2Stats.Container or "нет"),
                    tostring(Env.__MM2Stats.LastCoins or 0),
                    err
                )
            end)
        end
    end

    -- Drag
    pcall(function()
        local dragging = false
        local dragStart = nil
        local startPos = nil

        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = main.Position
            end
        end)

        titleBar.InputChanged:Connect(function(input)
            if dragging and (
                input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch
            ) then
                local delta = input.Position - dragStart
                main.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end)

        titleBar.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end)

    -- Close / hide
    if closeBtn then
        closeBtn.MouseButton1Click:Connect(function()
            pcall(function()
                screenGui.Enabled = false
                Env.AutoFarmConfig.GuiVisible = false
            end)
        end)
    end

    -- Keybind
    if Env.__MM2KeyConnection then
        pcall(function()
            Env.__MM2KeyConnection:Disconnect()
        end)
        Env.__MM2KeyConnection = nil
    end

    if UIS then
        pcall(function()
            Env.__MM2KeyConnection = UIS.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed then
                    return
                end

                local okKey, isKey = pcall(function()
                    return input.KeyCode == Enum.KeyCode.RightShift
                end)

                if okKey and isKey then
                    if isInstanceValid(Env.__MM2Gui) then
                        pcall(function()
                            local newState = not Env.__MM2Gui.Enabled
                            Env.__MM2Gui.Enabled = newState
                            Env.AutoFarmConfig.GuiVisible = newState
                        end)
                    else
                        pcall(buildGUI)
                    end
                end
            end)
        end)
    end

    -- GUI update loop
    safeSpawn(function()
        while Env.__MM2GuiId == guiId do
            if not isInstanceValid(screenGui) then
                break
            end

            for i = 1, #guiUpdaters do
                pcall(guiUpdaters[i])
            end

            safeWait(0.35)
        end
    end)

    -- GUI auto-recreate watchdog
    safeSpawn(function()
        while Env.__MM2GuiId == guiId do
            safeWait(1)

            local current = getConfig()

            if current.GuiAutoRecreate
                and Env.__MM2GuiId == guiId
                and not isInstanceValid(Env.__MM2Gui) then
                pcall(buildGUI)
                break
            end
        end
    end)
end

Env.ShowMM2GUI = function()
    if isInstanceValid(Env.__MM2Gui) then
        pcall(function()
            Env.__MM2Gui.Enabled = true
            Env.AutoFarmConfig.GuiVisible = true
        end)
    else
        pcall(buildGUI)
    end
end

Env.HideMM2GUI = function()
    if isInstanceValid(Env.__MM2Gui) then
        pcall(function()
            Env.__MM2Gui.Enabled = false
            Env.AutoFarmConfig.GuiVisible = false
        end)
    end
end

Env.ToggleMM2GUI = function()
    if isInstanceValid(Env.__MM2Gui) then
        pcall(function()
            local newState = not Env.__MM2Gui.Enabled
            Env.__MM2Gui.Enabled = newState
            Env.AutoFarmConfig.GuiVisible = newState
        end)
    else
        pcall(buildGUI)
    end
end

