-- ==========================
-- Утилиты
-- ==========================
local function isInstanceValid(inst)
    if inst == nil then
        return false
    end

    local ok, valid = pcall(function()
        return inst.Parent ~= nil
    end)

    return ok and valid == true
end

local function log(msg)
    if Config.Debug then
        print("[MM2 Fly] " .. tostring(msg))
    end
end

local function updateStatus(text)
    State.Status = tostring(text or "Idle")
    if type(Env.__MM2FlyStatusChanged) == "function" then
        pcall(Env.__MM2FlyStatusChanged, State.Status)
    end
end

-- ==========================
-- Полёт / движение
-- ==========================
local flight = {
    root = nil,
    bv = nil,
    bg = nil
}

local function clearFlight()
    pcall(function()
        if flight.bv then
            flight.bv:Destroy()
        end
    end)

    pcall(function()
        if flight.bg then
            flight.bg:Destroy()
        end
    end)

    flight.bv = nil
    flight.bg = nil
    flight.root = nil
end

local function stopVelocity()
    pcall(function()
        if flight.bv then
            flight.bv.Velocity = Vector3.new(0, 0, 0)
        end
    end)
end

local function ensureFlight(root)
    if flight.root ~= root then
        clearFlight()
    end

    if not isInstanceValid(root) then
        return
    end

    if flight.bv and not isInstanceValid(flight.bv) then
        flight.bv = nil
    end

    if flight.bg and not isInstanceValid(flight.bg) then
        flight.bg = nil
    end

    if not flight.bv then
        pcall(function()
            local old = root:FindFirstChild("MM2FlyVelocity")
            if old then
                old:Destroy()
            end

            local bv = Instance.new("BodyVelocity")
            bv.Name = "MM2FlyVelocity"
            bv.MaxForce = Vector3.new(1000000, 1000000, 1000000)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = root

            flight.bv = bv
        end)
    end

    if Config.UseBodyGyro and not flight.bg then
        pcall(function()
            local old = root:FindFirstChild("MM2FlyGyro")
            if old then
                old:Destroy()
            end

            local bg = Instance.new("BodyGyro")
            bg.Name = "MM2FlyGyro"
            bg.MaxTorque = Vector3.new(1000000, 1000000, 1000000)
            bg.P = 10000
            bg.D = 500
            bg.CFrame = root.CFrame
            bg.Parent = root

            flight.bg = bg
        end)
    end

    flight.root = root
end

-- ==========================
-- Сброс состояния
-- ==========================
local lastResetTime = 0

local function resetRoundState(reason, pause)
    reason = tostring(reason or "Unknown")

    if reason ~= "Manual" and not Config.AutoRoundReset then
        return
    end

    local now = getTime()

    if reason ~= "Manual" and now - lastResetTime < 0.35 then
        return
    end

    lastResetTime = now

    State.CurrentTarget = nil
    State.TargetChangedTime = 0

    State.Waypoints = nil
    State.WaypointIndex = 1
    State.LastPathTime = 0

    State.LastCoinScan = 0
    State.CoinCache = {}

    State.Blacklist = setmetatable({}, { __mode = "k" })

    State.LastDistance = nil
    State.StuckTime = 0

    State.PauseUntil = getTime() + (tonumber(pause) or Config.ResetDelay)

    stopVelocity()
    updateStatus("Reset: " .. reason)
    log("Reset state: " .. reason)
end

-- ==========================
-- Поиск монет
-- ==========================
local containerCache = nil
local lastContainerCheck = 0

local function getCoinContainer()
    local now = getTime()

    if isInstanceValid(containerCache) and now - lastContainerCheck < 5 then
        return containerCache
    end

    lastContainerCheck = now
    containerCache = nil

    local roots = { Workspace }

    local possibleRootNames = {
        "Map",
        "Maps",
        "Game",
        "Gameplay",
        "CoinContainers"
    }

    for _, rootName in ipairs(possibleRootNames) do
        local ok, root = pcall(function()
            return Workspace:FindFirstChild(rootName)
        end)

        if ok and root then
            roots[#roots + 1] = root
        end
    end

    local names = Config.ContainerNames
    if type(names) ~= "table" then
        names = { "CoinContainer", "Coins" }
    end

    for _, root in ipairs(roots) do
        for i = 1, #names do
            local name = names[i]

            if type(name) == "string" then
                local ok, found = pcall(function()
                    return root:FindFirstChild(name)
                end)

                if ok and found then
                    containerCache = found
                    return found
                end
            end
        end
    end

    return nil
end

local function getTargetPart(obj)
    if obj == nil then
        return nil
    end

    local ok, part = pcall(function()
        if not obj.Parent then
            return nil
        end

        if obj:IsA("BasePart") then
            return obj
        end

        if obj:IsA("Model") then
            local primary = obj.PrimaryPart
            if primary and primary.Parent then
                return primary
            end

            local children = obj:GetChildren()
            for i = 1, #children do
                local child = children[i]
                if child:IsA("BasePart") then
                    return child
                end
            end

            return nil
        end

        local base = obj:FindFirstChild("BasePart")
        if base and base:IsA("BasePart") then
            return base
        end

        local children = obj:GetChildren()
        for i = 1, #children do
            local child = children[i]
            if child:IsA("BasePart") then
                return child
            end
        end

        return nil
    end)

    if ok and isInstanceValid(part) then
        return part
    end

    return nil
end

local function scanCoinParts(obj, out, depth)
    if #out >= Config.MaxScanParts then
        return
    end

    if depth > Config.ScanDepth then
        return
    end

    if not isInstanceValid(obj) then
        return
    end

    pcall(function()
        if depth > 0 then
            if obj:IsA("BasePart") then
                out[#out + 1] = obj
                return
            end

            if obj:IsA("Model") then
                local target = getTargetPart(obj)
                if target then
                    out[#out + 1] = target
                    return
                end
            end
        end

        local children = obj:GetChildren()
        for i = 1, #children do
            if #out >= Config.MaxScanParts then
                break
            end

            scanCoinParts(children[i], out, depth + 1)
        end
    end)
end

local function getTaggedCoins()
    local out = {}

    local tags = {
        "Coin",
        "Coins",
        "CoinPickup",
        "PickupCoin",
        "MM2Coin",
        "Currency"
    }

    for _, tag in ipairs(tags) do
        local ok, objs = pcall(function()
            return CollectionService:GetTagged(tag)
        end)

        if ok and type(objs) == "table" then
            for i = 1, #objs do
                if #out >= Config.MaxScanParts then
                    return out
                end

                local obj = objs[i]

                if isInstanceValid(obj) then
                    pcall(function()
                        if obj:IsA("BasePart") then
                            out[#out + 1] = obj
                        elseif obj:IsA("Model") then
                            local part = getTargetPart(obj)
                            if part then
                                out[#out + 1] = part
                            end
                        end
                    end)
                end
            end
        end
    end

    return out
end

local function refreshCoinCache(force)
    local now = getTime()

    if not force and now - State.LastCoinScan < Config.CoinScanDelay then
        return
    end

    local parts = {}
    local container = getCoinContainer()

    if container then
        scanCoinParts(container, parts, 0)
    end

    if #parts == 0 then
        parts = getTaggedCoins()
    end

    State.CoinCache = parts
    State.LastCoinScan = now
end

-- ==========================
-- Чёрный список / застревание
-- ==========================
local function isBlacklisted(part)
    local untilTime = State.Blacklist[part]

    if untilTime and untilTime > getTime() then
        return true
    end

    State.Blacklist[part] = nil
    return false
end

local function blacklistPart(part, duration)
    if part == nil then
        return
    end

    State.Blacklist[part] = getTime() + (tonumber(duration) or 5)
end

-- ==========================
-- Выбор цели
-- ==========================
local function getBestTarget(root)
    if State.CurrentTarget and isInstanceValid(State.CurrentTarget) and not isBlacklisted(State.CurrentTarget) then
        local ok, dist = pcall(function()
            return (State.CurrentTarget.Position - root.Position).Magnitude
        end)

        if ok and dist <= Config.MaxTargetDistance then
            return State.CurrentTarget
        end
    end

    refreshCoinCache(false)

    local best = nil
    local bestDist = math.huge

    local okRootPos, rootPos = pcall(function()
        return root.Position
    end)

    if not okRootPos then
        return nil
    end

    for i = 1, #State.CoinCache do
        local part = State.CoinCache[i]

        if isInstanceValid(part) and not isBlacklisted(part) then
            local okDist, dist = pcall(function()
                return (part.Position - rootPos).Magnitude
            end)

            if okDist and dist <= Config.MaxTargetDistance and dist < bestDist then
                best = part
                bestDist = dist
            end
        end
    end

    if best ~= State.CurrentTarget then
        State.CurrentTarget = best
        State.TargetChangedTime = getTime()

        State.Waypoints = nil
        State.WaypointIndex = 1
        State.LastPathTime = 0

        State.LastDistance = nil
        State.StuckTime = 0
    end

    return best
end

-- ==========================
-- Pathfinding
-- ==========================
local function computePathAsync(startPos, goalPos)
    local ok, result = pcall(function()
        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = false
        })

        path:ComputeAsync(startPos, goalPos)

        if path.Status == Enum.PathStatus.Success then
            return path:GetWaypoints()
        end

        return nil
    end)

    if ok and result then
        return result
    end

    return nil
end

local function maybeUpdatePath(root, targetPos)
    if not Config.UsePathfinding then
        State.Waypoints = nil
        return
    end

    local now = getTime()

    if now - State.LastPathTime < Config.PathRefresh then
        return
    end

    State.LastPathTime = now

    local waypoints = computePathAsync(root.Position, targetPos)

    if waypoints and #waypoints > 0 then
        State.Waypoints = waypoints
        State.WaypointIndex = 2
        State.LastDistance = nil
        State.StuckTime = 0
    else
        State.Waypoints = nil
    end
end

-- ==========================
-- Основной цикл полёта
-- ==========================
local function movementLoop()
    while session.Active do
        safeWait(0.05)

        pcall(function()
            if not State.Enabled or getTime() < State.PauseUntil then
                stopVelocity()

                if getTime() < State.PauseUntil then
                    updateStatus("Paused after reset")
                end

                return
            end

            local character = LocalPlayer.Character
            if not isInstanceValid(character) then
                clearFlight()
                updateStatus("Waiting for character")
                return
            end

            local humanoid = character:FindFirstChild("Humanoid")
            if not isInstanceValid(humanoid) then
                clearFlight()
                updateStatus("No humanoid")
                return
            end

            local okAlive, alive = pcall(function()
                return humanoid:IsA("Humanoid") and humanoid.Health > 0
            end)

            if not okAlive or not alive then
                clearFlight()
                updateStatus("Dead / waiting respawn")
                return
            end

            local root = character:FindFirstChild("HumanoidRootPart")
            if not isInstanceValid(root) then
                clearFlight()
                updateStatus("No HumanoidRootPart")
                return
            end

            ensureFlight(root)

            local target = getBestTarget(root)

            if not target then
                stopVelocity()
                updateStatus("No coins found")
                return
            end

            local okTargetPos, targetPos = pcall(function()
                return target.Position + Vector3.new(0, Config.HoverY, 0)
            end)

            if not okTargetPos then
                State.CurrentTarget = nil
                stopVelocity()
                return
            end

            maybeUpdatePath(root, targetPos)

            local goalPos = targetPos

            if Config.UsePathfinding and State.Waypoints and State.WaypointIndex <= #State.Waypoints then
                local wp = State.Waypoints[State.WaypointIndex]

                if wp and wp.Position then
                    goalPos = wp.Position + Vector3.new(0, Config.HoverY, 0)
                end

                local okWpDist, wpDist = pcall(function()
                    return (goalPos - root.Position).Magnitude
                end)

                if okWpDist and wpDist < 4 then
                    State.WaypointIndex = State.WaypointIndex + 1
                    State.LastDistance = nil
                    State.StuckTime = 0
                end
            end

            local okOffset, offset = pcall(function()
                return goalPos - root.Position
            end)

            if not okOffset then
                stopVelocity()
                return
            end

            local dist = offset.Magnitude

            if State.LastDistance and dist >= State.LastDistance - 0.2 then
                State.StuckTime = State.StuckTime + 0.05
            else
                State.StuckTime = 0
            end

            State.LastDistance = dist

            if State.StuckTime > 5 then
                blacklistPart(target, 8)
                State.CurrentTarget = nil
                State.Waypoints = nil
                State.LastDistance = nil
                State.StuckTime = 0
                stopVelocity()
                updateStatus("Target blacklisted: stuck")
                return
            end

            if dist < Config.StopDistance then
                if State.StuckTime > 2 then
                    blacklistPart(target, 6)
                    State.CurrentTarget = nil
                    State.Waypoints = nil
                    State.LastDistance = nil
                    State.StuckTime = 0
                    stopVelocity()
                    updateStatus("Coin unreachable, blacklisted")
                    return
                end

                if dist > 0.05 then
                    pcall(function()
                        if flight.bv then
                            flight.bv.Velocity = offset.Unit * math.min(8, Config.FlySpeed * 0.25)
                        end
                    end)
                else
                    stopVelocity()
                end

                updateStatus("Collecting coin")
                return
            end

            local speed = clampNumber(Config.FlySpeed, 8, 200)
            local velocity = offset.Unit * math.min(speed, dist * 3)

            pcall(function()
                if flight.bv then
                    flight.bv.Velocity = velocity
                end

                if flight.bg then
                    flight.bg.CFrame = CFrame.new(root.Position, goalPos)
                end
            end)

            updateStatus(string.format("Flying to coin: %.0f studs", dist))
        end)
    end

    clearFlight()
end

-- ==========================
-- Remotes: сброс на раунд
-- ==========================
local serviceMap = {
    ReplicatedStorage = ReplicatedStorage,
    Workspace = Workspace
}

pcall(function()
    serviceMap.ReplicatedFirst = game:GetService("ReplicatedFirst")
end)

local function resolvePath(path)
    if type(path) ~= "string" then
        return nil
    end

    local first, rest = path:match("^([%w_]+)%.(.*)$")

    if not first then
        return nil
    end

    local current = serviceMap[first] or game:FindFirstChild(first)

    if not current then
        return nil
    end

    if not rest or rest == "" then
        return current
    end

    for name in rest:gmatch("[^%.]+") do
        local ok, child = pcall(function()
            return current:FindFirstChild(name)
        end)

        if not ok or not child then
            return nil
        end

        current = child
    end

    return current
end

local connectedRemotes = {}

local function connectRemote(path, callback)
    if connectedRemotes[path] then
        return true
    end

    local remote = resolvePath(path)

    if not remote then
        return false
    end

    local okIs, isEvent = pcall(function()
        return remote:IsA("RemoteEvent")
    end)

    if okIs and isEvent then
        local okConnect, con = pcall(function()
            return remote.OnClientEvent:Connect(callback)
        end)

        if okConnect and con then
            addConnection(con)
        end
    end

    connectedRemotes[path] = true
    return true
end

local remotesToConnect = {
    {
        path = "ReplicatedStorage.Remotes.Gameplay.RoundStart",
        fn = function(...)
            resetRoundState("RoundStart", Config.ResetDelay)
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.LoadingMap",
        fn = function(...)
            resetRoundState("LoadingMap", 3.5)
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.RoleSelect",
        fn = function(role, ...)
            if type(role) == "string" then
                resetRoundState("RoleSelect", Config.ResetDelay)
            end
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.GameOver",
        fn = function(...)
            resetRoundState("GameOver", 2.5)
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.VictoryScreen",
        fn = function(...)
            resetRoundState("VictoryScreen", 2.5)
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.RoundEndFade",
        fn = function(...)
            resetRoundState("RoundEndFade", 2.0)
        end
    },
    {
        path = "ReplicatedStorage.Remotes.Gameplay.CoinsStarted",
        fn = function(...)
            State.PauseUntil = 0
            State.CoinCache = {}
            State.LastCoinScan = 0
            updateStatus("Coins started")
        end
    }
}

local function startRemoteWatcher()
    safeSpawn(function()
        while session.Active do
            local allConnected = true

            for _, remoteInfo in ipairs(remotesToConnect) do
                if not connectedRemotes[remoteInfo.path] then
                    if not connectRemote(remoteInfo.path, remoteInfo.fn) then
                        allConnected = false
                    end
                end
            end

            if allConnected then
                log("All tracked remotes connected/found")
                break
            end

            safeWait(2)
        end
    end)
end

