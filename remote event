local function SerializeArg(arg, depth)
    depth = depth or 0
    if depth > 2 then return "..." end
    local t = type(arg)
    if t == "nil" then return "nil"
    elseif t == "boolean" then return tostring(arg)
    elseif t == "number" then return tostring(arg)
    elseif t == "string" then
        if #arg > 50 then return '"' .. string.sub(arg, 1, 50) .. '..."' end
        return '"' .. arg .. '"'
    elseif t == "table" then
        local items = {}
        local count = 0
        for k, v in pairs(arg) do
            count = count + 1
            if count > 5 then items[#items + 1] = "..." break end
            items[#items + 1] = tostring(k) .. "=" .. SerializeArg(v, depth + 1)
        end
        return "{" .. table.concat(items, ", ") .. "}"
    elseif t == "userdata" then
        local ok, name = pcall(function() return arg.Name end)
        if ok and name then return "Instance<" .. tostring(name) .. ">" end
        return "userdata"
    else
        return t
    end
end

local function SerializeArgs(args, max)
    max = max or CONFIG.MaxLogArgs
    local parts = {}
    for i = 1, math.min(#args, max) do
        parts[#parts + 1] = SerializeArg(args[i])
    end
    if #args > max then
        parts[#parts + 1] = "... +" .. (#args - max) .. " more"
    end
    return "(" .. table.concat(parts, ", ") .. ")"
end

local function ShouldIgnore(remoteName)
    if not remoteName then return true end
    for _, ignore in pairs(CONFIG.IgnoreNames) do
        if string.find(remoteName, ignore, 1, true) then return true end
    end
    return false
end

local function GetClassName(instance)
    local ok, cn = pcall(function() return instance.ClassName end)
    if ok then return cn end
    return nil
end

local function SafeGetName(instance)
    local ok, name = pcall(function() return instance.Name end)
    if ok and name then return tostring(name) end
    return tostring(instance)
end

local function SetClipboard(text)
    if type(setclipboard) == "function" then
        pcall(function() setclipboard(text) end)
        return true
    end
    local ok, GuiService = pcall(function() return game:GetService("GuiService") end)
    if ok and GuiService then
        pcall(function() GuiService:SetClipboard(text) end)
        return true
    end
    if type(writefile) == "function" then
        pcall(function() writefile("JJS_Remote_Export.txt", text) end)
        return true
    end
    return false
end

