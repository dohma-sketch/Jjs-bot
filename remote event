-- UPDATE
local function since(t)
    if t == 0 then return "-" end
    return string.format("%.2fs", time() - t)
end

local function setLine(lbl, active, activeText, color)
    if active then
        lbl.Text = activeText
        lbl.TextColor3 = color
    else
        lbl.Text = string.gsub(lbl.Name or "", "", "") .. "-"
        lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
end

local function updateLabels()
    pcall(function()
        local target = getTarget()
        local now = time()
        statusLbl.Text = "Status: running | target: " .. (target and target.Name or "-")

        local atk = false
        if target and Feed.attack.char == target and (now - Feed.attack.time) < 1 then
            atk = true
        end
        if atk then
            attackLbl.Text = "Attack: " .. tostring(Feed.attack.kind) .. " | " .. since(Feed.attack.time)
            attackLbl.TextColor3 = Color3.fromRGB(255, 120, 120)
        else
            attackLbl.Text = "Attack: -"
            attackLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        local blocking = false
        if target then
            if Feed.block.char == target and (now - Feed.block.start) < 1.2 then blocking = true end
            if IsBlockingScan(target) then blocking = true end
        end
        if blocking then
            blockLbl.Text = "Block: ACTIVE"
            blockLbl.TextColor3 = Color3.fromRGB(120, 200, 255)
        else
            blockLbl.Text = "Block: -"
            blockLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        local dashing = false
        if target then
            if Feed.dash.char == target and (now - Feed.dash.time) < 0.5 then dashing = true end
            if IsDashingScan(target) then dashing = true end
        end
        if dashing then
            dashLbl.Text = "Dash: ACTIVE"
            dashLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            dashLbl.Text = "Dash: -"
            dashLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        local awakened = false
        if target then
            if Feed.awaken.char == target and (now - Feed.awaken.time) < 5 then awakened = true end
            if IsAwakenedScan(target) then awakened = true end
        end
        if awakened then
            awakenLbl.Text = "Awaken: ACTIVE"
            awakenLbl.TextColor3 = Color3.fromRGB(255, 100, 255)
        else
            awakenLbl.Text = "Awaken: -"
            awakenLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        local sk = false
        if target and Feed.skill.char == target and Feed.skill.service and (now - Feed.skill.time) < 3 then
            sk = true
        end
        if sk then
            skillLbl.Text = "Last skill: " .. Feed.skill.service .. " | " .. since(Feed.skill.time)
            skillLbl.TextColor3 = Color3.fromRGB(180, 255, 180)
        else
            skillLbl.Text = "Last skill: -"
            skillLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        eventLbl.Text = "Last event: [" .. Feed.last.cat .. "] " .. Feed.last.service .. " / " .. Feed.last.effect
    end)
end

RunService.Heartbeat:Connect(updateLabels)

-- SNAPSHOT (построчная склейка, без длинных скобок)
CopyBtn.MouseButton1Click:Connect(function()
    pcall(function()
        local target = getTarget()
        local now = time()

        local blocking = false
        local awakened = false
        local dashing = false
        if target then
            blocking = (Feed.block.char == target and (now - Feed.block.start) < 1.2) or IsBlockingScan(target)
            awakened = (Feed.awaken.char == target and (now - Feed.awaken.time) < 5) or IsAwakenedScan(target)
            dashing = (Feed.dash.char == target and (now - Feed.dash.time) < 0.5) or IsDashingScan(target)
        end

        local snap = "JJS Combat Snapshot " .. os.date() .. "\n"
        snap = snap .. "Target: " .. (target and target.Name or "-") .. "\n"
        snap = snap .. "Attack: " .. since(Feed.attack.time) .. " ago, kind=" .. tostring(Feed.attack.kind) .. "\n"
        snap = snap .. "Skill: " .. since(Feed.skill.time) .. " ago, service=" .. tostring(Feed.skill.service) .. "\n"
        snap = snap .. "Dash: active=" .. tostring(dashing) .. ", " .. since(Feed.dash.time) .. " ago\n"
        snap = snap .. "Block: active=" .. tostring(blocking) .. "\n"
        snap = snap .. "Awaken: active=" .. tostring(awakened) .. "\n"
        snap = snap .. "LastEvent: [" .. Feed.last.cat .. "] " .. Feed.last.service .. " / " .. Feed.last.effect .. "\n"
        snap = snap .. "Connected remotes: " .. connectedCount

        if type(setclipboard) == "function" then
            setclipboard(snap)
            CopyBtn.Text = "Copied!"
        elseif type(writefile) == "function" then
            writefile("JJS_Snapshot.txt", snap)
            CopyBtn.Text = "Saved to file"
        else
            CopyBtn.Text = "No clipboard access"
            return
        end

        wait(1.5)
        CopyBtn.Text = "Copy snapshot to clipboard"
    end)
end)

