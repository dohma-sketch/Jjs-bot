-- UPDATE LOOP
-- ============================================================

local function getTargetName()
    local char = LocalPlayer.Character
    if not char then return "-" end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return "-" end
    local best = nil
    local bestDist = 50
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local d = (tr.Position - root.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = plr.Character
                end
            end
        end
    end
    return best and best.Name or "-"
end

local function updateLabels()
    pcall(function()
        statusLbl.Text = "Status: running | target: " .. getTargetName()

        local now = time()
        local targetChar = nil
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local bestD = 50
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local tr = plr.Character:FindFirstChild("HumanoidRootPart")
                        if tr then
                            local d = (tr.Position - root.Position).Magnitude
                            if d < bestD then
                                bestD = d
                                targetChar = plr.Character
                            end
                        end
                    end
                end
            end
        end

        local function since(t)
            if t == 0 then return "-" end
            return string.format("%.2fs ago", now - t)
        end

        local function isTarget(char)
            return char == targetChar
        end

        if Feed.attack.char == targetChar and Feed.attack.time > 0 then
            attackLbl.Text = "Attack: " .. Feed.attack.kind .. " | " .. since(Feed.attack.time)
            attackLbl.TextColor3 = Color3.fromRGB(255, 120, 120)
        else
            attackLbl.Text = "Attack: -"
            attackLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        if Feed.block.char == targetChar and Feed.block.active then
            blockLbl.Text = "Block: ACTIVE"
            blockLbl.TextColor3 = Color3.fromRGB(120, 200, 255)
        else
            blockLbl.Text = "Block: " .. since(Feed.block.stop)
            blockLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        if Feed.dash.char == targetChar and Feed.dash.time > 0 and now - Feed.dash.time < 1 then
            dashLbl.Text = "Dash: " .. tostring(Feed.dash.dir) .. " | " .. since(Feed.dash.time)
            dashLbl.TextColor3 = Color3.fromRGB(255, 200, 100)
        else
            dashLbl.Text = "Dash: -"
            dashLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        if Feed.awaken.char == targetChar and Feed.awaken.time > 0 and now - Feed.awaken.time < 10 then
            awakenLbl.Text = "Awaken: ACTIVE"
            awakenLbl.TextColor3 = Color3.fromRGB(255, 100, 255)
        else
            awakenLbl.Text = "Awaken: -"
            awakenLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end

        if Feed.skill.char == targetChar and Feed.skill.service then
            skillLbl.Text = "Last skill: " .. Feed.skill.service .. " | " .. since(Feed.skill.time)
            skillLbl.TextColor3 = Color3.fromRGB(180, 255, 180)
        else
            skillLbl.Text = "Last skill: -"
            skillLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end)
end

