-- MAIN GUI CONTROLLER
-- ============================================================

local RemoteInterceptorGUI = {}
local GUI = nil
local LogScroll = nil
local CurrentTab = "Remotes"
local IsRunning = false
local CurrentMode = "discover"

function RemoteInterceptorGUI:Init()
    GUI = CreateGUI()
    
    -- Начальный рендер
    RenderRemotesList(GUI.ContentPanel, {})
    
    -- Обработчики вкладок
    local function SwitchTab(tabName)
        CurrentTab = tabName
        
        -- Сброс стилей всех вкладок
        local tabs = {GUI.RemotesTab, GUI.StatsTab, GUI.MappingsTab, GUI.LogTab}
        for _, tab in pairs(tabs) do
            tab.BackgroundColor3 = GUI_CONFIG.PanelColor
            tab.TextColor3 = GUI_CONFIG.TextColor
        end
        
        -- Активная вкладка
        local activeTab = nil
        if tabName == "Remotes" then activeTab = GUI.RemotesTab
        elseif tabName == "Stats" then activeTab = GUI.StatsTab
        elseif tabName == "Mappings" then activeTab = GUI.MappingsTab
        elseif tabName == "Log" then activeTab = GUI.LogTab end
        
        if activeTab then
            activeTab.BackgroundColor3 = GUI_CONFIG.AccentColor
            activeTab.TextColor3 = Color3.new(1, 1, 1)
        end
        
        -- Рендер контента
        if tabName == "Remotes" then
            RenderRemotesList(GUI.ContentPanel, DiscoveredRemotes)
        elseif tabName == "Stats" then
            RenderStats(GUI.ContentPanel, RemoteStats)
        elseif tabName == "Mappings" then
            local inputs = RenderMappings(GUI.ContentPanel, CONFIG.EventMap)
            
            -- Обработчик добавления маппинга
            if inputs and inputs.AddBtn then
                inputs.AddBtn.MouseButton1Click:Connect(function()
                    local name = inputs.NameInput.Text
                    local type_ = inputs.TypeInput.Text
                    
                    if name ~= "" and type_ ~= "" then
                        CONFIG.EventMap[name] = {
                            type = type_,
                            argIndex = 1,
                        }
                        AddLogEntry(LogScroll, "Added mapping: " .. name .. " → " .. type_, 
                            Color3.fromRGB(100, 255, 100))
                        RenderMappings(GUI.ContentPanel, CONFIG.EventMap)
                    end
                end)
            end
        elseif tabName == "Log" then
            if not LogScroll then
                LogScroll = RenderLog(GUI.ContentPanel)
            else
                ClearContent(GUI.ContentPanel)
                LogScroll.Parent = GUI.ContentPanel
            end
        end
    end

    GUI.RemotesTab.MouseButton1Click:Connect(function() SwitchTab("Remotes") end)
    GUI.StatsTab.MouseButton1Click:Connect(function() SwitchTab("Stats") end)
    GUI.MappingsTab.MouseButton1Click:Connect(function() SwitchTab("Mappings") end)
    GUI.LogTab.MouseButton1Click:Connect(function() SwitchTab("Log") end)

    -- Переключаем на первую вкладку
    SwitchTab("Remotes")

    -- Обработчики кнопок
    GUI.CloseBtn.MouseButton1Click:Connect(function()
        GUI.ScreenGui:Destroy()
        RemoteInterceptorGUI:Cleanup()
    end)

    GUI.StartStopBtn.MouseButton1Click:Connect(function()
        if IsRunning then
            RemoteInterceptor:Stop()
            IsRunning = false
            GUI.StartStopBtn.Text = "Start"
            GUI.StartStopBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
            AddLogEntry(LogScroll, "Interceptor stopped", Color3.fromRGB(255, 100, 100))
        else
            RemoteInterceptor:Start()
            IsRunning = true
            GUI.StartStopBtn.Text = "Stop"
            GUI.StartStopBtn.BackgroundColor3 = Color3.fromRGB(220, 80, 50)
            AddLogEntry(LogScroll, "Interceptor started (mode: " .. CurrentMode .. ")", 
                Color3.fromRGB(100, 255, 100))
        end
    end)

    GUI.ExportBtn.MouseButton1Click:Connect(function()
        RemoteInterceptor:ExportAllToClipboard()
        AddLogEntry(LogScroll, "Exported all data to clipboard", 
            Color3.fromRGB(100, 200, 255))
    end)

    GUI.ClearBtn.MouseButton1Click:Connect(function()
        RemoteStats = {}
        LastLogTime = {}
        if LogScroll then
            for _, child in pairs(LogScroll:GetChildren()) do
                if child:IsA("TextLabel") then child:Destroy() end
            end
        end
        AddLogEntry(LogScroll, "Stats and log cleared", Color3.fromRGB(255, 200, 100))
    end)

    GUI.ModeBtn.MouseButton1Click:Connect(function()
        if CurrentMode == "discover" then
            CurrentMode = "produce"
            CONFIG.Mode = "produce"
            GUI.ModeBtn.Text = "Mode: produce"
            GUI.ModeBtn.BackgroundColor3 = Color3.fromRGB(80, 150, 80)
        else
            CurrentMode = "discover"
            CONFIG.Mode = "discover"
            GUI.ModeBtn.Text = "Mode: discover"
            GUI.ModeBtn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
        end
        AddLogEntry(LogScroll, "Mode switched to: " .. CurrentMode, 
            Color3.fromRGB(255, 200, 100))
    end)

    AddLogEntry(LogScroll, "GUI initialized. Click Start to begin.", 
        Color3.fromRGB(200, 200, 200))
end

function RemoteInterceptorGUI:AddLog(message, color)
    if LogScroll then
        AddLogEntry(LogScroll, message, color)
    end
end

function RemoteInterceptorGUI:Cleanup()
    if GUI and GUI.ScreenGui then
        GUI.ScreenGui:Destroy()
    end
    RemoteInterceptor:Stop()
end

