local function LogDebug(msg)
    msg = tostring(msg)

    if CONFIG.LogToConsole then
        local now = time()
        if now - LastResetTime >= 1 then
            LogCount = 0
            LastResetTime = now
        end
        LogCount = LogCount + 1
        if LogCount <= CONFIG.MaxLogsPerSecond then
            print("[JJS REMOTE] " .. msg)
        end
    end

    if GuiLogScroll then
        pcall(function()
            local Entry = Instance.new("TextLabel")
            Entry.Size = UDim2.new(1, -10, 0, 16)
            Entry.BackgroundTransparency = 1
            Entry.Text = msg
            Entry.TextColor3 = Color3.fromRGB(200, 200, 200)
            Entry.TextSize = 10
            Entry.Font = Enum.Font.Code
            Entry.TextXAlignment = Enum.TextXAlignment.Left
            Entry.TextTruncate = Enum.TextTruncate.AtEnd
            Entry.LayoutOrder = time() * 1000
            Entry.Parent = GuiLogScroll

            local Layout = GuiLogScroll:FindFirstChild("LogLayout")
            if Layout then
                GuiLogScroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
            end

            local children = GuiLogScroll:GetChildren()
            local count = 0
            for _, c in pairs(children) do
                if c:IsA("TextLabel") then count = count + 1 end
            end
            if count > 80 then
                local oldest = nil
                local oldestOrder = math.huge
                for _, c in pairs(children) do
                    if c:IsA("TextLabel") and c.LayoutOrder < oldestOrder then
                        oldest = c
                        oldestOrder = c.LayoutOrder
                    end
                end
                if oldest then oldest:Destroy() end
            end

            GuiLogScroll.CanvasPosition = Vector2.new(0, GuiLogScroll.CanvasSize.Y.Offset)
        end)
    end
end

