local function ClearContent(panel)
    for _, child in pairs(panel:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("ScrollingFrame") then
            child:Destroy()
        end
    end
end

local function RenderRemotesList(panel, remotes)
    ClearContent(panel)

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, 0, 1, 0)
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.ScrollBarThickness = 6
    Scroll.CanvasSize = UDim2.new(0, 0, 0, #remotes * 30 + 10)
    Scroll.Parent = panel

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 2)
    Layout.Parent = Scroll

    for i, remoteInfo in pairs(remotes) do
        local Item = Instance.new("Frame")
        Item.Size = UDim2.new(1, -10, 0, 25)
        Item.BackgroundColor3 = GUI_CONFIG.BgColor
        Item.BorderSizePixel = 0
        Item.Parent = Scroll

        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 3)
        ItemCorner.Parent = Item

        local TypeLabel = Instance.new("TextLabel")
        TypeLabel.Size = UDim2.new(0, 80, 1, 0)
        TypeLabel.Position = UDim2.new(0, 5, 0, 0)
        TypeLabel.BackgroundTransparency = 1
        TypeLabel.Text = "[" .. remoteInfo.type .. "]"
        TypeLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
        TypeLabel.TextSize = 11
        TypeLabel.Font = Enum.Font.Gotham
        TypeLabel.TextXAlignment = Enum.TextXAlignment.Left
        TypeLabel.Parent = Item

        local PathLabel = Instance.new("TextLabel")
        PathLabel.Size = UDim2.new(1, -90, 1, 0)
        PathLabel.Position = UDim2.new(0, 90, 0, 0)
        PathLabel.BackgroundTransparency = 1
        PathLabel.Text = remoteInfo.path
        PathLabel.TextColor3 = GUI_CONFIG.TextColor
        PathLabel.TextSize = 11
        PathLabel.Font = Enum.Font.Code
        PathLabel.TextXAlignment = Enum.TextXAlignment.Left
        PathLabel.TextTruncate = Enum.TextTruncate.AtEnd
        PathLabel.Parent = Item
    end
end

local function RenderStats(panel, stats)
    ClearContent(panel)

    local sorted = {}
    for key, stat in pairs(stats) do
        sorted[#sorted + 1] = {key = key, stat = stat}
    end
    table.sort(sorted, function(a, b)
        return a.stat.callCount > b.stat.callCount
    end)

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, 0, 1, 0)
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.ScrollBarThickness = 6
    Scroll.CanvasSize = UDim2.new(0, 0, 0, #sorted * 60 + 10)
    Scroll.Parent = panel

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 3)
    Layout.Parent = Scroll

    for _, item in pairs(sorted) do
        local Item = Instance.new("Frame")
        Item.Size = UDim2.new(1, -10, 0, 55)
        Item.BackgroundColor3 = GUI_CONFIG.BgColor
        Item.BorderSizePixel = 0
        Item.Parent = Scroll

        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 3)
        ItemCorner.Parent = Item

        local NameLabel = Instance.new("TextLabel")
        NameLabel.Size = UDim2.new(1, -10, 0, 18)
        NameLabel.Position = UDim2.new(0, 5, 0, 2)
        NameLabel.BackgroundTransparency = 1
        NameLabel.Text = item.key
        NameLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
        NameLabel.TextSize = 12
        NameLabel.Font = Enum.Font.GothamBold
        NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        NameLabel.Parent = Item

        local methods = {}
        for m, c in pairs(item.stat.methods) do
            methods[#methods + 1] = string.format("%s(%d)", m, c)
        end

        local MethodLabel = Instance.new("TextLabel")
        MethodLabel.Size = UDim2.new(1, -10, 0, 15)
        MethodLabel.Position = UDim2.new(0, 5, 0, 20)
        MethodLabel.BackgroundTransparency = 1
        MethodLabel.Text = "Calls: " .. item.stat.callCount .. " | " .. table.concat(methods, ", ")
        MethodLabel.TextColor3 = GUI_CONFIG.TextColor
        MethodLabel.TextSize = 11
        MethodLabel.Font = Enum.Font.Gotham
        MethodLabel.TextXAlignment = Enum.TextXAlignment.Left
        MethodLabel.TextTruncate = Enum.TextTruncate.AtEnd
        MethodLabel.Parent = Item

        if item.stat.sampleArgs then
            local SampleLabel = Instance.new("TextLabel")
            SampleLabel.Size = UDim2.new(1, -10, 0, 15)
            SampleLabel.Position = UDim2.new(0, 5, 0, 37)
            SampleLabel.BackgroundTransparency = 1
            SampleLabel.Text = "Sample: " .. item.stat.sampleArgs
            SampleLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
            SampleLabel.TextSize = 10
            SampleLabel.Font = Enum.Font.Code
            SampleLabel.TextXAlignment = Enum.TextXAlignment.Left
            SampleLabel.TextTruncate = Enum.TextTruncate.AtEnd
            SampleLabel.Parent = Item
        end
    end
end

