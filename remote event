--[[
    JJS REMOTE INTERCEPTOR v1.2
    Console-only version (no GUI)
    Delta / Lua 5.1 compatible
    
    Commands:
    RI_Start()      - start interceptor
    RI_Stop()       - stop interceptor
    RI_Stats()      - print stats to console
    RI_Remotes()    - print discovered remotes
    RI_Export()     - export all to clipboard
    RI_ExportStats()- export stats to clipboard
    RI_ExportRemotes() - export remotes to clipboard
    RI_Add(name, type) - add mapping
    RI_Mode(mode)   - switch mode ("discover"/"produce")
    RI_Clear()      - clear stats
]]

-- ============================================================
-- CONFIG
-- ============================================================

local CONFIG = {
    Mode = "discover",
    LogToConsole = true,
    MaxLogArgs = 6,
    MaxLogsPerSecond = 15,
    LogThrottle = 0.1,
    
    IgnoreNames = {
        "Heartbeat", "Update", "Tick", "Ping",
        "KeepAlive", "Render", "Physics",
    },

    PassiveMode = false,

    EventMap = {},
}

-- ============================================================
-- STATE
-- ============================================================

local DiscoveredRemotes = {}
local RemoteStats = {}
local ActiveConnections = {}
local LastLogTime = {}
local LogCount = 0
local LastResetTime = time()

local OriginalNamecall = nil
local HookActive = false
local InHook = false

local EnemyMemoryRef = nil
local PerceptionCacheRef = nil

-- ============================================================
-- UTILITIES
-- ============================================================

local function LogDebug(msg)
    if not CONFIG.LogToConsole then return end
    
    local now = time()
    if now - LastResetTime >= 1 then
        LogCount = 0
        LastResetTime = now
    end
    
    LogCount = LogCount + 1
    if LogCount > CONFIG.MaxLogsPerSecond then return end
    
    print("[JJS REMOTE] " .. tostring(msg))
end

local function SerializeArg(arg, depth)
    depth = depth or 0
    if depth > 2 then return "..." end

    local t = type(arg)
    if t == "nil" then return "nil"
    elseif t == "boolean" then return tostring(arg)
    elseif t == "number" then return tostring(arg)
    elseif t == "string" then
        if #arg > 50 then return '"' .. string.sub(arg, 1, 50) .. '..."' end
        return '"' .. arg .. '"'
    elseif t == "table" then
        local items = {}
        local count = 0
        for k, v in pairs(arg) do
            count = count + 1
            if count > 5 then
                items[#items + 1] = "..."
                break
            end
            items[#items + 1] = tostring(k) .. "=" .. SerializeArg(v, depth + 1)
        end
        return "{" .. table.concat(items, ", ") .. "}"
    elseif t == "userdata" then
        local ok, name = pcall(function() return arg.Name end)
        if ok and name then return "Instance<" .. name .. ">" end
        return "userdata"
    else
        return t
    end
end

local function SerializeArgs(args, max)
    max = max or CONFIG.MaxLogArgs
    local parts = {}
    for i = 1, math.min(#args, max) do
        parts[#parts + 1] = SerializeArg(args[i])
    end
    if #args > max then
        parts[#parts + 1] = "... +" .. (#args - max) .. " more"
    end
    return "(" .. table.concat(parts, ", ") .. ")"
end

local function ShouldIgnore(remoteName)
    if not remoteName then return true end
    for _, ignore in pairs(CONFIG.IgnoreNames) do
        if string.find(remoteName, ignore, 1, true) then return true end
    end
    return false
end

-- ============================================================
-- SAFE INSTANCE CHECKS
-- ============================================================

local function IsRemoteEvent(instance)
    local ok, className = pcall(function()
        return instance.ClassName
    end)
    return ok and className == "RemoteEvent"
end

local function IsRemoteFunction(instance)
    local ok, className = pcall(function()
        return instance.ClassName
    end)
    return ok and className == "RemoteFunction"
end

local function SafeGetName(instance)
    local ok, name = pcall(function() return instance.Name end)
    if ok and name then return name end
    return tostring(instance)
end

-- ============================================================
-- CLIPBOARD
-- ============================================================

local function SetClipboard(text)
    if type(setclipboard) == "function" then
        pcall(function() setclipboard(text) end)
        return true
    end
    
    local GuiService = game:GetService("GuiService")
    if GuiService and GuiService.SetClipboard then
        pcall(function() GuiService:SetClipboard(text) end)
        return true
    end
    
    if type(writefile) == "function" then
        local filename = "JJS_Remote_Export.txt"
        pcall(function() writefile(filename, text) end)
        LogDebug("Saved to file: " .. filename)
        return true
    end
    
    LogDebug("ERROR: No clipboard method available")
    return false
end

-- ============================================================
-- DISCOVERY
-- ============================================================

local function DiscoverRemotes()
    LogDebug("=== DISCOVERING REMOTES ===")
    DiscoveredRemotes = {}
    local count = 0

    local function scan(parent, path)
        local ok, children = pcall(function()
            return parent:GetChildren()
        end)
        if not ok or not children then return end
        
        for _, obj in pairs(children) do
            local objName = SafeGetName(obj)
            local objPath = path .. "." .. objName

            if IsRemoteEvent(obj) then
                count = count + 1
                DiscoveredRemotes[#DiscoveredRemotes + 1] = {
                    instance = obj,
                    path = objPath,
                    type = "RemoteEvent",
                }
            elseif IsRemoteFunction(obj) then
                count = count + 1
                DiscoveredRemotes[#DiscoveredRemotes + 1] = {
                    instance = obj,
                    path = objPath,
                    type = "RemoteFunction",
                }
            end

            pcall(function() scan(obj, objPath) end)
        end
    end

    pcall(function() scan(game:GetService("ReplicatedStorage"), "ReplicatedStorage") end)
    pcall(function() scan(game:GetService("ReplicatedFirst"), "ReplicatedFirst") end)
    pcall(function() scan(game:GetService("Workspace"), "Workspace") end)
    pcall(function() scan(game:GetService("Lighting"), "Lighting") end)
    pcall(function() scan(game:GetService("SoundService"), "SoundService") end)

    LogDebug("=== DISCOVERY: " .. count .. " remotes found ===")
    return count
end

-- ============================================================
-- STATS
-- ============================================================

local function GetRemoteKey(remote)
    local ok, name = pcall(function() return remote.Name end)
    if ok and name then return name end
    return tostring(remote)
end

local function RecordRemoteCall(remoteKey, method, args, direction)
    if not RemoteStats[remoteKey] then
        RemoteStats[remoteKey] = {
            callCount = 0,
            methods = {},
            lastCall = 0,
            sampleArgs = nil,
            direction = direction,
        }
    end

    local stat = RemoteStats[remoteKey]
    stat.callCount = stat.callCount + 1
    stat.methods[method] = (stat.methods[method] or 0) + 1
    stat.lastCall = time()

    if not stat.sampleArgs and #args > 0 then
        stat.sampleArgs = SerializeArgs(args)
    end
end

-- ============================================================
-- PARSER
-- ============================================================

local function ParseEvent(remoteName, args)
    if CONFIG.Mode ~= "produce" then return end
    if not EnemyMemoryRef then return end

    local mapping = CONFIG.EventMap[remoteName]
    if not mapping then return end

    pcall(function()
        local eventType = mapping.type
        
        if eventType == "attack" then
            EnemyMemoryRef:RecordAction("attack")
            if PerceptionCacheRef then
                PerceptionCacheRef.attacking = true
                PerceptionCacheRef.attackStartTime = time()
            end
        elseif eventType == "block" then
            EnemyMemoryRef:RecordAction("block")
            if PerceptionCacheRef then
                PerceptionCacheRef.blocking = true
            end
        elseif eventType == "dash" then
            EnemyMemoryRef:RecordAction("dash")
            if PerceptionCacheRef then
                PerceptionCacheRef.dashing = true
            end
        elseif eventType == "parry" then
            EnemyMemoryRef:RecordAction("parry")
        elseif eventType == "awaken" then
            EnemyMemoryRef:RecordAction("awaken")
            if PerceptionCacheRef then
                PerceptionCacheRef.awakened = true
            end
        elseif eventType == "counter" then
            EnemyMemoryRef:RecordAction("counter")
            if PerceptionCacheRef then
                PerceptionCacheRef.countering = true
            end
        end
    end)
end

-- ============================================================
-- THROTTLE
-- ============================================================

local function CanLog(remoteKey)
    local now = time()
    if not LastLogTime[remoteKey] or now - LastLogTime[remoteKey] >= CONFIG.LogThrottle then
        LastLogTime[remoteKey] = now
        return true
    end
    return false
end

-- ============================================================
-- NAMECALL HOOK
-- ============================================================

local function InstallNamecallHook()
    if HookActive then return false end
    if CONFIG.PassiveMode then
        LogDebug("Passive mode: skipping hook")
        return false
    end

    if type(getrawmetatable) ~= "function" then
        LogDebug("ERROR: getrawmetatable not available")
        return false
    end
    if type(setreadonly) ~= "function" then
        LogDebug("ERROR: setreadonly not available")
        return false
    end
    if type(newcclosure) ~= "function" then
        LogDebug("ERROR: newcclosure not available")
        return false
    end
    if type(getnamecallmethod) ~= "function" then
        LogDebug("ERROR: getnamecallmethod not available")
        return false
    end

    local mt = getrawmetatable(game)
    if not mt then return false end

    OriginalNamecall = mt.__namecall
    if not OriginalNamecall then return false end

    pcall(function() setreadonly(mt, false) end)

    mt.__namecall = newcclosure(function(self, ...)
        if InHook then
            return OriginalNamecall(self, ...)
        end
        
        InHook = true
        
        local result = nil
        local success, err = pcall(function()
            local method = getnamecallmethod()
            local args = {...}

            local isRemote = IsRemoteEvent(self) or IsRemoteFunction(self)

            if isRemote then
                local remoteKey = GetRemoteKey(self)

                if not ShouldIgnore(remoteKey) then
                    local direction = "unknown"
                    if method == "FireServer" or method == "InvokeServer" then
                        direction = "client→server"
                    elseif method == "FireClient" then
                        direction = "server→client"
                    end

                    RecordRemoteCall(remoteKey, method, args, direction)

                    if CONFIG.Mode == "discover" then
                        if CanLog(remoteKey) then
                            LogDebug(string.format("[%s] %s:%s %s",
                                direction, remoteKey, method,
                                SerializeArgs(args)))
                        end
                    end

                    if CONFIG.Mode == "produce" then
                        ParseEvent(remoteKey, args)
                    end
                end
            end

            result = OriginalNamecall(self, ...)
        end)

        InHook = false
        
        if not success then
            return OriginalNamecall(self, ...)
        end
        
        return result
    end)

    pcall(function() setreadonly(mt, true) end)
    HookActive = true
    LogDebug("Hook installed")
    return true
end

local function RemoveNamecallHook()
    if not HookActive then return end

    local mt = getrawmetatable(game)
    if mt and OriginalNamecall then
        pcall(function() setreadonly(mt, false) end)
        mt.__namecall = OriginalNamecall
        pcall(function() setreadonly(mt, true) end)
    end

    HookActive = false
    OriginalNamecall = nil
    InHook = false
end

-- ============================================================
-- LISTENERS
-- ============================================================

local function InstallListeners()
    local count = 0

    for _, remoteInfo in pairs(DiscoveredRemotes) do
        local remote = remoteInfo.instance

        if IsRemoteEvent(remote) then
            local ok, conn = pcall(function()
                return remote.OnClientEvent:Connect(function(...)
                    local args = {...}
                    local remoteKey = GetRemoteKey(remote)

                    if ShouldIgnore(remoteKey) then return end

                    RecordRemoteCall(remoteKey, "OnClientEvent", args, "server→client")

                    if CONFIG.Mode == "discover" then
                        if CanLog(remoteKey) then
                            LogDebug(string.format("[server→client] %s %s",
                                remoteKey, SerializeArgs(args)))
                        end
                    end

                    if CONFIG.Mode == "produce" then
                        ParseEvent(remoteKey, args)
                    end
                end)
            end)

            if ok and conn then
                ActiveConnections[#ActiveConnections + 1] = conn
                count = count + 1
            end
        end
    end

    LogDebug("Installed " .. count .. " listeners")
    return count
end

local function RemoveListeners()
    for _, conn in pairs(ActiveConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ActiveConnections = {}
end

-- ============================================================
-- PUBLIC COMMANDS
-- ============================================================

local IsRunning = false

function RI_Start()
    if IsRunning then
        LogDebug("Already running")
        return
    end
    
    DiscoverRemotes()
    InstallNamecallHook()
    InstallListeners()
    IsRunning = true
    LogDebug("Interceptor started (mode: " .. CONFIG.Mode .. ")")
end

function RI_Stop()
    RemoveNamecallHook()
    RemoveListeners()
    IsRunning = false
    LogDebug("Interceptor stopped")
end

function RI_Remotes()
    print("========== DISCOVERED REMOTES ==========")
    print("Total: " .. #DiscoveredRemotes)
    for i, r in pairs(DiscoveredRemotes) do
        print(string.format("%d. [%s] %s", i, r.type, r.path))
    end
    print("=========================================")
end

function RI_Stats()
    print("========== REMOTE STATS ==========")
    local sorted = {}
    for key, stat in pairs(RemoteStats) do
        sorted[#sorted + 1] = {key = key, stat = stat}
    end
    table.sort(sorted, function(a, b)
        return a.stat.callCount > b.stat.callCount
    end)

    for _, item in pairs(sorted) do
        local methods = {}
        for m, c in pairs(item.stat.methods) do
            methods[#methods + 1] = string.format("%s(%d)", m, c)
        end
        print(string.format("  %s | calls: %d | %s",
            item.key, item.stat.callCount, table.concat(methods, ", ")))
        if item.stat.sampleArgs then
            print("    sample: " .. item.stat.sampleArgs)
        end
    end
    print("===================================")
end

function RI_ExportRemotes()
    local lines = {}
    lines[#lines + 1] = "=== DISCOVERED REMOTES ==="
    lines[#lines + 1] = "Total: " .. #DiscoveredRemotes
    for i, r in pairs(DiscoveredRemotes) do
        lines[#lines + 1] = string.format("%d. [%s] %s", i, r.type, r.path)
    end
    SetClipboard(table.concat(lines, "\n"))
    LogDebug("Remotes exported to clipboard")
end

function RI_ExportStats()
    local lines = {}
    lines[#lines + 1] = "=== REMOTE STATS ==="
    
    local sorted = {}
    for key, stat in pairs(RemoteStats) do
        sorted[#sorted + 1] = {key = key, stat = stat}
    end
    table.sort(sorted, function(a, b)
        return a.stat.callCount > b.stat.callCount
    end)

    for _, item in pairs(sorted) do
        local methods = {}
        for m, c in pairs(item.stat.methods) do
            methods[#methods + 1] = string.format("%s(%d)", m, c)
        end
        lines[#lines + 1] = string.format("## %s | calls: %d | %s",
            item.key, item.stat.callCount, table.concat(methods, ", "))
        if item.stat.sampleArgs then
            lines[#lines + 1] = "   sample: " .. item.stat.sampleArgs
        end
    end
    
    SetClipboard(table.concat(lines, "\n"))
    LogDebug("Stats exported to clipboard")
end

function RI_ExportMappings()
    local lines = {}
    lines[#lines + 1] = "=== EVENT MAPPINGS ==="
    for name, mapping in pairs(CONFIG.EventMap) do
        lines[#lines + 1] = string.format(
            "RI_Add(\"%s\", \"%s\", %d)",
            name, mapping.type, mapping.argIndex or 1)
    end
    SetClipboard(table.concat(lines, "\n"))
    LogDebug("Mappings exported to clipboard")
end

function RI_ExportAll()
    local sections = {}
    
    -- Remotes
    sections[#sections + 1] = "=== DISCOVERED REMOTES ==="
    sections[#sections + 1] = "Total: " .. #DiscoveredRemotes
    for i, r in pairs(DiscoveredRemotes) do
        sections[#sections + 1] = string.format("%d. [%s] %s", i, r.type, r.path)
    end
    
    sections[#sections + 1] = ""
    
    -- Stats
    sections[#sections + 1] = "=== REMOTE STATS ==="
    local sorted = {}
    for key, stat in pairs(RemoteStats) do
        sorted[#sorted + 1] = {key = key, stat = stat}
    end
    table.sort(sorted, function(a, b)
        return a.stat.callCount > b.stat.callCount
    end)
    for _, item in pairs(sorted) do
        local methods = {}
        for m, c in pairs(item.stat.methods) do
            methods[#methods + 1] = string.format("%s(%d)", m, c)
        end
        sections[#sections + 1] = string.format("## %s | calls: %d | %s",
            item.key, item.stat.callCount, table.concat(methods, ", "))
        if item.stat.sampleArgs then
            sections[#sections + 1] = "   sample: " .. item.stat.sampleArgs
        end
    end
    
    sections[#sections + 1] = ""
    
    -- Mappings
    sections[#sections + 1] = "=== EVENT MAPPINGS ==="
    for name, mapping in pairs(CONFIG.EventMap) do
        sections[#sections + 1] = string.format(
            "RI_Add(\"%s\", \"%s\", %d)",
            name, mapping.type, mapping.argIndex or 1)
    end
    
    SetClipboard(table.concat(sections, "\n"))
    LogDebug("All data exported to clipboard")
end

function RI_Add(remoteName, eventType, argIndex)
    CONFIG.EventMap[remoteName] = {
        type = eventType,
        argIndex = argIndex or 1,
    }
    LogDebug("Added mapping: " .. remoteName .. " → " .. eventType)
end

function RI_Mode(mode)
    if mode == "discover" or mode == "produce" then
        CONFIG.Mode = mode
        LogDebug("Mode: " .. mode)
    else
        LogDebug("Invalid mode. Use 'discover' or 'produce'")
    end
end

function RI_Clear()
    RemoteStats = {}
    LastLogTime = {}
    LogDebug("Stats cleared")
end

function RI_Passive(enabled)
    CONFIG.PassiveMode = enabled
    LogDebug("Passive mode: " .. tostring(enabled))
end

function RI_SetEnemyMemory(memRef, cacheRef)
    EnemyMemoryRef = memRef
    PerceptionCacheRef = cacheRef
    LogDebug("EnemyMemory connected")
end

-- ============================================================
-- CLEANUP
-- ============================================================

if _G.JJS_RemoteInterceptor_Cleanup then
    pcall(_G.JJS_RemoteInterceptor_Cleanup)
end

_G.JJS_RemoteInterceptor_Cleanup = function()
    RI_Stop()
end

LogDebug("Loaded. Commands: RI_Start, RI_Stop, RI_Stats, RI_Remotes, RI_ExportAll")