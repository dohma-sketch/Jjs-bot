local function RenderLog(panel)
    ClearContent(panel)

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Name = "LogScroll"
    Scroll.Size = UDim2.new(1, 0, 1, 0)
    Scroll.BackgroundTransparency = 1
    Scroll.BorderSizePixel = 0
    Scroll.ScrollBarThickness = 6
    Scroll.CanvasSize = UDim2.new(0, 0, 0, 10)
    Scroll.Parent = panel

    local Layout = Instance.new("UIListLayout")
    Layout.Name = "LogLayout"
    Layout.Padding = UDim.new(0, 1)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Scroll

    return Scroll
end

local function AddLogEntry(scroll, message, color)
    color = color or GUI_CONFIG.TextColor
    
    local Entry = Instance.new("TextLabel")
    Entry.Size = UDim2.new(1, -10, 0, 16)
    Entry.BackgroundTransparency = 1
    Entry.Text = message
    Entry.TextColor3 = color
    Entry.TextSize = 10
    Entry.Font = Enum.Font.Code
    Entry.TextXAlignment = Enum.TextXAlignment.Left
    Entry.TextTruncate = Enum.TextTruncate.AtEnd
    Entry.LayoutOrder = time() * 1000
    Entry.Parent = scroll

    -- Обновляем CanvasSize
    local Layout = scroll:FindFirstChild("LogLayout")
    if Layout then
        scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
    end

    -- Удаляем старые записи
    local children = scroll:GetChildren()
    local count = 0
    for _, child in pairs(children) do
        if child:IsA("TextLabel") then count = count + 1 end
    end
    if count > GUI_CONFIG.MaxLogEntries then
        local oldest = nil
        local oldestOrder = math.huge
        for _, child in pairs(children) do
            if child:IsA("TextLabel") and child.LayoutOrder < oldestOrder then
                oldest = child
                oldestOrder = child.LayoutOrder
            end
        end
        if oldest then oldest:Destroy() end
    end

    -- Автоскролл вниз
    scroll.CanvasPosition = Vector2.new(0, scroll.CanvasSize.Y.Offset)
end

