-- FEED
local Feed = {
    attack = {time = 0, char = nil, kind = nil},
    skill  = {time = 0, char = nil, service = nil},
    dash   = {time = 0, char = nil, dir = nil},
    block  = {start = 0, stop = 0, char = nil, active = false},
    awaken = {time = 0, char = nil},
    last   = {time = 0, cat = "-", service = "-", effect = "-"},
}
_G.JJS_Feed = Feed

local connections = {}
local function hook(remote, fn)
    local ok, conn = pcall(function() return remote.OnClientEvent:Connect(fn) end)
    if ok and conn then connections[#connections + 1] = conn end
end

local function pickChar(...)
    for i = 1, select("#", ...) do
        local a = select(i, ...)
        if type(a) == "userdata" then
            local ok, isModel = pcall(function() return a:IsA("Model") end)
            if ok and isModel then return a end
        end
    end
    return nil
end

-- CLASSIFY
local function classify(serviceName, effectType)
    local s = tostring(serviceName):lower()
    local e = tostring(effectType):lower()

    if string.find(e, "swing") or string.find(e, "m1") or string.find(e, "punch")
       or string.find(e, "kick") or string.find(e, "slash") or string.find(e, "strike")
       or string.find(e, "hit") or string.find(e, "combo") or string.find(e, "uppercut") then
        return "attack"
    end
    if string.find(e, "block") or string.find(e, "guard") or string.find(s, "block") then
        return "block"
    end
    if string.find(e, "dash") or string.find(e, "step") or string.find(e, "evade")
       or string.find(s, "veilstep") or string.find(s, "movement") then
        return "dash"
    end
    if string.find(e, "awaken") or string.find(e, "domain") or string.find(s, "awaken") then
        return "awaken"
    end
    return "skill"
end

local function route(cat, who, svcName, effectType)
    local now = time()
    Feed.last.time = now
    Feed.last.cat = cat
    Feed.last.service = svcName
    Feed.last.effect = tostring(effectType)

    if cat == "attack" then
        Feed.attack.time = now; Feed.attack.char = who; Feed.attack.kind = tostring(effectType)
    elseif cat == "block" then
        Feed.block.start = now; Feed.block.active = true; Feed.block.char = who
    elseif cat == "dash" then
        Feed.dash.time = now; Feed.dash.char = who; Feed.dash.dir = tostring(effectType)
    elseif cat == "awaken" then
        Feed.awaken.time = now; Feed.awaken.char = who
    else
        Feed.skill.time = now; Feed.skill.char = who; Feed.skill.service = svcName
    end
end

-- HOOK ALL
local connectedCount = 0
pcall(function()
    local Services = RS.Knit.Knit.Services
    for _, svc in pairs(Services:GetChildren()) do
        local RE = svc:FindFirstChild("RE")
        if RE then
            local svcName = svc.Name

            local effects = RE:FindFirstChild("Effects")
            if effects then
                hook(effects, function(effectType, ...)
                    local who = pickChar(...)
                    route(classify(svcName, effectType), who, svcName, effectType)
                end)
                connectedCount = connectedCount + 1
            end

            local activated = RE:FindFirstChild("Activated")
            if activated then
                hook(activated, function(...)
                    local who = pickChar(...)
                    route(classify(svcName, "activated"), who, svcName, "activated")
                end)
                connectedCount = connectedCount + 1
            end
        end
    end

    local move = Services:FindFirstChild("MovementService")
    if move and move.RE then
        local dash = move.RE:FindFirstChild("Dash")
        if dash then
            hook(dash, function(dir, ...)
                Feed.dash.time = time()
                Feed.dash.dir = dir
                Feed.dash.char = pickChar(...) or LocalPlayer.Character
            end)
            connectedCount = connectedCount + 1
        end
    end

    local block = Services:FindFirstChild("BlockService")
    if block and block.RE then
        for _, child in pairs(block.RE:GetChildren()) do
            if child:IsA("RemoteEvent") then
                local isDeact = (child.Name == "Deactivated")
                hook(child, function(...)
                    local who = pickChar(...)
                    if isDeact then
                        Feed.block.stop = time()
                        Feed.block.active = false
                    else
                        Feed.block.start = time()
                        Feed.block.active = true
                    end
                    Feed.block.char = who
                end)
                connectedCount = connectedCount + 1
            end
        end
    end
end)

-- SCAN FALLBACK
local function GetBoolAttr(obj, name)
    if not obj then return false end
    local ok, v = pcall(function() return obj:GetAttribute(name) end)
    return ok and v == true
end

local function IsBlockingScan(target)
    if GetBoolAttr(target, "Blocking") then return true end
    local hum = target:FindFirstChild("Humanoid")
    if not hum then return false end
    local anim = hum:FindFirstChild("Animator")
    if not anim then return false end
    local ok, tracks = pcall(function() return anim:GetPlayingAnimationTracks() end)
    if not ok then return false end
    for _, t in pairs(tracks) do
        if t.IsPlaying and t.Animation and t.Animation.Name then
            local n = string.lower(t.Animation.Name)
            if string.find(n, "block") or string.find(n, "guard") or string.find(n, "defend") then
                return true
            end
        end
    end
    return false
end

local function IsAwakenedScan(target)
    if GetBoolAttr(target, "Awakened") or GetBoolAttr(target, "Awake")
        or GetBoolAttr(target, "Domain") or GetBoolAttr(target, "Transformation") then
        return true
    end
    local vfx = target:FindFirstChild("VFX") or target:FindFirstChild("Effects") or target:FindFirstChild("Particles")
    if vfx then
        for _, d in pairs(vfx:GetChildren()) do
            local n = string.lower(d.Name)
            if string.find(n, "awaken") or string.find(n, "domain") then return true end
        end
    end
    return false
end

local function IsDashingScan(target)
    local root = target:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    local v = root.AssemblyLinearVelocity or root.Velocity
    if not v then return false end
    return Vector3.new(v.X, 0, v.Z).Magnitude > 40
end

local function getTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best = nil
    local bestDist = 100
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local tr = plr.Character:FindFirstChild("HumanoidRootPart")
            if tr then
                local d = (tr.Position - root.Position).Magnitude
                if d < bestDist then bestDist = d; best = plr.Character end
            end
        end
    end
    if best then return best end
    local cands = {Feed.attack.char, Feed.skill.char, Feed.block.char}
    for _, c in pairs(cands) do
        if c and c ~= char then return c end
    end
    return nil
end

