local function DiscoverRemotes()
    DiscoveredRemotes = {}
    local count = 0

    local function scan(parent, path)
        local ok, children = pcall(function() return parent:GetChildren() end)
        if not ok or not children then return end
        for _, obj in pairs(children) do
            local objName = SafeGetName(obj)
            local objPath = path .. "." .. objName
            local cn = GetClassName(obj)
            if cn == "RemoteEvent" or cn == "RemoteFunction" then
                count = count + 1
                DiscoveredRemotes[#DiscoveredRemotes + 1] = {
                    instance = obj,
                    path = objPath,
                    type = cn,
                }
            end
            pcall(function() scan(obj, objPath) end)
        end
    end

    pcall(function() scan(game:GetService("ReplicatedStorage"), "RS") end)
    pcall(function() scan(game:GetService("ReplicatedFirst"), "RF") end)
    pcall(function() scan(Workspace, "WS") end)
    pcall(function() scan(game:GetService("Lighting"), "Lighting") end)

    LogDebug("Found " .. count .. " remotes")
    return count
end

local function RecordRemoteCall(remoteKey, method, args, direction)
    if not RemoteStats[remoteKey] then
        RemoteStats[remoteKey] = {
            callCount = 0,
            methods = {},
            lastCall = 0,
            sampleArgs = nil,
            direction = direction,
        }
    end
    local stat = RemoteStats[remoteKey]
    stat.callCount = stat.callCount + 1
    stat.methods[method] = (stat.methods[method] or 0) + 1
    stat.lastCall = time()
    if not stat.sampleArgs and #args > 0 then
        stat.sampleArgs = SerializeArgs(args)
    end
end

local function ParseEvent(remoteName, args)
    if CONFIG.Mode ~= "produce" then return end
    if not EnemyMemoryRef then return end
    local mapping = CONFIG.EventMap[remoteName]
    if not mapping then return end
    pcall(function()
        local eventType = mapping.type
        if eventType == "attack" then
            EnemyMemoryRef:RecordAction("attack")
            if PerceptionCacheRef then
                PerceptionCacheRef.attacking = true
                PerceptionCacheRef.attackStartTime = time()
            end
        elseif eventType == "block" then
            EnemyMemoryRef:RecordAction("block")
            if PerceptionCacheRef then PerceptionCacheRef.blocking = true end
        elseif eventType == "dash" then
            EnemyMemoryRef:RecordAction("dash")
            if PerceptionCacheRef then PerceptionCacheRef.dashing = true end
        elseif eventType == "parry" then
            EnemyMemoryRef:RecordAction("parry")
        elseif eventType == "awaken" then
            EnemyMemoryRef:RecordAction("awaken")
            if PerceptionCacheRef then PerceptionCacheRef.awakened = true end
        elseif eventType == "counter" then
            EnemyMemoryRef:RecordAction("counter")
            if PerceptionCacheRef then PerceptionCacheRef.countering = true end
        end
    end)
end

local function CanLog(remoteKey)
    local now = time()
    if not LastLogTime[remoteKey] or now - LastLogTime[remoteKey] >= CONFIG.LogThrottle then
        LastLogTime[remoteKey] = now
        return true
    end
    return false
end

-- ============================================================
-- NAMECALL HOOK
-- ============================================================

local function InstallNamecallHook()
    if HookActive then return false end

    if type(getrawmetatable) ~= "function" then
        LogDebug("Hook skip: getrawmetatable unavailable")
        return false
    end

    local mt = getrawmetatable(game)
    if not mt then
        LogDebug("Hook skip: metatable nil")
        return false
    end

    OriginalNamecall = mt.__namecall
    if not OriginalNamecall then
        LogDebug("Hook skip: no __namecall")
        return false
    end

    pcall(function()
        if type(setreadonly) == "function" then setreadonly(mt, false) end
    end)

    local hookFunc = function(self, ...)
        if InHook then
            return OriginalNamecall(self, ...)
        end
        InHook = true

        local result
        local ok, err = pcall(function()
            local method = getnamecallmethod()
            local args = {...}

            local isRemote = false
            pcall(function()
                local cn = self.ClassName
                isRemote = (cn == "RemoteEvent" or cn == "RemoteFunction")
            end)

            if isRemote then
                local remoteKey = SafeGetName(self)
                if not ShouldIgnore(remoteKey) then
                    local direction = "unknown"
                    if method == "FireServer" or method == "InvokeServer" then
                        direction = "C→S"
                    elseif method == "FireClient" then
                        direction = "S→C"
                    end

                    RecordRemoteCall(remoteKey, method, args, direction)

                    if CONFIG.Mode == "discover" then
                        if CanLog(remoteKey) then
                            LogDebug(string.format("[%s] %s:%s %s",
                                direction, remoteKey, method, SerializeArgs(args)))
                        end
                    end

                    if CONFIG.Mode == "produce" then
                        ParseEvent(remoteKey, args)
                    end
                end
            end

            result = OriginalNamecall(self, ...)
        end)

        InHook = false

        if not ok then
            return OriginalNamecall(self, ...)
        end
        return result
    end

    local finalHook = hookFunc
    if type(newcclosure) == "function" then
        finalHook = newcclosure(hookFunc)
    end

    local setOk = pcall(function()
        mt.__namecall = finalHook
    end)

    if not setOk then
        LogDebug("Hook skip: failed to set")
        return false
    end

    pcall(function()
        if type(setreadonly) == "function" then setreadonly(mt, true) end
    end)

    HookActive = true
    LogDebug("Hook installed")
    return true
end

local function RemoveNamecallHook()
    if not HookActive then return end
    local mt = getrawmetatable(game)
    if mt and OriginalNamecall then
        pcall(function()
            if type(setreadonly) == "function" then setreadonly(mt, false) end
        end)
        pcall(function() mt.__namecall = OriginalNamecall end)
        pcall(function()
            if type(setreadonly) == "function" then setreadonly(mt, true) end
        end)
    end
    HookActive = false
    OriginalNamecall = nil
    InHook = false
    LogDebug("Hook removed")
end

-- ============================================================
-- LISTENERS
-- ============================================================

local function InstallListeners()
    local count = 0
    for _, remoteInfo in pairs(DiscoveredRemotes) do
        local remote = remoteInfo.instance
        local cn = GetClassName(remote)
        if cn == "RemoteEvent" then
            local ok, conn = pcall(function()
                return remote.OnClientEvent:Connect(function(...)
                    local args = {...}
                    local remoteKey = SafeGetName(remote)
                    if ShouldIgnore(remoteKey) then return end
                    RecordRemoteCall(remoteKey, "OnClientEvent", args, "S→C")
                    if CONFIG.Mode == "discover" then
                        if CanLog(remoteKey) then
                            LogDebug(string.format("[S→C] %s %s",
                                remoteKey, SerializeArgs(args)))
                        end
                    end
                    if CONFIG.Mode == "produce" then
                        ParseEvent(remoteKey, args)
                    end
                end)
            end)
            if ok and conn then
                ActiveConnections[#ActiveConnections + 1] = conn
                count = count + 1
            end
        end
    end
    LogDebug("Listeners: " .. count)
    return count
end

local function RemoveListeners()
    for _, conn in pairs(ActiveConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ActiveConnections = {}
end

-- ============================================================
-- START / STOP / ACTIONS
-- ============================================================

local function DoStart()
    if IsRunning then
        LogDebug("Already running")
        return
    end
    DiscoverRemotes()
    local hookOk = InstallNamecallHook()
    if not hookOk then
        LogDebug("Hook failed, listeners only")
    end
    InstallListeners()
    IsRunning = true
    LogDebug("Started (mode: " .. CONFIG.Mode .. ")")
    UpdateStatus()
end

local function DoStop()
    RemoveNamecallHook()
    RemoveListeners()
    IsRunning = false
    LogDebug("Stopped")
    UpdateStatus()
end

local function DoClear()
    RemoteStats = {}
    LastLogTime = {}
    LogDebug("Stats cleared")
    UpdateStatus()
end

local function DoExportAll()
    local lines = {}
    lines[#lines + 1] = "=== DISCOVERED REMOTES ==="
    lines[#lines + 1] = "Total: " .. #DiscoveredRemotes
    for i, r in pairs(DiscoveredRemotes) do
        lines[#lines + 1] = string.format("%d. [%s] %s", i, r.type, r.path)
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "=== REMOTE STATS ==="
    local sorted = {}
    for key, stat in pairs(RemoteStats) do
        sorted[#sorted + 1] = {key = key, stat = stat}
    end
    if #sorted > 0 then
        table.sort(sorted, function(a, b)
            return a.stat.callCount > b.stat.callCount
        end)
    end
    for _, item in pairs(sorted) do
        local methods = {}
        for m, c in pairs(item.stat.methods) do
            methods[#methods + 1] = string.format("%s(%d)", m, c)
        end
        lines[#lines + 1] = string.format("## %s | calls: %d | %s",
            item.key, item.stat.callCount, table.concat(methods, ", "))
        if item.stat.sampleArgs then
            lines[#lines + 1] = "   sample: " .. item.stat.sampleArgs
        end
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "=== EVENT MAPPINGS ==="
    for name, mapping in pairs(CONFIG.EventMap) do
        lines[#lines + 1] = string.format(
            'RI_Add("%s", "%s", %d)',
            name, mapping.type, mapping.argIndex or 1)
    end
    SetClipboard(table.concat(lines, "\n"))
    LogDebug("Exported to clipboard")
end

