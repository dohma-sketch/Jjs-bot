local function worldToScreen(pos)
    local cam = getCamera()

    if not cam then
        return 0, 0, false
    end

    local vec, onScreen = cam:WorldToScreenPoint(pos)

    return math.floor(vec.X), math.floor(vec.Y), onScreen
end

local function getCenterScreen()
    local cam = getCamera()

    if not cam then
        return 0, 0
    end

    local vp = cam.ViewportSize

    if not vp or vp.X <= 0 or vp.Y <= 0 then
        return 0, 0
    end

    return math.floor(vp.X / 2), math.floor(vp.Y / 2)
end

local function getAimPart(target)
    if not target then
        return nil
    end

    return target:FindFirstChild("Head")
        or target:FindFirstChild("UpperTorso")
        or getRoot(target)
end

------------------------------------------------------------
-- CAMERA CONTROLLER
------------------------------------------------------------

local activeAimTarget = nil
local cameraSavedType = nil

local function restoreCamera(force)
    if not force and cameraSavedType == nil and activeAimTarget == nil then
        return
    end

    local cam = getCamera()
    activeAimTarget = nil

    if not cam then
        cameraSavedType = nil
        return
    end

    local restoreType = cameraSavedType

    if restoreType == nil or restoreType == Enum.CameraType.Scriptable then
        restoreType = Enum.CameraType.Custom
    end

    pcall(function()
        cam.CameraType = restoreType
    end)

    cameraSavedType = nil
end

local function beginAim(target)
    local mode = CONFIG.cameraMode or "FOLLOW_TEMP"

    if not CONFIG.enableAim or mode == "OFF" or not target then
        return
    end

    local cam = getCamera()

    if not cam then
        return
    end

    if cameraSavedType == nil then
        cameraSavedType = cam.CameraType
    end

    pcall(function()
        cam.CameraType = Enum.CameraType.Scriptable
    end)

    activeAimTarget = target
end

local function endAim()
    if CONFIG.restoreCameraAfterAction ~= false and (activeAimTarget ~= nil or cameraSavedType ~= nil) then
        restoreCamera(false)
    else
        activeAimTarget = nil
    end
end

RunService.RenderStepped:Connect(function()
    pcall(function()
        local mode = CONFIG.cameraMode or "FOLLOW_TEMP"

        if not CONFIG.enableAim or mode == "OFF" then
            return
        end

        local cam = getCamera()

        if not cam then
            return
        end

        if not activeAimTarget then
            return
        end

        if not botReady() or not isModelAlive(activeAimTarget) then
            restoreCamera(true)
            return
        end

        local part = getAimPart(activeAimTarget)

        if not part or not bot.hrp then
            return
        end

        local look = part.Position - bot.hrp.Position

        if look.Magnitude < 0.2 then
            return
        end

        look = look.Unit

        if mode == "FOLLOW_TEMP" then
            local dist = CONFIG.cameraDistance or 11
            local height = CONFIG.cameraHeight or 2.2

            local camPos = bot.hrp.Position - look * dist + Vector3.new(0, height, 0)

            pcall(function()
                cam.CFrame = CFrame.lookAt(camPos, part.Position)
            end)

        elseif mode == "ORIENTATION_TEMP" then
            pcall(function()
                cam.CFrame = CFrame.lookAt(cam.CFrame.Position, part.Position)
            end)
        end
    end)
end)

