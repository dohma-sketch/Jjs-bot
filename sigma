}

local ATTACK_ATTRS = {
    "Attacking",
    "IsAttacking",
    "AttackActive",
    "Casting",
    "IsCasting",
    "UsingSkill",
    "SkillActive",
}

local BLOCK_TAGS = {
    "Blocking",
    "Block",
    "IsBlocking",
}

local VULNERABLE_TAGS = {
    "Stunned",
    "Ragdoll",
    "Downed",
    "Knocked",
}

local ATTACK_TAGS = {
    "Attacking",
    "Attack",
    "Casting",
}

local function attrTrueOnInst(inst, names)
    if not inst then
        return false
    end

    for _, name in ipairs(names) do
        local value = inst:GetAttribute(name)

        if value == true or value == 1 then
            return true
        end
    end

    return false
end

local function tagTrueOnInst(inst, names)
    if not inst then
        return false
    end

    for _, tag in ipairs(names) do
        local ok, has = pcall(function()
            return CollectionService:HasTag(inst, tag)
        end)

        if ok and has then
            return true
        end
    end

    return false
end

local function getEnemyStatus(target)
    if not isModelAlive(target) then
        return "dead"
    end

    local hum = getHumanoid(target)
    local root = getRoot(target)

    if attrTrueOnInst(hum, BLOCK_ATTRS)
        or attrTrueOnInst(root, BLOCK_ATTRS)
        or attrTrueOnInst(target, BLOCK_ATTRS)
        or tagTrueOnInst(hum, BLOCK_TAGS)
        or tagTrueOnInst(target, BLOCK_TAGS) then
        return "blocking"
    end

    if attrTrueOnInst(hum, VULNERABLE_ATTRS)
        or attrTrueOnInst(root, VULNERABLE_ATTRS)
        or attrTrueOnInst(target, VULNERABLE_ATTRS)
        or tagTrueOnInst(hum, VULNERABLE_TAGS)
        or tagTrueOnInst(target, VULNERABLE_TAGS) then
        return "vulnerable"
    end

    if hum and hum.PlatformStand then
        return "vulnerable"
    end

    return "neutral"
end

local ATTACK_ANIM_KEYWORDS = {
    "attack",
    "m1",
    "combo",
    "skill",
    "cast",
    "punch",
    "kick",
}

local function enemyLikelyAttacking(target)
    if not isModelAlive(target) or not botReady() then
        return false
    end

    local hum = getHumanoid(target)
    local root = getRoot(target)

    if not hum or not root then
        return false
    end

    if attrTrueOnInst(hum, ATTACK_ATTRS)
        or attrTrueOnInst(root, ATTACK_ATTRS)
        or attrTrueOnInst(target, ATTACK_ATTRS)
        or tagTrueOnInst(hum, ATTACK_TAGS)
        or tagTrueOnInst(target, ATTACK_TAGS) then
        return true
    end

    local animator = hum:FindFirstChildOfClass("Animator")

    if animator then
        local ok, tracks = pcall(function()
            return animator:GetPlayingAnimationTracks()
        end)

        if ok and tracks then
            for _, track in ipairs(tracks) do
                local trackName = track.Name:lower()

                for _, keyword in ipairs(ATTACK_ANIM_KEYWORDS) do
                    if string.find(trackName, keyword, 1, true) then
                        return true
                    end
                end
            end
        end
    end

    local dist = (root.Position - bot.hrp.Position).Magnitude

    if dist > CONFIG.attackRange + 4 then
        return false
    end

    local toBot = bot.hrp.Position - root.Position

    if toBot.Magnitude < 0.2 then
        return false
    end

    local lookDot = root.CFrame.LookVector:Dot(toBot.Unit)
    local moving = hum.MoveDirection.Magnitude > 0.1

    if lookDot > 0.75 and not moving then
        return true
    end

    return false
end

