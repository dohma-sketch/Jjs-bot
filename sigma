local MV = CONFIG.movement or {}

local function safeUnit(v, fallback)
    if not v then
        return fallback or Vector3.new(0, 0, 1)
    end

    local m = v.Magnitude

    if m > 0.001 then
        return v / m
    end

    return fallback or Vector3.new(0, 0, 1)
end

