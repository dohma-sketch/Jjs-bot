------------------------------------------------------------

local lastReflexBlock = 0

local function shouldDefensiveBlock(target, dist)
    if CONFIG.autoBlock == false then
        return false
    end

    if not botReady() or not target then
        return false
    end

    if tick() - lastReflexBlock < CONFIG.reflexBlockCooldown then
        return false
    end

    if dist > CONFIG.attackRange + 3 then
        return false
    end

    local frac = getSelfHealthFrac()

    if enemyLikelyAttacking(target) or (frac <= CONFIG.lowHealthThreshold and dist <= CONFIG.attackRange) then
        lastReflexBlock = tick()
        stats.reflexBlocks = stats.reflexBlocks + 1
        return true
    end

    return false
end

------------------------------------------------------------
-- ACTION EXECUTION
------------------------------------------------------------

local function performAction(name, target, dist)
    if not botReady() then
        return
    end

    lastActionAt[name] = tick()

    if name == "approach" and target then
        local desired = math.max(3.5, CONFIG.attackRange * 0.70)
        Movement.setCombatTarget(target, desired)

    elseif name == "back_step" then
        Movement.requestBackStep(target, CONFIG.backStepDistance)

    elseif name == "jump" then
        Movement.jump()

    elseif name == "m1_attack" and target then
        local desired = math.max(3.2, CONFIG.attackRange * 0.62)
        Movement.setCombatTarget(target, desired)
        performM1(target)

    elseif name:sub(1, 6) == "skill_" and target then
        local desired = math.max(4.0, CONFIG.skillRange * 0.60)
        Movement.setCombatTarget(target, desired)
        performSkill(target, skillKeyMap[name] or Enum.KeyCode.One)

    elseif name == "block" then
        if target then
            local desired = math.max(3.5, CONFIG.attackRange * 0.70)
            Movement.setCombatTarget(target, desired)
        end

        performBlock()
    end
end

