local function getCamera()
    camera = workspace.CurrentCamera or camera
    return camera
end

local function getHumanoid(model)
    if not model then
        return nil
    end

    return model:FindFirstChildOfClass("Humanoid")
end

local function getRoot(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function isModelAlive(model)
    if not model or not model.Parent then
        return false
    end

    local hum = getHumanoid(model)
    local root = getRoot(model)

    return hum ~= nil and root ~= nil and hum.Health > 0
end

local function botReady()
    return bot.character ~= nil
        and bot.character.Parent ~= nil
        and bot.humanoid ~= nil
        and bot.humanoid.Parent ~= nil
        and bot.hrp ~= nil
        and bot.hrp.Parent ~= nil
        and bot.humanoid.Health > 0
end

local function clampNumber(value, min, max)
    if value ~= value then
        return min
    end

    if value < min then
        return min
    end

    if value > max then
        return max
    end

    return value
end

local function getSelfHealthFrac()
    if not botReady() then
        return 1
    end

    return bot.humanoid.Health / math.max(1, bot.humanoid.MaxHealth)
end

local function isAttackAction(name)
    if name == "m1_attack" then
        return true
    end

    return name:sub(1, 6) == "skill_"
end

