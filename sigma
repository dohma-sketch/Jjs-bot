------------------------------------------------------------
-- ACTION VALIDATION
------------------------------------------------------------

local lastActionAt = {}

local function isActionReady(name)
    local cd = CONFIG.actionCooldowns[name] or 0
    local last = lastActionAt[name] or 0

    return tick() - last >= cd
end

local function getValidActions(target, dist)
    local valid = {}

    local desired = math.max(3.5, CONFIG.attackRange * 0.70)

    if Movement and Movement.getDesiredRange then
        desired = Movement.getDesiredRange()
    end

    local overrideActive = false

    if Movement and Movement.isOverrideActive then
        overrideActive = Movement.isOverrideActive()
    end

    local selfFrac = getSelfHealthFrac()
    local lowSelf = selfFrac <= CONFIG.lowHealthThreshold

    for i, name in ipairs(actions) do
        local ok = false

        if name == "approach" then
            ok = target ~= nil
                and isActionReady(name)
                and dist > desired + 0.5
                and not overrideActive

            if ok and CONFIG.retreatWhenLowHP and lowSelf and dist <= CONFIG.attackRange + 2 then
                ok = false
            end

        elseif name == "back_step" then
            ok = isActionReady(name)
                and target ~= nil
                and dist <= CONFIG.attackRange + 4
                and not overrideActive

        elseif name == "jump" then
            ok = isActionReady(name)

        elseif name == "m1_attack" then
            ok = target ~= nil
                and isActionReady(name)
                and dist <= CONFIG.attackRange

        elseif name:sub(1, 6) == "skill_" then
            ok = target ~= nil
                and isActionReady(name)
                and dist <= CONFIG.skillRange
                and not overrideActive

        elseif name == "block" then
            ok = isActionReady(name)
        end

        if ok then
            table.insert(valid, i)
        end
    end

    if #valid == 0 then
        if target ~= nil and dist > desired + 0.5 and not overrideActive then
            table.insert(valid, actionIndex.approach)
        else
            table.insert(valid, actionIndex.block)
        end
    end

    return valid
end

local epsilon = CONFIG.epsilon

local function chooseAction(state, validActions)
    initState(state)

    local row = Q[state]

    if #validActions == 0 then
        return actionIndex.approach
    end

    if math.random() >= epsilon then
        local bestValue = -math.huge
        local bestChoices = {}

        for _, idx in ipairs(validActions) do
            local value = tonumber(row[idx]) or 0

            if value > bestValue then
                bestValue = value
                bestChoices = {idx}
            elseif value == bestValue then
                table.insert(bestChoices, idx)
            end
        end

        return bestChoices[math.random(#bestChoices)]
    end

    return validActions[math.random(#validActions)]
end

