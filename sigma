local Q = {}

if isfile and isfile(CONFIG.qFileName) then
    pcall(function()
        local raw = readfile(CONFIG.qFileName)
        local decoded = HttpService:JSONDecode(raw)

        if type(decoded) == "table" then
            Q = decoded
        end
    end)
end

local function initState(state)
    local old = Q[state]

    if type(old) ~= "table" then
        old = {}
    end

    local row = {}

    for i = 1, #actions do
        local value = tonumber(old[i]) or tonumber(old[tostring(i)]) or 0

        if value ~= value then
            value = 0
        end

        row[i] = value
    end

    Q[state] = row
end

for state in pairs(Q) do
    initState(state)
end

local function saveQ()
    if not writefile then
        return
    end

    pcall(function()
        writefile(CONFIG.qFileName, HttpService:JSONEncode(Q))
    end)
end

