------------------------------------------------------------

local function findNearestTarget()
    if not botReady() then
        return nil, math.huge
    end

    local best, bestDist = nil, math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        local allowed = true

        if CONFIG.targetUserId ~= nil then
            allowed = plr.UserId == CONFIG.targetUserId
        end

        if allowed and plr ~= LocalPlayer and plr.Character and isModelAlive(plr.Character) then
            local root = getRoot(plr.Character)

            if root then
                local d = (root.Position - bot.hrp.Position).Magnitude

                if d < bestDist then
                    bestDist = d
                    best = plr.Character
                end
            end
        end
    end

    return best, bestDist
end

------------------------------------------------------------
-- VISION
------------------------------------------------------------

local function isVisible(target)
    if not botReady() then
        return false
    end

    local part = target:FindFirstChild("Head")
        or target:FindFirstChild("UpperTorso")
        or getRoot(target)

    if not part then
        return false
    end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {bot.character}
    params.FilterType = RAY_FILTER
    params.IgnoreWater = true

    local origin = bot.hrp.Position + Vector3.new(0, 1.5, 0)
    local direction = part.Position - origin

    if direction.Magnitude < 0.1 then
        return true
    end

    local result = workspace:Raycast(origin, direction, params)

    return result == nil or (result.Instance and result.Instance:IsDescendantOf(target))
end

