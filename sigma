function Movement.resetPath()
    Movement.pathRequestId = Movement.pathRequestId + 1

    Movement.waypoints = {}
    Movement.waypointIndex = 1
    Movement.pathGoal = Vector3.zero
    Movement.pathMode = "none"
    Movement.lastPathCompute = 0
    Movement.queuedPathGoal = nil
    Movement.queuedPathMode = nil
end

function Movement.isOverrideActive()
    return Movement.override ~= nil and tick() < (Movement.override.until or 0)
end

function Movement.isWanderActive()
    return Movement.wander ~= nil and tick() < (Movement.wander.until or 0)
end

function Movement.getDesiredRange()
    return Movement.combat.desiredRange or MV.stopDistance or 5
end

function Movement.jump()
    if not botReady() then
        return
    end

    if tick() - Movement.lastJump < 0.55 then
        return
    end

    Movement.lastJump = tick()

    pcall(function()
        bot.humanoid.Jump = true
    end)

    task.delay(0.2, function()
        if botReady() then
            pcall(function()
                bot.humanoid.Jump = false
            end)
        end
    end)
end

function Movement.makeRayParams(extraModel)
    local params = RaycastParams.new()

    params.FilterDescendantsInstances = {bot.character}

    if extraModel then
        table.insert(params.FilterDescendantsInstances, extraModel)
    end

    if Movement.combat.target and Movement.combat.target ~= extraModel then
        table.insert(params.FilterDescendantsInstances, Movement.combat.target)
    end

    params.FilterType = RAY_FILTER
    params.IgnoreWater = true

    return params
end

function Movement.rayDistance(origin, dir, params, maxDist)
    if not dir or dir.Magnitude < 0.001 then
        return 0
    end

    local result = workspace:Raycast(origin, dir * maxDist, params)

    if result then
        return (result.Position - origin).Magnitude
    end

    return maxDist
end

function Movement.chooseSafeAwayDirection(threatPos, distance)
    local origin = bot.hrp.Position + Vector3.new(0, 1, 0)

    local away = bot.hrp.Position - threatPos

    if away.Magnitude < 0.2 then
        away = -bot.hrp.CFrame.LookVector
    end

    away = safeUnit(away, bot.hrp.CFrame.LookVector)

    local right = bot.hrp.CFrame.RightVector

    local candidates = {
        {dir = away, bias = 1.0},
        {dir = safeUnit(away + right * 0.55, away), bias = 0.85},
        {dir = safeUnit(away - right * 0.55, away), bias = 0.85},
        {dir = safeUnit(away + right, away), bias = 0.55},
        {dir = safeUnit(away - right, away), bias = 0.55},
        {dir = safeUnit(right, away), bias = 0.35},
        {dir = safeUnit(-right, away), bias = 0.35},
    }

    local params = Movement.makeRayParams(Movement.combat.target)
    local checkDist = math.max((distance or CONFIG.backStepDistance or 7) + 2, 8)

    local bestDir = away
    local bestScore = -math.huge

    for _, c in ipairs(candidates) do
        local space = Movement.rayDistance(origin, c.dir, params, checkDist)
        local dot = c.dir:Dot(away)

        local score = space + dot * 3 + c.bias

        if score > bestScore then
            bestScore = score
            bestDir = c.dir
        end
    end

    return bestDir
end

function Movement.setCombatTarget(model, desiredRange)
    if not model or not isModelAlive(model) then
        Movement.combat.target = nil
        return
    end

    if Movement.combat.target ~= model then
        Movement.resetPath()
        Movement.directOK = false
        Movement.lastVisCheck = 0
        Movement.lastStuckCheck = 0

        if botReady() then
            Movement.lastPos = bot.hrp.Position
        end
    end

    Movement.combat.target = model
    Movement.combat.desiredRange = desiredRange
        or Movement.combat.desiredRange
        or MV.stopDistance
        or 5

    Movement.wander = nil
    Movement.idleStopped = false
end

function Movement.clearCombatTarget()
    if Movement.combat.target ~= nil then
        Movement.combat.target = nil
        Movement.resetPath()
        Movement.directOK = false
    end
end

function Movement.requestBackStep(threat, distance)
    if not botReady() then
        return
    end

    local threatPos = nil

    if threat ~= nil then
        if typeof(threat) == "Vector3" then
            threatPos = threat
        else
            local root = getRoot(threat)

            if root then
                threatPos = root.Position
            end
        end
    end

    if not threatPos then
        threatPos = bot.hrp.Position + bot.hrp.CFrame.LookVector * 6
    end

    local dir = Movement.chooseSafeAwayDirection(threatPos, distance)
    local dur = MV.backStepDuration or 0.85

    Movement.override = {
        goal = bot.hrp.Position + dir * (distance or CONFIG.backStepDistance or 7),
        until = tick() + dur,
        type = "back_step",
    }

    Movement.resetPath()
    Movement.idleStopped = false
end

function Movement.wanderTo(pos, duration)
    if not botReady() or not pos then
        return
    end

    if Movement.combat.target and isModelAlive(Movement.combat.target) then
        return
    end

    Movement.wander = {
        goal = pos,
        until = tick() + (duration or 2.0),
    }

    Movement.override = nil
    Movement.resetPath()
    Movement.idleStopped = false
end

function Movement.unstick()
    if not botReady() then
        return
    end

    local origin = bot.hrp.Position + Vector3.new(0, 1, 0)
    local params = Movement.makeRayParams(Movement.combat.target)

    local right = bot.hrp.CFrame.RightVector
    local forward = bot.hrp.CFrame.LookVector

    local candidates = {
        right,
        -right,
        forward,
        -forward,
        safeUnit(right + forward, right),
        safeUnit(-right + forward, -right),
        safeUnit(right - forward, right),
        safeUnit(-right - forward, -right),
    }

    local bestDir = right
    local bestSpace = -math.huge

    for _, dir in ipairs(candidates) do
        dir = safeUnit(dir, right)

        local space = Movement.rayDistance(origin, dir, params, 7)

        if space > bestSpace then
            bestSpace = space
            bestDir = dir
        end
    end

    Movement.override = {
        goal = bot.hrp.Position + bestDir * 6,
        until = tick() + (MV.unstickDuration or 0.4),
        type = "unstick",
    }

    Movement.resetPath()
    Movement.lastStuckCheck = tick()
    Movement.lastPos = bot.hrp.Position
    Movement.idleStopped = false

    stats.unstucks = stats.unstucks + 1

    Movement.jump()
end

function Movement.stopIdle()
    if botReady() and not Movement.idleStopped then
        pcall(function()
            bot.humanoid:MoveTo(bot.hrp.Position)
        end)

        Movement.idleStopped = true
    end
end

function Movement.requestPath(goal, mode)
    if not botReady() or not goal then
        return
    end

    if Movement.pathComputing then
        Movement.queuedPathGoal = goal
        Movement.queuedPathMode = mode
        return
    end

    Movement.pathComputing = true
    Movement.pathRequestId = Movement.pathRequestId + 1

    local id = Movement.pathRequestId

    task.spawn(function()
        if not botReady() then
            Movement.pathComputing = false
            return
        end

        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
        })

        local ok = pcall(function()
            path:ComputeAsync(bot.hrp.Position, goal)
        end)

        if id ~= Movement.pathRequestId then
            Movement.pathComputing = false

            if Movement.queuedPathGoal then
                local qGoal = Movement.queuedPathGoal
                local qMode = Movement.queuedPathMode

                Movement.queuedPathGoal = nil
                Movement.queuedPathMode = nil

                Movement.requestPath(qGoal, qMode)
            end

            return
        end

        if ok and path.Status == Enum.PathStatus.Success then
            Movement.waypoints = path:GetWaypoints()
            Movement.waypointIndex = 2
            Movement.pathGoal = goal
            Movement.pathMode = mode
            Movement.lastPathCompute = tick()
        else
            Movement.waypoints = {}
            Movement.waypointIndex = 1
            Movement.pathGoal = goal
            Movement.pathMode = mode
            Movement.lastPathCompute = tick()
        end

        Movement.pathComputing = false

        if Movement.queuedPathGoal then
            local qGoal = Movement.queuedPathGoal
            local qMode = Movement.queuedPathMode

            Movement.queuedPathGoal = nil
            Movement.queuedPathMode = nil

            Movement.requestPath(qGoal, qMode)
        end
    end)
end

function Movement.getSteeredPosition(movePos, targetModel)
    if not botReady() then
        return movePos
    end

    local now = tick()

    if now - Movement.lastObstacleCheck >= 0.08 then
        Movement.lastObstacleCheck = now
        Movement.obstacleHit = false

        local look = movePos - bot.hrp.Position

        if look.Magnitude > 0.2 then
            look = look.Unit

            local params = Movement.makeRayParams(targetModel)
            local origin = bot.hrp.Position + Vector3.new(0, 1, 0)

            local hit = workspace:Raycast(
                origin,
                look * (MV.obstacleRayDistance or 6),
                params
            )

            if hit then
                Movement.obstacleHit = true

                local right = bot.hrp.CFrame.RightVector
                local left = -right

                local rightHit = workspace:Raycast(origin, right * 5, params)
                local leftHit = workspace:Raycast(origin, left * 5, params)

                if rightHit and not leftHit then
                    Movement.sideDir = left
                elseif leftHit and not rightHit then
                    Movement.sideDir = right
                else
                    Movement.sideDir = math.random() < 0.5 and right or left
                end
            end
        end
    end

    if Movement.obstacleHit and Movement.sideDir.Magnitude > 0.1 then
        if MV.jumpIfBlocked ~= false and tick() - Movement.lastJump > 0.7 then
            Movement.jump()
        end

        local baseLook = movePos - bot.hrp.Position

        if baseLook.Magnitude > 0.2 then
            baseLook = baseLook.Unit
        else
            baseLook = bot.hrp.CFrame.LookVector
        end

        local mixed = safeUnit(baseLook * 0.35 + Movement.sideDir * 0.85, baseLook)

        return bot.hrp.Position + mixed * 5
    end

    return movePos
end

function Movement.update()
    if MV.enabled == false or not botReady() then
        return
    end

    local now = tick()

    -- Temporary override
    if Movement.isOverrideActive() then
        Movement.idleStopped = false

        local goal = Movement.override.goal
        local movePos = Movement.getSteeredPosition(goal, Movement.combat.target)

        pcall(function()
            bot.humanoid:MoveTo(movePos)
        end)

        Movement.lastStuckCheck = now
        Movement.lastPos = bot.hrp.Position

        return
    elseif Movement.override ~= nil then
        Movement.override = nil
    end

    -- Combat target
    local target = Movement.combat.target

    if target and isModelAlive(target) then
        Movement.idleStopped = false

        local root = getRoot(target)

        if not root then
            Movement.clearCombatTarget()
            return
        end

        local goal = root.Position
        local dist = (goal - bot.hrp.Position).Magnitude
        local desired = Movement.getDesiredRange()

        if dist <= (MV.directRange or 26) then
            if now - Movement.lastVisCheck > 0.2 then
                Movement.directOK = isVisible(target)
                Movement.lastVisCheck = now
            end
        else
            Movement.directOK = false
        end

        if dist <= desired then
            if MV.combatStrafe == false then
                pcall(function()
                    bot.humanoid:MoveTo(bot.hrp.Position)
                end)
            else
                if now >= Movement.nextStrafeSwitch then
                    Movement.strafeSide = math.random() < 0.5 and 1 or -1

                    local minSwitch = MV.strafeSwitchMin or 0.7
                    local maxSwitch = MV.strafeSwitchMax or 1.8

                    Movement.nextStrafeSwitch = now
                        + minSwitch
                        + math.random() * math.max(0.1, maxSwitch - minSwitch)
                end

                local toEnemy = goal - bot.hrp.Position
                toEnemy = Vector3.new(toEnemy.X, 0, toEnemy.Z)
                toEnemy = safeUnit(toEnemy, bot.hrp.CFrame.LookVector)

                local tangent = safeUnit(
                    Vector3.new(-toEnemy.Z, 0, toEnemy.X),
                    Vector3.new(1, 0, 0)
                )

                local side = tangent * Movement.strafeSide

                local params = Movement.makeRayParams(target)
                local origin = bot.hrp.Position + Vector3.new(0, 1, 0)

                local sideHit = workspace:Raycast(origin, side * 4, params)

                if sideHit then
                    Movement.strafeSide = -Movement.strafeSide
                    side = tangent * Movement.strafeSide
                end

                local radial = Vector3.zero

                if dist < desired * 0.7 then
                    radial = -toEnemy * 0.75
                elseif dist > desired * 1.25 then
                    radial = toEnemy * 0.75
                end

                local moveVec = side * 0.85 + radial
                moveVec = safeUnit(moveVec, side)

                local movePos = bot.hrp.Position + moveVec * 3
                movePos = Movement.getSteeredPosition(movePos, target)

                pcall(function()
                    bot.humanoid:MoveTo(movePos)
                end)
            end

            Movement.lastStuckCheck = now
            Movement.lastPos = bot.hrp.Position

            return
        end

        local movePos = goal
        local wpAction = nil

        if not Movement.directOK then
            local needPath = #Movement.waypoints == 0
                or Movement.pathMode ~= "combat"
                or (Movement.pathGoal - goal).Magnitude > 4
                or now - Movement.lastPathCompute > (MV.pathRefresh or 0.30)

            if needPath then
                Movement.requestPath(goal, "combat")
            end

            if #Movement.waypoints > 0 then
                while Movement.waypointIndex <= #Movement.waypoints do
                    local wp = Movement.waypoints[Movement.waypointIndex]

                    if not wp then
                        break
                    end

                    if (bot.hrp.Position - wp.Position).Magnitude > (MV.waypointRadius or 3) then
                        movePos = wp.Position
                        wpAction = wp.Action
                        break
                    end

                    Movement.waypointIndex = Movement.waypointIndex + 1
                end

                if Movement.waypointIndex > #Movement.waypoints then
                    movePos = goal
                end
            end
        end

        if PATH_JUMP and wpAction == PATH_JUMP and now - Movement.lastJump > 0.65 then
            Movement.jump()
        end

        movePos = Movement.getSteeredPosition(movePos, target)

        pcall(function()
            bot.humanoid:MoveTo(movePos)
        end)

        if now - Movement.lastStuckCheck >= (MV.stuckCheckInterval or 0.45) then
            local moved = (bot.hrp.Position - Movement.lastPos).Magnitude

            if moved < (MV.stuckDistance or 0.55) and dist > desired + 1 then
                Movement.unstick()
            else
                Movement.lastPos = bot.hrp.Position
                Movement.lastStuckCheck = now
            end
        end

        return
    else
        if target then
            Movement.combat.target = nil
            Movement.resetPath()
        end
    end

    -- Wander
    if Movement.isWanderActive() then
        Movement.idleStopped = false

        local goal = Movement.wander.goal
        local dist = (goal - bot.hrp.Position).Magnitude

        if dist <= 2.5 then
            Movement.wander = nil
            Movement.stopIdle()
            return
        end

        local movePos = Movement.getSteeredPosition(goal, nil)

        pcall(function()
            bot.humanoid:MoveTo(movePos)
        end)

        if now - Movement.lastStuckCheck >= (MV.stuckCheckInterval or 0.45) then
            local moved = (bot.hrp.Position - Movement.lastPos).Magnitude

            if moved < (MV.stuckDistance or 0.55) and dist > 3 then
                Movement.unstick()
            else
                Movement.lastPos = bot.hrp.Position
                Movement.lastStuckCheck = now
            end
        end

        return
    elseif Movement.wander ~= nil then
        Movement.wander = nil
    end

    Movement.stopIdle()
end

