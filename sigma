local function getRangeState(dist)
    if dist <= CONFIG.distance.melee then
        return "melee"
    elseif dist <= CONFIG.distance.mid then
        return "mid"
    else
        return "far"
    end
end

local function getOrientation(targetRoot)
    if not botReady() or not targetRoot then
        return "side"
    end

    local toTarget = targetRoot.Position - bot.hrp.Position

    if toTarget.Magnitude < 0.1 then
        return "front"
    end

    local dot = bot.hrp.CFrame.LookVector:Dot(toTarget.Unit)

    if dot > 0.65 then
        return "front"
    elseif dot < -0.45 then
        return "behind"
    end

    return "side"
end

local function getTargetMotion(target)
    local hum = getHumanoid(target)

    if not hum then
        return "idle"
    end

    if hum.MoveDirection.Magnitude > 0.1 then
        return "move"
    end

    return "idle"
end

local function getSelfHealthState()
    local frac = getSelfHealthFrac()

    if frac <= CONFIG.lowHealthThreshold then
        return "lowhp"
    end

    return "ok"
end

local function getState(target, dist)
    if not target or not isModelAlive(target) then
        return "enemy_dead"
    end

    local root = getRoot(target)

    if not root or not botReady() then
        return "no_target"
    end

    return string.format(
        "%s_%s_%s_%s_%s_%s_%s",
        getRangeState(dist),
        isVisible(target) and "vis" or "novis",
        getEnemyStatus(target),
        enemyLikelyAttacking(target) and "atk" or "calm",
        getOrientation(root),
        getTargetMotion(target),
        getSelfHealthState()
    )
end

