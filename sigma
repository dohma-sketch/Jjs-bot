-- REWARD
------------------------------------------------------------

local function evaluateOutcome(actionName, target, oldDist, oldTargetHealth, oldSelfHealth)
    local newSelfHealth = botReady() and bot.humanoid.Health or 0

    if (oldSelfHealth or 0) > 0 and newSelfHealth <= 0 then
        stats.deaths = stats.deaths + 1
    end

    if not botReady() then
        return -1, false
    end

    local reward = -0.015

    local targetHum = getHumanoid(target)
    local targetRoot = getRoot(target)

    local newTargetHealth = targetHum and targetHum.Health or 0
    local targetAlive = isModelAlive(target)

    local dist = oldDist

    if bot.hrp and targetRoot then
        dist = (targetRoot.Position - bot.hrp.Position).Magnitude
    end

    local damageDealt = math.max(0, (oldTargetHealth or 0) - (newTargetHealth or 0))
    local damageTaken = math.max(0, (oldSelfHealth or 0) - newSelfHealth)

    if damageDealt > 0 then
        reward = reward + damageDealt * CONFIG.reward.damageDealt
        stats.hits = stats.hits + 1
    end

    if (oldTargetHealth or 0) > 0 and newTargetHealth <= 0 then
        reward = reward + CONFIG.reward.kill
        stats.kills = stats.kills + 1
    end

    if damageTaken > 0 then
        reward = reward - damageTaken * CONFIG.reward.damageTaken
        stats.damageTaken = stats.damageTaken + damageTaken
    end

    if actionName == "approach" then
        reward = reward + clampNumber((oldDist - dist) * CONFIG.reward.approachDistance, -0.5, 0.5)

    elseif actionName == "back_step" then
        if damageTaken <= 0 then
            reward = reward + 0.03
        end

        if dist > oldDist then
            reward = reward + 0.02
        end

    elseif actionName == "jump" then
        reward = reward - 0.01

    elseif isAttackAction(actionName) then
        if damageDealt > 0 then
            reward = reward + CONFIG.reward.hitBonus
        else
            local status = getEnemyStatus(target)

            if status == "blocking" then
                reward = reward - CONFIG.reward.attackBlockedPenalty
                stats.blockedHits = stats.blockedHits + 1
            else
                reward = reward - CONFIG.reward.attackMissPenalty
                stats.misses = stats.misses + 1
            end
        end

    elseif actionName == "block" then
        if damageTaken <= 0 then
            reward = reward + 0.05
        else
            reward = reward - damageTaken * 0.25
        end
    end

    reward = clampNumber(reward, -15, 40)

    return reward, targetAlive
end

------------------------------------------------------------
-- MAIN LOOP
------------------------------------------------------------

local function mainStep()
    getCamera()

    if not botReady() then
        restoreCamera(true)
        task.wait(0.25)
        return
    end

    local target, dist = findNearestTarget()

    if not target then
        if CONFIG.resetCameraWhenNoTarget ~= false then
            restoreCamera(true)
        end

        Movement.clearCombatTarget()

        if not Movement.isOverrideActive()
            and not Movement.isWanderActive()
            and math.random() < CONFIG.wanderChance then
            local randomGoal = bot.hrp.Position + Vector3.new(math.random(-25, 25), 0, math.random(-25, 25))
            Movement.wanderTo(randomGoal, 2.5)
        end

        task.wait(0.2)
        return
    end

    local oldDist = dist

    local targetHum = getHumanoid(target)
    local oldTargetHealth = targetHum and targetHum.Health or 0
    local oldSelfHealth = bot.humanoid.Health

    local state = getState(target, dist)
    local validActions = getValidActions(target, dist)

    local actionIdx, actionName

    if shouldDefensiveBlock(target, dist) then
        actionIdx = actionIndex.block
        actionName = "block"
    else
        actionIdx = chooseAction(state, validActions)
        actionName = actions[actionIdx]
    end

    performAction(actionName, target, dist)

    task.wait(CONFIG.actionPostDelay[actionName] or CONFIG.loopInterval)

    local reward, targetAlive = evaluateOutcome(
        actionName,
        target,
        oldDist,
        oldTargetHealth,
        oldSelfHealth
    )

    local newState = "enemy_dead"

    if targetAlive then
        local root = getRoot(target)
        local newDist = oldDist

        if root and bot.hrp then
            newDist = (root.Position - bot.hrp.Position).Magnitude
        end

        newState = getState(target, newDist)
    end

    initState(state)
    initState(newState)

    local maxNext = -math.huge

    for _, value in ipairs(Q[newState]) do
        local num = tonumber(value) or 0

        if num > maxNext then
            maxNext = num
        end
    end

    if maxNext == -math.huge then
        maxNext = 0
    end

    local oldQ = tonumber(Q[state][actionIdx]) or 0
    local newQ = oldQ + CONFIG.alpha * (reward + CONFIG.gamma * maxNext - oldQ)

    if newQ == newQ and newQ > -1e9 and newQ < 1e9 then
        Q[state][actionIdx] = newQ
    end

    if epsilon > CONFIG.epsilonMin then
        epsilon = math.max(CONFIG.epsilonMin, epsilon * CONFIG.epsilonDecay)
    end

    stats.steps = stats.steps + 1

    if stats.steps % CONFIG.saveEvery == 0 then
        saveQ()

        if CONFIG.debug then
            print(string.format(
                "[JJS Bot] step=%d | eps=%.4f | state=%s | action=%s | reward=%.2f | q=%.2f",
                stats.steps,
                epsilon,
                state,
                actionName,
                reward,
                tonumber(Q[state][actionIdx]) or 0
            ))

            print(string.format(
                "[JJS Stats] hits=%d blocked=%d misses=%d taken=%.1f kills=%d deaths=%d blocks=%d reflex=%d unstucks=%d",
                stats.hits,
                stats.blockedHits,
                stats.misses,
                stats.damageTaken,
                stats.kills,
                stats.deaths,
                stats.blocks,
                stats.reflexBlocks,
                stats.unstucks
            ))
        end
    end
end

