local function performM1(target)
    local part = getAimPart(target)

    if not part then
        return false
    end

    beginAim(target)

    task.wait(0.03 + math.random() * 0.03)

    local x, y

    if CONFIG.clickMode == "CENTER" then
        x, y = getCenterScreen()
    else
        local sx, sy, onScreen = worldToScreen(part.Position)

        if onScreen then
            x, y = sx, sy
        else
            x, y = getCenterScreen()
        end
    end

    clickMouse(
        x,
        y,
        0,
        CONFIG.mouseHold + math.random() * CONFIG.mouseHoldJitter
    )

    task.wait(0.02)

    endAim()

    return true
end

local function performSkill(target, key)
    local part = getAimPart(target)

    if not part or not key then
        return false
    end

    beginAim(target)

    task.wait(0.03 + math.random() * 0.03)

    pressKey(
        key,
        CONFIG.keyHold + math.random() * CONFIG.keyHoldJitter
    )

    task.wait(0.02)

    endAim()

    return true
end

local function performBlock()
    stats.blocks = stats.blocks + 1

    local holdTime = CONFIG.blockHold + math.random() * CONFIG.blockHoldJitter

    if CONFIG.blockMode == "RMB" then
        local x, y = getCenterScreen()
        clickMouse(x, y, 1, holdTime)
    else
        pressKey(CONFIG.blockKey, holdTime)
    end
end

